# Sentry DSN for error and performance monitoring (web + Capacitor iOS)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=

# Separate DSN for web platform (used by the legacy initSentry() helper)
VITE_SENTRY_DSN_WEB=

# Separate DSN for iOS native platform (used by the legacy initSentry() helper)
VITE_SENTRY_DSN_IOS=

# Sentry DSN for the Express API server (server-side only, no VITE_ prefix)
SENTRY_DSN_API=
