{"id":114,"verses":[{"number":1,"arabicText":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","transliteration":"Qul aʿūdhu birabbi n-nās","translation":"Say, ˹O Prophet,˺ “I seek refuge in the Lord of humankind"},{"number":2,"arabicText":"مَلِكِ ٱلنَّاسِ","transliteration":"Maliki n-nās","translation":"the Master of humankind"},{"number":3,"arabicText":"إِلَٰهِ ٱلنَّاسِ","transliteration":"Ilāhi n-nās","translation":"the God of humankind"},{"number":4,"arabicText":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","transliteration":"Min sharri l-waswāsi l-khanās","translation":"from the evil of the lurking whisperer—"},{"number":5,"arabicText":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","transliteration":"Alladhī yuwaswisu fī ṣudūri n-nās","translation":"who whispers into the hearts of humankind—"},{"number":6,"arabicText":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","transliteration":"Mina l-jinati wal-nās","translation":"from among jinn and humankind.”"}]}