{"id":112,"verses":[{"number":1,"arabicText":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","transliteration":"Qul huwal laahu ahad","translation":"Say, \"He is Allah, [who is] One,"},{"number":2,"arabicText":"ٱللَّهُ ٱلصَّمَدُ","transliteration":"Allah hus-samad","translation":"Allah, the Eternal Refuge."},{"number":3,"arabicText":"لَمْ يَلِدْ وَلَمْ يُولَدْ","transliteration":"Lam yalid wa lam yoolad","translation":"He neither begets nor is born,"},{"number":4,"arabicText":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","transliteration":"Wa lam yakul-lahu kufuwan ahad","translation":"Nor is there to Him any equivalent.\""}]}