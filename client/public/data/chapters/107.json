{"id":107,"verses":[{"number":1,"arabicText":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","transliteration":"Ara-ayta alladhī yukadhibu bil-dīn","translation":"Have you seen the one who denies the Recompense?"},{"number":2,"arabicText":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","transliteration":"Fadhālika alladhī yaduʿʿu l-yatīm","translation":"For that is the one who drives away the orphan"},{"number":3,"arabicText":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","transliteration":"Walā yaḥuḍḍu ʿalā ṭaʿāmi l-mis'kīn","translation":"And does not encourage the feeding of the poor."},{"number":4,"arabicText":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","transliteration":"Fawaylul-lil'muṣallīn","translation":"So woe to those who pray"},{"number":5,"arabicText":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","transliteration":"Alladhīna hum ʿan ṣalātihim sāhūn","translation":"[But] who are heedless of their prayer -"},{"number":6,"arabicText":"ٱلَّذِينَ هُمْ يُرَآءُونَ","transliteration":"Alladhīna hum yurāūn","translation":"Those who make show [of their deeds]"},{"number":7,"arabicText":"وَيَمْنَعُونَ ٱلْمَاعُونَ","transliteration":"Wayamnaʿūna l-māʿūn","translation":"And withhold [simple] assistance."}]}