{"verses":[{"verse_key":"55:1","text":"اَلرَّحمٰنُ","words":["اَلرَّحمٰنُ"]},{"verse_key":"55:2","text":"عَلَّمَ القُراٰنَؕ","words":["عَلَّمَ","القُراٰنَؕ"]},{"verse_key":"55:3","text":"خَلَقَ الاِنسَانَ","words":["خَلَقَ","الاِنسَانَ"]},{"verse_key":"55:4","text":"عَلَّمَهُ البَيَانَ","words":["عَلَّمَهُ","البَيَانَ"]},{"verse_key":"55:5","text":"اَلشَّمسُ وَالقَمَرُ بِحُسبَانٍ","words":["اَلشَّمسُ","وَالقَمَرُ","بِحُسبَانٍ"]},{"verse_key":"55:6","text":"وَّالنَّجمُ وَالشَّجَرُ يَسجُدٰنِ","words":["وَّالنَّجمُ","وَالشَّجَرُ","يَسجُدٰنِ"]},{"verse_key":"55:7","text":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ المِيزَانَ","words":["وَالسَّمَآءَ","رَفَعَهَا","وَوَضَعَ","المِيزَانَ"]},{"verse_key":"55:8","text":"اَلَّا تَطغَوا فِى المِيزَانِ","words":["اَلَّا","تَطغَوا","فِى","المِيزَانِ"]},{"verse_key":"55:9","text":"وَاَقِيمُوا الوَزنَ بِالقِسطِ وَلَا تُخسِرُوا المِيزَانَ","words":["وَاَقِيمُوا","الوَزنَ","بِالقِسطِ","وَلَا","تُخسِرُوا","المِيزَانَ"]},{"verse_key":"55:10","text":"وَالاَرضَ وَضَعَهَا لِلاَنَامِ","words":["وَالاَرضَ","وَضَعَهَا","لِلاَنَامِ"]},{"verse_key":"55:11","text":"فِيهَا فَاكِهَةٌ   وَّالنَّخلُ ذَاتُ الاَكمَامِ ","words":["فِيهَا","فَاكِهَةٌ  ","وَّالنَّخلُ","ذَاتُ","الاَكمَامِ "]},{"verse_key":"55:12","text":"وَالحَبُّ ذُو العَصفِ وَالرَّيحَانُ","words":["وَالحَبُّ","ذُو","العَصفِ","وَالرَّيحَانُ"]},{"verse_key":"55:13","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:14","text":"خَلَقَ الاِنسَانَ مِن صَلصَالٍ كَالفَخَّارِ","words":["خَلَقَ","الاِنسَانَ","مِن","صَلصَالٍ","كَالفَخَّارِ"]},{"verse_key":"55:15","text":"وَخَلَقَ الجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ","words":["وَخَلَقَ","الجَآنَّ","مِن","مَّارِجٍ","مِّن","نَّارٍ"]},{"verse_key":"55:16","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:17","text":"رَبُّ المَشرِقَينِ وَ رَبُّ المَغرِبَينِ","words":["رَبُّ","المَشرِقَينِ","وَ رَبُّ","المَغرِبَينِ"]},{"verse_key":"55:18","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:19","text":"مَرَجَ البَحرَينِ يَلتَقِيٰنِ","words":["مَرَجَ","البَحرَينِ","يَلتَقِيٰنِ"]},{"verse_key":"55:20","text":"بَينَهُمَا بَرزَخٌ لَّا يَبغِيٰنِ","words":["بَينَهُمَا","بَرزَخٌ","لَّا","يَبغِيٰنِ"]},{"verse_key":"55:21","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:22","text":"يَخرُجُ مِنهُمَا اللُّـؤلُـؤُ وَالمَرجَانُ","words":["يَخرُجُ","مِنهُمَا","اللُّـؤلُـؤُ","وَالمَرجَانُ"]},{"verse_key":"55:23","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:24","text":"وَلَهُ الجَوَارِ المُنشَئٰتُ فِى البَحرِ كَالاَعلَامِ","words":["وَلَهُ","الجَوَارِ","المُنشَئٰتُ","فِى","البَحرِ","كَالاَعلَامِ"]},{"verse_key":"55:25","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:26","text":"كُلُّ مَن عَلَيهَا فَانٍ  ","words":["كُلُّ","مَن","عَلَيهَا","فَانٍ  "]},{"verse_key":"55:27","text":"وَّيَبقٰى وَجهُ رَبِّكَ ذُو الجَلٰلِ وَالاِكرَامِ","words":["وَّيَبقٰى","وَجهُ","رَبِّكَ","ذُو","الجَلٰلِ","وَالاِكرَامِ"]},{"verse_key":"55:28","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:29","text":"يَسـَٔـلُهٗ مَن فِى السَّمٰوٰتِ وَالاَرضِؕ كُلَّ يَومٍ هُوَ فِى شَانٍ ","words":["يَسـَٔـلُهٗ","مَن","فِى","السَّمٰوٰتِ","وَالاَرضِؕ","كُلَّ","يَومٍ","هُوَ","فِى","شَانٍ "]},{"verse_key":"55:30","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:31","text":"سَنَفرُغُ لَـكُم اَيُّهَ الثَّقَلٰنِ","words":["سَنَفرُغُ","لَـكُم","اَيُّهَ","الثَّقَلٰنِ"]},{"verse_key":"55:32","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:33","text":"يٰمَعشَرَ الجِنِّ وَالاِنسِ اِنِ استَطَعتُم اَن تَنفُذُوا مِن اَقطَارِ السَّمٰوٰتِ وَالاَرضِ فَانْفُذُواؕ لَا تَنفُذُونَ اِلَّا بِسُلطٰنٍ","words":["يٰمَعشَرَ","الجِنِّ","وَالاِنسِ","اِنِ","استَطَعتُم","اَن","تَنفُذُوا","مِن","اَقطَارِ","السَّمٰوٰتِ","وَالاَرضِ","فَانْفُذُواؕ","لَا","تَنفُذُونَ","اِلَّا","بِسُلطٰنٍ"]},{"verse_key":"55:34","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:35","text":"يُرسَلُ عَلَيكُمَا شُوَاظٌ مِّن نَّارٍ  وَّنُحَاسٌ فَلَا تَنتَصِرٰنِ ","words":["يُرسَلُ","عَلَيكُمَا","شُوَاظٌ","مِّن","نَّارٍ ","وَّنُحَاسٌ","فَلَا","تَنتَصِرٰنِ "]},{"verse_key":"55:36","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:37","text":"فَاِذَا انْشَقَّتِ السَّمَآءُ فَكَانَت وَردَةً كَالدِّهَانِ","words":["فَاِذَا","انْشَقَّتِ","السَّمَآءُ","فَكَانَت","وَردَةً","كَالدِّهَانِ"]},{"verse_key":"55:38","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:39","text":"فَيَومَٮِٕذٍ لَّا يُسـَٔـلُ عَن ذَنبِهٖ اِنسٌ وَّلَا جَآنٌّ","words":["فَيَومَٮِٕذٍ","لَّا","يُسـَٔـلُ","عَن","ذَنبِهٖ","اِنسٌ","وَّلَا","جَآنٌّ"]},{"verse_key":"55:40","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:41","text":"يُعرَفُ المُجرِمُونَ بِسِيمٰهُم فَيُؤخَذُ بِالنَّوَاصِى وَ الاَقدَامِ ","words":["يُعرَفُ","المُجرِمُونَ","بِسِيمٰهُم","فَيُؤخَذُ","بِالنَّوَاصِى","وَ الاَقدَامِ "]},{"verse_key":"55:42","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:43","text":"هٰذِهٖ جَهَنَّمُ الَّتِى يُكَذِّبُ بِهَا المُجرِمُونَ","words":["هٰذِهٖ","جَهَنَّمُ","الَّتِى","يُكَذِّبُ","بِهَا","المُجرِمُونَ"]},{"verse_key":"55:44","text":"يَطُوفُونَ بَينَهَا وَبَينَ حَمِيمٍ اٰنٍ","words":["يَطُوفُونَ","بَينَهَا","وَبَينَ","حَمِيمٍ","اٰنٍ"]},{"verse_key":"55:45","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:46","text":"وَلِمَن خَافَ مَقَامَ رَبِّهٖ جَنَّتٰنِ","words":["وَلِمَن","خَافَ","مَقَامَ","رَبِّهٖ","جَنَّتٰنِ"]},{"verse_key":"55:47","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:48","text":"ذَوَاتَا اَفنَانٍ","words":["ذَوَاتَا","اَفنَانٍ"]},{"verse_key":"55:49","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:50","text":"فِيهِمَا عَينٰنِ تَجرِيٰنِ","words":["فِيهِمَا","عَينٰنِ","تَجرِيٰنِ"]},{"verse_key":"55:51","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:52","text":"فِيهِمَا مِن كُلِّ فَاكِهَةٍ زَوجٰنِ","words":["فِيهِمَا","مِن","كُلِّ","فَاكِهَةٍ","زَوجٰنِ"]},{"verse_key":"55:53","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:54","text":"مُتَّكِـــِٕينَ عَلٰى فُرُشٍ بَطَآٮِٕنُهَا مِن اِستَبرَقٍؕ وَجَنَی الجَـنَّتَينِ دَانٍ","words":["مُتَّكِـــِٕينَ","عَلٰى","فُرُشٍ","بَطَآٮِٕنُهَا","مِن","اِستَبرَقٍؕ","وَجَنَی","الجَـنَّتَينِ","دَانٍ"]},{"verse_key":"55:55","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:56","text":"فِيهِنَّ قٰصِرٰتُ الطَّرفِ لَم يَطمِثهُنَّ اِنسٌ قَبلَهُم وَلَا جَآنٌّ ","words":["فِيهِنَّ","قٰصِرٰتُ","الطَّرفِ","لَم","يَطمِثهُنَّ","اِنسٌ","قَبلَهُم","وَلَا","جَآنٌّ "]},{"verse_key":"55:57","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ "]},{"verse_key":"55:58","text":"كَاَنَّهُنَّ اليَاقُوتُ وَالمَرجَانُ","words":["كَاَنَّهُنَّ","اليَاقُوتُ","وَالمَرجَانُ"]},{"verse_key":"55:59","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:60","text":"هَل جَزَآءُ الْاِحسَانِ اِلَّا الاِحسَانُ","words":["هَل","جَزَآءُ","الْاِحسَانِ","اِلَّا","الاِحسَانُ"]},{"verse_key":"55:61","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:62","text":"وَمِن دُونِهِمَا جَنَّتٰنِ","words":["وَمِن","دُونِهِمَا","جَنَّتٰنِ"]},{"verse_key":"55:63","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:64","text":"مُدهَآمَّتٰنِ","words":["مُدهَآمَّتٰنِ"]},{"verse_key":"55:65","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:66","text":"فِيهِمَا عَينٰنِ نَضَّاخَتٰنِ","words":["فِيهِمَا","عَينٰنِ","نَضَّاخَتٰنِ"]},{"verse_key":"55:67","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:68","text":"فِيهِمَا فَاكِهَةٌ وَّنَخلٌ وَّرُمَّانٌ","words":["فِيهِمَا","فَاكِهَةٌ","وَّنَخلٌ","وَّرُمَّانٌ"]},{"verse_key":"55:69","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:70","text":"فِيهِنَّ خَيرٰتٌ حِسَانٌ","words":["فِيهِنَّ","خَيرٰتٌ","حِسَانٌ"]},{"verse_key":"55:71","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:72","text":"حُورٌ مَّقصُورٰتٌ فِى الخِيَامِ","words":["حُورٌ","مَّقصُورٰتٌ","فِى","الخِيَامِ"]},{"verse_key":"55:73","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:74","text":"لَم يَطمِثهُنَّ اِنسٌ قَبلَهُم وَلَا جَآنٌّ","words":["لَم","يَطمِثهُنَّ","اِنسٌ","قَبلَهُم","وَلَا","جَآنٌّ"]},{"verse_key":"55:75","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:76","text":"مُتَّكِــِٕينَ عَلٰى رَفرَفٍ خُضرٍ وَّعَبقَرِىٍّ حِسَانٍ","words":["مُتَّكِــِٕينَ","عَلٰى","رَفرَفٍ","خُضرٍ","وَّعَبقَرِىٍّ","حِسَانٍ"]},{"verse_key":"55:77","text":"فَبِاَىِّ اٰلَاءِ رَبِّكُمَا تُكَذِّبٰنِ","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكُمَا","تُكَذِّبٰنِ"]},{"verse_key":"55:78","text":"تَبٰـرَكَ اسمُ رَبِّكَ ذِى الجَـلٰلِ وَالاِكرَامِ","words":["تَبٰـرَكَ","اسمُ","رَبِّكَ","ذِى","الجَـلٰلِ","وَالاِكرَامِ"]}]}