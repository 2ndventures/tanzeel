{"verses":[{"verse_key":"56:1","text":"اِذَا وَقَعَتِ الوَاقِعَةُ ","words":["اِذَا","وَقَعَتِ","الوَاقِعَةُ "]},{"verse_key":"56:2","text":"لَيسَ لِـوَقعَتِهَا كَاذِبَةٌ ","words":["لَيسَ","لِـوَقعَتِهَا","كَاذِبَةٌ "]},{"verse_key":"56:3","text":"خَافِضَةٌ رَّافِعَةٌ ","words":["خَافِضَةٌ","رَّافِعَةٌ "]},{"verse_key":"56:4","text":"اِذَا رُجَّتِ الاَرضُ رَجًّا ","words":["اِذَا","رُجَّتِ","الاَرضُ","رَجًّا "]},{"verse_key":"56:5","text":"وَّبُسَّتِ الجِبَالُ بَسًّا ","words":["وَّبُسَّتِ","الجِبَالُ","بَسًّا "]},{"verse_key":"56:6","text":"فَكَانَت هَبَآءً مُّنبَـثًّا ","words":["فَكَانَت","هَبَآءً","مُّنبَـثًّا "]},{"verse_key":"56:7","text":"وَّكُنـتُم اَزوَاجًا ثَلٰـثَـةً ؕ","words":["وَّكُنـتُم","اَزوَاجًا","ثَلٰـثَـةً ؕ"]},{"verse_key":"56:8","text":"فَاَصحٰبُ المَيمَنَةِ  مَا اَصحٰبُ المَيمَنَةِ ؕ","words":["فَاَصحٰبُ","المَيمَنَةِ ","مَا","اَصحٰبُ","المَيمَنَةِ ؕ"]},{"verse_key":"56:9","text":"وَاَصحٰبُ المَشـَٔـمَةِ  مَا اَصحٰبُ المَشـَٔـمَةِؕ","words":["وَاَصحٰبُ","المَشـَٔـمَةِ ","مَا","اَصحٰبُ","المَشـَٔـمَةِؕ"]},{"verse_key":"56:10","text":"وَالسّٰبِقُونَ السّٰبِقُونَ  ","words":["وَالسّٰبِقُونَ","السّٰبِقُونَ  "]},{"verse_key":"56:11","text":"اُولٰٓٮِٕكَ المُقَرَّبُونَ","words":["اُولٰٓٮِٕكَ","المُقَرَّبُونَ"]},{"verse_key":"56:12","text":"فِى جَنّٰتِ النَّعِيمِ","words":["فِى","جَنّٰتِ","النَّعِيمِ"]},{"verse_key":"56:13","text":"ثُلَّةٌ مِّنَ الاَوَّلِينَ","words":["ثُلَّةٌ","مِّنَ","الاَوَّلِينَ"]},{"verse_key":"56:14","text":"وَقَلِيلٌ مِّنَ الاٰخِرِينَؕ","words":["وَقَلِيلٌ","مِّنَ","الاٰخِرِينَؕ"]},{"verse_key":"56:15","text":"عَلٰى سُرُرٍ مَّوضُونَةٍ","words":["عَلٰى","سُرُرٍ","مَّوضُونَةٍ"]},{"verse_key":"56:16","text":"مُّتَّكِـــِٕينَ عَلَيهَا مُتَقٰبِلِينَ","words":["مُّتَّكِـــِٕينَ","عَلَيهَا","مُتَقٰبِلِينَ"]},{"verse_key":"56:17","text":"يَطُوفُ عَلَيهِم وِلدَانٌ مُّخَلَّدُونَ","words":["يَطُوفُ","عَلَيهِم","وِلدَانٌ","مُّخَلَّدُونَ"]},{"verse_key":"56:18","text":"بِاَكوَابٍ وَّاَبَارِيقَ  وَكَاسٍ مِّن مَّعِينٍ","words":["بِاَكوَابٍ","وَّاَبَارِيقَ ","وَكَاسٍ","مِّن","مَّعِينٍ"]},{"verse_key":"56:19","text":"لَّا يُصَدَّعُونَ عَنهَا وَلَا يُنزِفُونَ","words":["لَّا","يُصَدَّعُونَ","عَنهَا","وَلَا","يُنزِفُونَ"]},{"verse_key":"56:20","text":"وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","words":["وَفَاكِهَةٍ","مِّمَّا","يَتَخَيَّرُونَ"]},{"verse_key":"56:21","text":"وَلَحمِ طَيرٍ مِّمَّا يَشتَهُونَؕ","words":["وَلَحمِ","طَيرٍ","مِّمَّا","يَشتَهُونَؕ"]},{"verse_key":"56:22","text":"وَحُورٌ عِينٌ","words":["وَحُورٌ","عِينٌ"]},{"verse_key":"56:23","text":"كَاَمثَالِ اللُّـؤلُـوٴِ المَكنُونِ","words":["كَاَمثَالِ","اللُّـؤلُـوٴِ","المَكنُونِ"]},{"verse_key":"56:24","text":"جَزَآءً بِمَا كَانُوا يَعمَلُونَ","words":["جَزَآءً","بِمَا","كَانُوا","يَعمَلُونَ"]},{"verse_key":"56:25","text":"لَا يَسمَعُونَ فِيهَا لَغوًا وَّلَا تَاثِيمًا ","words":["لَا","يَسمَعُونَ","فِيهَا","لَغوًا","وَّلَا","تَاثِيمًا "]},{"verse_key":"56:26","text":"اِلَّا قِيلًا سَلٰمًا سَلٰمًا","words":["اِلَّا","قِيلًا","سَلٰمًا","سَلٰمًا"]},{"verse_key":"56:27","text":"وَاَصحٰبُ اليَمِينِ  مَا اَصحٰبُ اليَمِينِؕ","words":["وَاَصحٰبُ","اليَمِينِ ","مَا","اَصحٰبُ","اليَمِينِؕ"]},{"verse_key":"56:28","text":"فِى سِدرٍ مَّخضُودٍ","words":["فِى","سِدرٍ","مَّخضُودٍ"]},{"verse_key":"56:29","text":"وَّطَلحٍ مَّنضُودٍ","words":["وَّطَلحٍ","مَّنضُودٍ"]},{"verse_key":"56:30","text":"وَّظِلٍّ مَّمدُودٍ","words":["وَّظِلٍّ","مَّمدُودٍ"]},{"verse_key":"56:31","text":"وَّ مَآءٍ مَّسكُوبٍ","words":["وَّ مَآءٍ","مَّسكُوبٍ"]},{"verse_key":"56:32","text":"وَّفَاكِهَةٍ كَثِيرَةٍ","words":["وَّفَاكِهَةٍ","كَثِيرَةٍ"]},{"verse_key":"56:33","text":"لَّا مَقطُوعَةٍ وَّلَا مَمنُوعَةٍ","words":["لَّا","مَقطُوعَةٍ","وَّلَا","مَمنُوعَةٍ"]},{"verse_key":"56:34","text":"وَّ فُرُشٍ مَّرفُوعَةٍؕ","words":["وَّ فُرُشٍ","مَّرفُوعَةٍؕ"]},{"verse_key":"56:35","text":"اِنَّا اَنشَانٰهُنَّ اِنشَآءً","words":["اِنَّا","اَنشَانٰهُنَّ","اِنشَآءً"]},{"verse_key":"56:36","text":"فَجَعَلنٰهُنَّ اَبكَارًا","words":["فَجَعَلنٰهُنَّ","اَبكَارًا"]},{"verse_key":"56:37","text":"عُرُبًا اَترَابًا","words":["عُرُبًا","اَترَابًا"]},{"verse_key":"56:38","text":"لِّاَصحٰبِ اليَمِينِؕ","words":["لِّاَصحٰبِ","اليَمِينِؕ"]},{"verse_key":"56:39","text":"ثُلَّةٌ مِّنَ الاَوَّلِينَ","words":["ثُلَّةٌ","مِّنَ","الاَوَّلِينَ"]},{"verse_key":"56:40","text":"وَثُلَّةٌ مِّنَ الاٰخِرِينَؕ","words":["وَثُلَّةٌ","مِّنَ","الاٰخِرِينَؕ"]},{"verse_key":"56:41","text":"وَاَصحٰبُ الشِّمَالِ  مَا اَصحٰبُ الشِّمَالِؕ","words":["وَاَصحٰبُ","الشِّمَالِ ","مَا","اَصحٰبُ","الشِّمَالِؕ"]},{"verse_key":"56:42","text":"فِى سَمُومٍ وَّحَمِيمٍ","words":["فِى","سَمُومٍ","وَّحَمِيمٍ"]},{"verse_key":"56:43","text":"وَّظِلٍّ مِّن يَّحمُومٍ","words":["وَّظِلٍّ","مِّن","يَّحمُومٍ"]},{"verse_key":"56:44","text":"لَّا بَارِدٍ وَّلَا كَرِيمٍ","words":["لَّا","بَارِدٍ","وَّلَا","كَرِيمٍ"]},{"verse_key":"56:45","text":"اِنَّهُم كَانُوا قَبلَ ذٰ لِكَ مُترَفِينَ  ","words":["اِنَّهُم","كَانُوا","قَبلَ","ذٰ","لِكَ مُترَفِينَ  "]},{"verse_key":"56:46","text":"وَكَانُوا يُصِرُّونَ عَلَى الحِنثِ العَظِيمِ","words":["وَكَانُوا","يُصِرُّونَ","عَلَى","الحِنثِ","العَظِيمِ"]},{"verse_key":"56:47","text":"وَكَانُوا يَقُولُونَ  اَٮِٕذَا مِتنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبعُوثُونَ","words":["وَكَانُوا","يَقُولُونَ ","اَٮِٕذَا","مِتنَا","وَكُنَّا","تُرَابًا","وَّعِظَامًا","ءَاِنَّا","لَمَبعُوثُونَ"]},{"verse_key":"56:48","text":"اَوَاٰبَآؤُنَا الاَوَّلُونَ","words":["اَوَاٰبَآؤُنَا","الاَوَّلُونَ"]},{"verse_key":"56:49","text":"قُل اِنَّ الاَوَّلِينَ وَالاٰخِرِينَ","words":["قُل","اِنَّ","الاَوَّلِينَ","وَالاٰخِرِينَ"]},{"verse_key":"56:50","text":"لَمَجمُوعُونَ  اِلٰى مِيقَاتِ يَومٍ مَّعلُومٍ","words":["لَمَجمُوعُونَ ","اِلٰى","مِيقَاتِ","يَومٍ","مَّعلُومٍ"]},{"verse_key":"56:51","text":"ثُمَّ اِنَّكُم اَيُّهَا الضَّآلُّونَ المُكَذِّبُونَ","words":["ثُمَّ","اِنَّكُم","اَيُّهَا","الضَّآلُّونَ","المُكَذِّبُونَ"]},{"verse_key":"56:52","text":"لَاٰكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ","words":["لَاٰكِلُونَ","مِن","شَجَرٍ","مِّن","زَقُّومٍ"]},{"verse_key":"56:53","text":"فَمٰلِــُٔونَ مِنهَا البُطُونَ","words":["فَمٰلِــُٔونَ","مِنهَا","البُطُونَ"]},{"verse_key":"56:54","text":"فَشٰرِبُونَ عَلَيهِ مِنَ الحَمِيمِ","words":["فَشٰرِبُونَ","عَلَيهِ","مِنَ","الحَمِيمِ"]},{"verse_key":"56:55","text":"فَشٰرِبُونَ شُربَ الهِيمِؕ","words":["فَشٰرِبُونَ","شُربَ","الهِيمِؕ"]},{"verse_key":"56:56","text":"هٰذَا نُزُلُهُم يَومَ الدِّينِؕ","words":["هٰذَا","نُزُلُهُم","يَومَ","الدِّينِؕ"]},{"verse_key":"56:57","text":"نَحنُ خَلَقنٰكُم فَلَولَا تُصَدِّقُونَ","words":["نَحنُ","خَلَقنٰكُم","فَلَولَا","تُصَدِّقُونَ"]},{"verse_key":"56:58","text":"اَفَرَءَيتُم مَّا تُمنُونَؕ","words":["اَفَرَءَيتُم","مَّا","تُمنُونَؕ"]},{"verse_key":"56:59","text":"ءَاَنتُم تَخلُقُونَهٗ اَم نَحنُ الخٰلِقُونَ","words":["ءَاَنتُم","تَخلُقُونَهٗ","اَم","نَحنُ","الخٰلِقُونَ"]},{"verse_key":"56:60","text":"نَحنُ قَدَّرنَا بَينَكُمُ المَوتَ وَمَا نَحنُ بِمَسبُوقِينَ","words":["نَحنُ","قَدَّرنَا","بَينَكُمُ","المَوتَ","وَمَا","نَحنُ","بِمَسبُوقِينَ"]},{"verse_key":"56:61","text":"عَلٰٓى اَن نُّبَدِّلَ اَمثَالَـكُم وَنُـنشِئَكُم فِى مَا لَا تَعلَمُونَ ","words":["عَلٰٓى","اَن","نُّبَدِّلَ","اَمثَالَـكُم","وَنُـنشِئَكُم","فِى","مَا","لَا","تَعلَمُونَ "]},{"verse_key":"56:62","text":"وَلَـقَد عَلِمتُمُ النَّشاَةَ الاُولٰى فَلَولَا تَذَكَّرُونَ","words":["وَلَـقَد","عَلِمتُمُ","النَّشاَةَ","الاُولٰى","فَلَولَا","تَذَكَّرُونَ"]},{"verse_key":"56:63","text":"اَفَرَءَيتُم مَّا تَحرُثُونَؕ","words":["اَفَرَءَيتُم","مَّا","تَحرُثُونَؕ"]},{"verse_key":"56:64","text":"ءَاَنتُم تَزرَعُونَهٗ اَم نَحنُ الزّٰرِعُونَ","words":["ءَاَنتُم","تَزرَعُونَهٗ","اَم","نَحنُ","الزّٰرِعُونَ"]},{"verse_key":"56:65","text":"لَو نَشَآءُ لَجَـعَلنٰهُ حُطَامًا فَظَلتُم تَفَكَّهُونَ","words":["لَو","نَشَآءُ","لَجَـعَلنٰهُ","حُطَامًا","فَظَلتُم","تَفَكَّهُونَ"]},{"verse_key":"56:66","text":"اِنَّا لَمُغرَمُونَ","words":["اِنَّا","لَمُغرَمُونَ"]},{"verse_key":"56:67","text":"بَل نَحنُ مَحرُومُونَ","words":["بَل","نَحنُ","مَحرُومُونَ"]},{"verse_key":"56:68","text":"اَفَرَءَيتُمُ المَآءَ الَّذِى تَشرَبُونَؕ","words":["اَفَرَءَيتُمُ","المَآءَ","الَّذِى","تَشرَبُونَؕ"]},{"verse_key":"56:69","text":"ءَاَنـتُم اَنزَلـتُمُوهُ مِنَ المُزنِ اَم نَحنُ المُنزِلُونَ ","words":["ءَاَنـتُم","اَنزَلـتُمُوهُ","مِنَ","المُزنِ","اَم","نَحنُ","المُنزِلُونَ "]},{"verse_key":"56:70","text":"لَو نَشَآءُ جَعَلنٰهُ اُجَاجًا فَلَولَا تَشكُرُونَ","words":["لَو","نَشَآءُ","جَعَلنٰهُ","اُجَاجًا","فَلَولَا","تَشكُرُونَ"]},{"verse_key":"56:71","text":"اَفَرَءَيتُمُ النَّارَ الَّتِى تُورُونَؕ","words":["اَفَرَءَيتُمُ","النَّارَ","الَّتِى","تُورُونَؕ"]},{"verse_key":"56:72","text":"ءَاَنتُم اَنشَاتُم شَجَرَتَهَا اَم نَحنُ المُنشِـُٔـونَ","words":["ءَاَنتُم","اَنشَاتُم","شَجَرَتَهَا","اَم","نَحنُ","المُنشِـُٔـونَ"]},{"verse_key":"56:73","text":"نَحنُ جَعَلنٰهَا تَذكِرَةً وَّمَتَاعًا لِّلمُقوِينَ","words":["نَحنُ","جَعَلنٰهَا","تَذكِرَةً","وَّمَتَاعًا","لِّلمُقوِينَ"]},{"verse_key":"56:74","text":"فَسَبِّح بِاسمِ رَبِّكَ العَظِيمِ","words":["فَسَبِّح","بِاسمِ","رَبِّكَ","العَظِيمِ"]},{"verse_key":"56:75","text":" فَلَا اُقسِمُ بِمَوٰقِعِ النُّجُومِ","words":[" فَلَا","اُقسِمُ","بِمَوٰقِعِ","النُّجُومِ"]},{"verse_key":"56:76","text":"وَاِنَّهٗ لَقَسَمٌ لَّو تَعلَمُونَ عَظِيمٌ","words":["وَاِنَّهٗ","لَقَسَمٌ","لَّو","تَعلَمُونَ","عَظِيمٌ"]},{"verse_key":"56:77","text":"اِنَّهٗ لَـقُراٰنٌ كَرِيمٌ","words":["اِنَّهٗ","لَـقُراٰنٌ","كَرِيمٌ"]},{"verse_key":"56:78","text":"فِى كِتٰبٍ مَّكنُونٍ","words":["فِى","كِتٰبٍ","مَّكنُونٍ"]},{"verse_key":"56:79","text":"لَّا يَمَسُّهٗ اِلَّا المُطَهَّرُونَؕ","words":["لَّا","يَمَسُّهٗ","اِلَّا","المُطَهَّرُونَؕ"]},{"verse_key":"56:80","text":"تَنزِيلٌ مِّن رَّبِّ العٰلَمِينَ","words":["تَنزِيلٌ","مِّن","رَّبِّ","العٰلَمِينَ"]},{"verse_key":"56:81","text":"اَفَبِهٰذَا الحَـدِيثِ اَنتُم مُّدهِنُونَ","words":["اَفَبِهٰذَا","الحَـدِيثِ","اَنتُم","مُّدهِنُونَ"]},{"verse_key":"56:82","text":"وَتَجعَلُونَ رِزقَكُم اَنَّكُم تُكَذِّبُونَ","words":["وَتَجعَلُونَ","رِزقَكُم","اَنَّكُم","تُكَذِّبُونَ"]},{"verse_key":"56:83","text":"فَلَولَا اِذَا بَلَغَتِ الحُـلقُومَ","words":["فَلَولَا","اِذَا","بَلَغَتِ","الحُـلقُومَ"]},{"verse_key":"56:84","text":"وَاَنتُم حِينَٮِٕذٍ تَـنظُرُونَ","words":["وَاَنتُم","حِينَٮِٕذٍ","تَـنظُرُونَ"]},{"verse_key":"56:85","text":"وَنَحنُ اَقرَبُ اِلَيهِ مِنكُم وَلٰـكِن لَّا تُبصِرُونَ","words":["وَنَحنُ","اَقرَبُ","اِلَيهِ","مِنكُم","وَلٰـكِن","لَّا","تُبصِرُونَ"]},{"verse_key":"56:86","text":"فَلَولَا اِن كُنتُم غَيرَ مَدِينِينَ","words":["فَلَولَا","اِن","كُنتُم","غَيرَ","مَدِينِينَ"]},{"verse_key":"56:87","text":"تَرجِعُونَهَا اِن كُنتُم صٰدِقِينَ","words":["تَرجِعُونَهَا","اِن","كُنتُم","صٰدِقِينَ"]},{"verse_key":"56:88","text":"فَاَمَّا اِن كَانَ مِنَ المُقَرَّبِينَ","words":["فَاَمَّا","اِن","كَانَ","مِنَ","المُقَرَّبِينَ"]},{"verse_key":"56:89","text":"فَرَوحٌ وَّ رَيحَانٌ  وَّجَنَّتُ نَعِيمٍ","words":["فَرَوحٌ","وَّ رَيحَانٌ ","وَّجَنَّتُ","نَعِيمٍ"]},{"verse_key":"56:90","text":"وَاَمَّا اِن كَانَ مِن اَصحٰبِ اليَمِينِ","words":["وَاَمَّا","اِن","كَانَ","مِن","اَصحٰبِ","اليَمِينِ"]},{"verse_key":"56:91","text":"فَسَلٰمٌ لَّكَ مِن اَصحٰبِ اليَمِينِؕ","words":["فَسَلٰمٌ","لَّكَ","مِن","اَصحٰبِ","اليَمِينِؕ"]},{"verse_key":"56:92","text":"وَاَمَّا اِن كَانَ مِنَ المُكَذِّبِينَ الضَّآلِّينَ","words":["وَاَمَّا","اِن","كَانَ","مِنَ","المُكَذِّبِينَ","الضَّآلِّينَ"]},{"verse_key":"56:93","text":"فَنُزُلٌ مِّن حَمِيمٍ","words":["فَنُزُلٌ","مِّن","حَمِيمٍ"]},{"verse_key":"56:94","text":"وَّتَصلِيَةُ جَحِيمٍ","words":["وَّتَصلِيَةُ","جَحِيمٍ"]},{"verse_key":"56:95","text":"اِنَّ هٰذَا لَهُوَ حَقُّ اليَـقِينِ","words":["اِنَّ","هٰذَا","لَهُوَ","حَقُّ","اليَـقِينِ"]},{"verse_key":"56:96","text":"فَسَبِّح بِاسمِ رَبِّكَ العَظِيمِ","words":["فَسَبِّح","بِاسمِ","رَبِّكَ","العَظِيمِ"]}]}