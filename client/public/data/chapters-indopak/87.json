{"verses":[{"verse_key":"87:1","text":"سَبِّحِ اسمَ رَبِّكَ الاَعلَى","words":["سَبِّحِ","اسمَ","رَبِّكَ","الاَعلَى"]},{"verse_key":"87:2","text":"الَّذِى خَلَقَ فَسَوّٰى ","words":["الَّذِى","خَلَقَ","فَسَوّٰى "]},{"verse_key":"87:3","text":"وَالَّذِى قَدَّرَ فَهَدٰى ","words":["وَالَّذِى","قَدَّرَ","فَهَدٰى "]},{"verse_key":"87:4","text":"وَالَّذِى اَخرَجَ المَرعٰى ","words":["وَالَّذِى","اَخرَجَ","المَرعٰى "]},{"verse_key":"87:5","text":"فَجَعَلَهٗ غُثَآءً اَحوٰىؕ","words":["فَجَعَلَهٗ","غُثَآءً","اَحوٰىؕ"]},{"verse_key":"87:6","text":"سَنُقرِئُكَ فَلَا تَنسٰٓى","words":["سَنُقرِئُكَ","فَلَا","تَنسٰٓى"]},{"verse_key":"87:7","text":"اِلَّا مَا شَآءَ اللّٰهُؕ اِنَّهٗ يَعلَمُ الجَهرَ وَمَا يَخفٰىؕ","words":["اِلَّا","مَا","شَآءَ","اللّٰهُؕ","اِنَّهٗ","يَعلَمُ","الجَهرَ","وَمَا","يَخفٰىؕ"]},{"verse_key":"87:8","text":"وَنُيَسِّرُكَ لِليُسرٰى ","words":["وَنُيَسِّرُكَ","لِليُسرٰى "]},{"verse_key":"87:9","text":"فَذَكِّر اِن نَّفَعَتِ الذِّكرٰىؕ","words":["فَذَكِّر","اِن","نَّفَعَتِ","الذِّكرٰىؕ"]},{"verse_key":"87:10","text":"سَيَذَّكَّرُ مَن يَّخشٰى","words":["سَيَذَّكَّرُ","مَن","يَّخشٰى"]},{"verse_key":"87:11","text":"وَيَتَجَنَّبُهَا الاَشقَى","words":["وَيَتَجَنَّبُهَا","الاَشقَى"]},{"verse_key":"87:12","text":"الَّذِى يَصلَى النَّارَ الكُبرٰى","words":["الَّذِى","يَصلَى","النَّارَ","الكُبرٰى"]},{"verse_key":"87:13","text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحيٰىؕ","words":["ثُمَّ","لَا","يَمُوتُ","فِيهَا","وَلَا","يَحيٰىؕ"]},{"verse_key":"87:14","text":"قَد اَفلَحَ مَن تَزَكّٰى","words":["قَد","اَفلَحَ","مَن","تَزَكّٰى"]},{"verse_key":"87:15","text":"وَذَكَرَ اسمَ رَبِّهٖ فَصَلّٰى ؕ","words":["وَذَكَرَ","اسمَ","رَبِّهٖ","فَصَلّٰى ؕ"]},{"verse_key":"87:16","text":"بَل تُؤثِرُونَ الحَيٰوةَ الدُّنيَا ","words":["بَل","تُؤثِرُونَ","الحَيٰوةَ","الدُّنيَا "]},{"verse_key":"87:17","text":"وَالاٰخِرَةُ خَيرٌ وَّ اَبقٰىؕ","words":["وَالاٰخِرَةُ","خَيرٌ","وَّ اَبقٰىؕ"]},{"verse_key":"87:18","text":"اِنَّ هٰذَا لَفِى الصُّحُفِ الاُولٰى","words":["اِنَّ","هٰذَا","لَفِى","الصُّحُفِ","الاُولٰى"]},{"verse_key":"87:19","text":"صُحُفِ اِبرٰهِيمَ وَمُوسٰى","words":["صُحُفِ","اِبرٰهِيمَ","وَمُوسٰى"]}]}