{"verses":[{"verse_key":"84:1","text":"اِذَا السَّمَآءُ انْشَقَّت","words":["اِذَا","السَّمَآءُ","انْشَقَّت"]},{"verse_key":"84:2","text":"وَاَذِنَت لِرَبِّهَا وَحُقَّت","words":["وَاَذِنَت","لِرَبِّهَا","وَحُقَّت"]},{"verse_key":"84:3","text":"وَاِذَا الاَرضُ مُدَّتؕ","words":["وَاِذَا","الاَرضُ","مُدَّتؕ"]},{"verse_key":"84:4","text":"وَاَلقَت مَا فِيهَا وَتَخَلَّت","words":["وَاَلقَت","مَا","فِيهَا","وَتَخَلَّت"]},{"verse_key":"84:5","text":"وَاَذِنَت لِرَبِّهَا وَحُقَّتؕ","words":["وَاَذِنَت","لِرَبِّهَا","وَحُقَّتؕ"]},{"verse_key":"84:6","text":"يٰاَيُّهَا الاِنسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدحًا فَمُلٰقِيهِ ","words":["يٰاَيُّهَا","الاِنسَانُ","اِنَّكَ","كَادِحٌ","اِلٰى","رَبِّكَ","كَدحًا","فَمُلٰقِيهِ "]},{"verse_key":"84:7","text":"فَاَمَّا مَن اُوتِىَ كِتٰبَهٗ بِيَمِينِهٖ","words":["فَاَمَّا","مَن","اُوتِىَ","كِتٰبَهٗ","بِيَمِينِهٖ"]},{"verse_key":"84:8","text":"فَسَوفَ يُحَاسَبُ حِسَابًا يَّسِيرًا ","words":["فَسَوفَ","يُحَاسَبُ","حِسَابًا","يَّسِيرًا "]},{"verse_key":"84:9","text":"وَّيَنقَلِبُ اِلٰٓى اَهلِهٖ مَسرُورًا ؕ","words":["وَّيَنقَلِبُ","اِلٰٓى","اَهلِهٖ","مَسرُورًا ؕ"]},{"verse_key":"84:10","text":"وَاَمَّا مَن اُوتِىَ كِتٰبَهٗ وَرَآءَ ظَهرِهٖ","words":["وَاَمَّا","مَن","اُوتِىَ","كِتٰبَهٗ","وَرَآءَ","ظَهرِهٖ"]},{"verse_key":"84:11","text":"فَسَوفَ يَدعُوا ثُبُورًا ","words":["فَسَوفَ","يَدعُوا","ثُبُورًا "]},{"verse_key":"84:12","text":"وَّيَصلٰى سَعِيرًا ؕ","words":["وَّيَصلٰى","سَعِيرًا ؕ"]},{"verse_key":"84:13","text":"اِنَّهٗ كَانَ فِى اَهلِهٖ مَسرُورًا ؕ","words":["اِنَّهٗ","كَانَ","فِى","اَهلِهٖ","مَسرُورًا ؕ"]},{"verse_key":"84:14","text":"اِنَّهٗ ظَنَّ اَن لَّن يَّحُورَ ","words":["اِنَّهٗ","ظَنَّ","اَن","لَّن","يَّحُورَ "]},{"verse_key":"84:15","text":"بَلٰٓى  اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِيرًا ؕ","words":["بَلٰٓى ","اِنَّ","رَبَّهٗ","كَانَ","بِهٖ","بَصِيرًا ؕ"]},{"verse_key":"84:16","text":"فَلَا اُقسِمُ بِالشَّفَقِ","words":["فَلَا","اُقسِمُ","بِالشَّفَقِ"]},{"verse_key":"84:17","text":"وَالَّيلِ وَمَا وَسَقَ","words":["وَالَّيلِ","وَمَا","وَسَقَ"]},{"verse_key":"84:18","text":"وَالقَمَرِ اِذَا اتَّسَقَ","words":["وَالقَمَرِ","اِذَا","اتَّسَقَ"]},{"verse_key":"84:19","text":"لَتَركَبُنَّ طَبَقًا عَن طَبَقٍؕ","words":["لَتَركَبُنَّ","طَبَقًا","عَن","طَبَقٍؕ"]},{"verse_key":"84:20","text":"فَمَا لَهُم لَا يُؤمِنُونَ","words":["فَمَا","لَهُم","لَا","يُؤمِنُونَ"]},{"verse_key":"84:21","text":"وَاِذَا قُرِئَ عَلَيهِمُ القُراٰنُ لَا يَسجُدُونَ ؕ ","words":["وَاِذَا","قُرِئَ","عَلَيهِمُ","القُراٰنُ","لَا","يَسجُدُونَ ؕ "]},{"verse_key":"84:22","text":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ ","words":["بَلِ","الَّذِينَ","كَفَرُوا","يُكَذِّبُونَ "]},{"verse_key":"84:23","text":"وَاللّٰهُ اَعلَمُ بِمَا يُوعُونَ ","words":["وَاللّٰهُ","اَعلَمُ","بِمَا","يُوعُونَ "]},{"verse_key":"84:24","text":"فَبَشِّرهُم بِعَذَابٍ اَلِيمٍ","words":["فَبَشِّرهُم","بِعَذَابٍ","اَلِيمٍ"]},{"verse_key":"84:25","text":"اِلَّا الَّذِينَ اٰمَنُوا وَعَمِلُوا الصّٰلِحٰتِ لَهُم اَجرٌ غَيرُ مَمنُونٍ ","words":["اِلَّا","الَّذِينَ","اٰمَنُوا","وَعَمِلُوا","الصّٰلِحٰتِ","لَهُم","اَجرٌ","غَيرُ","مَمنُونٍ "]}]}