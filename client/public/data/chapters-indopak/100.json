{"verses":[{"verse_key":"100:1","text":"وَالعٰدِيٰتِ ضَبحًا ","words":["وَالعٰدِيٰتِ","ضَبحًا "]},{"verse_key":"100:2","text":"فَالمُورِيٰتِ قَدحًا ","words":["فَالمُورِيٰتِ","قَدحًا "]},{"verse_key":"100:3","text":"فَالمُغِيرٰتِ صُبحًا ","words":["فَالمُغِيرٰتِ","صُبحًا "]},{"verse_key":"100:4","text":"فَاَثَرنَ بِهٖ نَقعًا ","words":["فَاَثَرنَ","بِهٖ","نَقعًا "]},{"verse_key":"100:5","text":"فَوَسَطنَ بِهٖ جَمعًا ","words":["فَوَسَطنَ","بِهٖ","جَمعًا "]},{"verse_key":"100:6","text":"اِنَّ الاِنسَانَ لِرَبِّهٖ لَـكَنُودٌ ","words":["اِنَّ","الاِنسَانَ","لِرَبِّهٖ","لَـكَنُودٌ "]},{"verse_key":"100:7","text":"وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيدٌ ","words":["وَاِنَّهٗ","عَلٰى","ذٰلِكَ","لَشَهِيدٌ "]},{"verse_key":"100:8","text":"وَاِنَّهٗ لِحُبِّ الخَيرِ لَشَدِيدٌ ؕ","words":["وَاِنَّهٗ","لِحُبِّ","الخَيرِ","لَشَدِيدٌ ؕ"]},{"verse_key":"100:9","text":" اَفَلَا يَعلَمُ اِذَا بُعثِرَ مَا فِى القُبُورِ","words":[" اَفَلَا","يَعلَمُ","اِذَا","بُعثِرَ","مَا","فِى","القُبُورِ"]},{"verse_key":"100:10","text":"وَحُصِّلَ مَا فِى الصُّدُورِ","words":["وَحُصِّلَ","مَا","فِى","الصُّدُورِ"]},{"verse_key":"100:11","text":"اِنَّ رَبَّهُم بِهِم يَومَٮِٕذٍ لَّخَبِيرٌ","words":["اِنَّ","رَبَّهُم","بِهِم","يَومَٮِٕذٍ","لَّخَبِيرٌ"]}]}