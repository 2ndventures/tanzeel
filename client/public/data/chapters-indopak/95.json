{"verses":[{"verse_key":"95:1","text":"وَالتِّينِ وَالزَّيتُونِ","words":["وَالتِّينِ","وَالزَّيتُونِ"]},{"verse_key":"95:2","text":"وَطُورِ سِينِينَ","words":["وَطُورِ","سِينِينَ"]},{"verse_key":"95:3","text":"وَهٰذَا البَلَدِ الاَمِينِ","words":["وَهٰذَا","البَلَدِ","الاَمِينِ"]},{"verse_key":"95:4","text":"لَقَد خَلَقنَا الاِنسَانَ فِى اَحسَنِ تَقوِيمٍ","words":["لَقَد","خَلَقنَا","الاِنسَانَ","فِى","اَحسَنِ","تَقوِيمٍ"]},{"verse_key":"95:5","text":"ثُمَّ رَدَدنٰهُ اَسفَلَ سَافِلِينَ","words":["ثُمَّ","رَدَدنٰهُ","اَسفَلَ","سَافِلِينَ"]},{"verse_key":"95:6","text":"اِلَّا الَّذِينَ اٰمَنُوا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُم اَجرٌ غَيرُ مَمنُونٍؕ","words":["اِلَّا","الَّذِينَ","اٰمَنُوا","وَعَمِلُوا","الصّٰلِحٰتِ","فَلَهُم","اَجرٌ","غَيرُ","مَمنُونٍؕ"]},{"verse_key":"95:7","text":"فَمَا يُكَذِّبُكَ بَعدُ بِالدِّينِ","words":["فَمَا","يُكَذِّبُكَ","بَعدُ","بِالدِّينِ"]},{"verse_key":"95:8","text":"اَلَيسَ اللّٰهُ بِاَحكَمِ الحٰكِمِينَ","words":["اَلَيسَ","اللّٰهُ","بِاَحكَمِ","الحٰكِمِينَ"]}]}