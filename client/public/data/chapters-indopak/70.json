{"verses":[{"verse_key":"70:1","text":"سَاَلَ سَآٮِٕلٌ  بِعَذَابٍ وَّاقِعٍ","words":["سَاَلَ","سَآٮِٕلٌ ","بِعَذَابٍ","وَّاقِعٍ"]},{"verse_key":"70:2","text":"لِّلكٰفِرِينَ لَيسَ لَهٗ دَافِعٌ ","words":["لِّلكٰفِرِينَ","لَيسَ","لَهٗ","دَافِعٌ "]},{"verse_key":"70:3","text":"مِّنَ اللّٰهِ ذِى المَعَارِجِؕ","words":["مِّنَ","اللّٰهِ","ذِى","المَعَارِجِؕ"]},{"verse_key":"70:4","text":"تَعرُجُ المَلٰٓٮِٕكَةُ وَ الرُّوحُ اِلَيهِ فِى يَومٍ كَانَ مِقدَارُهٗ خَمسِينَ اَلفَ سَنَةٍ","words":["تَعرُجُ","المَلٰٓٮِٕكَةُ","وَ الرُّوحُ","اِلَيهِ","فِى","يَومٍ","كَانَ","مِقدَارُهٗ","خَمسِينَ","اَلفَ","سَنَةٍ"]},{"verse_key":"70:5","text":"فَاصبِر صَبرًا جَمِيلًا","words":["فَاصبِر","صَبرًا","جَمِيلًا"]},{"verse_key":"70:6","text":"اِنَّهُم يَرَونَهٗ بَعِيدًا ","words":["اِنَّهُم","يَرَونَهٗ","بَعِيدًا "]},{"verse_key":"70:7","text":"وَّنَرٰٮهُ قَرِيبًا ؕ","words":["وَّنَرٰٮهُ","قَرِيبًا ؕ"]},{"verse_key":"70:8","text":"يَومَ تَكُونُ السَّمَآءُ كَالمُهلِ","words":["يَومَ","تَكُونُ","السَّمَآءُ","كَالمُهلِ"]},{"verse_key":"70:9","text":"وَتَكُونُ الجِبَالُ كَالعِهنِ","words":["وَتَكُونُ","الجِبَالُ","كَالعِهنِ"]},{"verse_key":"70:10","text":"وَلَا يَسـَٔـلُ حَمِيمٌ حَمِيمًا ","words":["وَلَا","يَسـَٔـلُ","حَمِيمٌ","حَمِيمًا "]},{"verse_key":"70:11","text":"يُّبَصَّرُونَهُمؕ يَوَدُّ المُجرِمُ لَو يَفتَدِى مِن عَذَابِ يَومِٮِٕذٍ بِبَنِيهِ","words":["يُّبَصَّرُونَهُمؕ","يَوَدُّ","المُجرِمُ","لَو","يَفتَدِى","مِن","عَذَابِ","يَومِٮِٕذٍ","بِبَنِيهِ"]},{"verse_key":"70:12","text":"وَصَاحِبَتِهٖ وَاَخِيهِ","words":["وَصَاحِبَتِهٖ","وَاَخِيهِ"]},{"verse_key":"70:13","text":"وَفَصِيلَتِهِ الَّتِى تُــْٔوِيهِ","words":["وَفَصِيلَتِهِ","الَّتِى","تُــْٔوِيهِ"]},{"verse_key":"70:14","text":"وَمَن فِى الاَرضِ جَمِيعًا  ثُمَّ يُنجِيهِ","words":["وَمَن","فِى","الاَرضِ","جَمِيعًا ","ثُمَّ","يُنجِيهِ"]},{"verse_key":"70:15","text":"كَلَّا ؕ اِنَّهَا لَظٰى","words":["كَلَّا ؕ","اِنَّهَا","لَظٰى"]},{"verse_key":"70:16","text":"نَزَّاعَةً لِّلشَّوٰى ","words":["نَزَّاعَةً","لِّلشَّوٰى "]},{"verse_key":"70:17","text":"تَدعُوا مَن اَدبَرَ وَتَوَلّٰى","words":["تَدعُوا","مَن","اَدبَرَ","وَتَوَلّٰى"]},{"verse_key":"70:18","text":"وَجَمَعَ فَاَوعٰى","words":["وَجَمَعَ","فَاَوعٰى"]},{"verse_key":"70:19","text":" اِنَّ الاِنسَانَ خُلِقَ هَلُوعًا ","words":[" اِنَّ","الاِنسَانَ","خُلِقَ","هَلُوعًا "]},{"verse_key":"70:20","text":"اِذَا مَسَّهُ الشَّرُّ جَزُوعًا ","words":["اِذَا","مَسَّهُ","الشَّرُّ","جَزُوعًا "]},{"verse_key":"70:21","text":"وَاِذَا مَسَّهُ الخَيرُ مَنُوعًا ","words":["وَاِذَا","مَسَّهُ","الخَيرُ","مَنُوعًا "]},{"verse_key":"70:22","text":"اِلَّا المُصَلِّينَ","words":["اِلَّا","المُصَلِّينَ"]},{"verse_key":"70:23","text":"الَّذِينَ هُم عَلٰى صَلَاتِهِم دَآٮِٕمُونَ","words":["الَّذِينَ","هُم","عَلٰى","صَلَاتِهِم","دَآٮِٕمُونَ"]},{"verse_key":"70:24","text":"وَالَّذِينَ فِى اَموَالِهِم حَقٌّ مَّعلُومٌ","words":["وَالَّذِينَ","فِى","اَموَالِهِم","حَقٌّ","مَّعلُومٌ"]},{"verse_key":"70:25","text":"لِّلسَّآٮِٕلِ وَالمَحرُومِ","words":["لِّلسَّآٮِٕلِ","وَالمَحرُومِ"]},{"verse_key":"70:26","text":"وَالَّذِينَ يُصَدِّقُونَ بِيَومِ الدِّينِ","words":["وَالَّذِينَ","يُصَدِّقُونَ","بِيَومِ","الدِّينِ"]},{"verse_key":"70:27","text":"وَالَّذِينَ هُم مِّن عَذَابِ رَبِّهِم مُّشفِقُونَ","words":["وَالَّذِينَ","هُم","مِّن","عَذَابِ","رَبِّهِم","مُّشفِقُونَ"]},{"verse_key":"70:28","text":"اِنَّ عَذَابَ رَبِّهِم غَيرُ مَامُونٍ","words":["اِنَّ","عَذَابَ","رَبِّهِم","غَيرُ","مَامُونٍ"]},{"verse_key":"70:29","text":"وَالَّذِينَ هُم لِفُرُوجِهِم حٰفِظُونَ","words":["وَالَّذِينَ","هُم","لِفُرُوجِهِم","حٰفِظُونَ"]},{"verse_key":"70:30","text":"اِلَّا عَلٰٓى اَزوَاجِهِم اَو مَا مَلَـكَت اَيمَانُهُم فَاِنَّهُم غَيرُ مَلُومِينَ","words":["اِلَّا","عَلٰٓى","اَزوَاجِهِم","اَو","مَا","مَلَـكَت","اَيمَانُهُم","فَاِنَّهُم","غَيرُ","مَلُومِينَ"]},{"verse_key":"70:31","text":"فَمَنِ ابتَغٰى وَرَآءَ ذٰلِكَ فَاُولٰٓٮِٕكَ هُمُ العٰدُونَ","words":["فَمَنِ","ابتَغٰى","وَرَآءَ","ذٰلِكَ","فَاُولٰٓٮِٕكَ","هُمُ","العٰدُونَ"]},{"verse_key":"70:32","text":"وَالَّذِينَ هُم لِاَمٰنٰتِهِم وَعَهدِهِم رٰعُونَ ","words":["وَالَّذِينَ","هُم","لِاَمٰنٰتِهِم","وَعَهدِهِم","رٰعُونَ "]},{"verse_key":"70:33","text":"وَالَّذِينَ هُم بِشَهٰدٰتِهِم قَآٮِٕمُونَ ","words":["وَالَّذِينَ","هُم","بِشَهٰدٰتِهِم","قَآٮِٕمُونَ "]},{"verse_key":"70:34","text":"وَالَّذِينَ هُم عَلٰى صَلَاتِهِم يُحَافِظُونَؕ","words":["وَالَّذِينَ","هُم","عَلٰى","صَلَاتِهِم","يُحَافِظُونَؕ"]},{"verse_key":"70:35","text":"اُولٰٓٮِٕكَ فِى جَنّٰتٍ مُّكرَمُونَؕ","words":["اُولٰٓٮِٕكَ","فِى","جَنّٰتٍ","مُّكرَمُونَؕ"]},{"verse_key":"70:36","text":"فَمَالِ الَّذِينَ كَفَرُوا قِبَلَكَ مُهطِعِينَ","words":["فَمَالِ","الَّذِينَ","كَفَرُوا","قِبَلَكَ","مُهطِعِينَ"]},{"verse_key":"70:37","text":"عَنِ اليَمِينِ وَعَنِ الشِّمَالِ عِزِينَ","words":["عَنِ","اليَمِينِ","وَعَنِ","الشِّمَالِ","عِزِينَ"]},{"verse_key":"70:38","text":"اَيَطمَعُ كُلُّ امرِىءٍ مِّنهُم اَن يُّدخَلَ جَنَّةَ نَعِيمٍ ","words":["اَيَطمَعُ","كُلُّ","امرِىءٍ","مِّنهُم","اَن","يُّدخَلَ","جَنَّةَ","نَعِيمٍ "]},{"verse_key":"70:39","text":"كَلَّا ؕ اِنَّا خَلَقنٰهُم مِّمَّا يَعلَمُونَ","words":["كَلَّا ؕ","اِنَّا","خَلَقنٰهُم","مِّمَّا","يَعلَمُونَ"]},{"verse_key":"70:40","text":"فَلَا اُقسِمُ بِرَبِّ المَشٰرِقِ وَالمَغٰرِبِ اِنَّا لَقٰدِرُونَ","words":["فَلَا","اُقسِمُ","بِرَبِّ","المَشٰرِقِ","وَالمَغٰرِبِ","اِنَّا","لَقٰدِرُونَ"]},{"verse_key":"70:41","text":"عَلٰٓى اَن نُّبَدِّلَ خَيرًا مِّنهُم وَمَا نَحنُ بِمَسبُوقِينَ","words":["عَلٰٓى","اَن","نُّبَدِّلَ","خَيرًا","مِّنهُم","وَمَا","نَحنُ","بِمَسبُوقِينَ"]},{"verse_key":"70:42","text":"فَذَرهُم يَخُوضُوا وَيَلعَبُوا حَتّٰى يُلٰقُوا يَومَهُمُ الَّذِى يُوعَدُونَ","words":["فَذَرهُم","يَخُوضُوا","وَيَلعَبُوا","حَتّٰى","يُلٰقُوا","يَومَهُمُ","الَّذِى","يُوعَدُونَ"]},{"verse_key":"70:43","text":"يَومَ يَخرُجُونَ مِنَ الاَجدَاثِ سِرَاعًا كَاَنَّهُم اِلٰى نُصُبٍ يُّوفِضُونَ ","words":["يَومَ","يَخرُجُونَ","مِنَ","الاَجدَاثِ","سِرَاعًا","كَاَنَّهُم","اِلٰى","نُصُبٍ","يُّوفِضُونَ "]},{"verse_key":"70:44","text":"خَاشِعَةً اَبصَارُهُم تَرهَقُهُم ذِلَّةٌ ؕ ذٰلِكَ اليَومُ الَّذِى كَانُوا يُوعَدُونَ","words":["خَاشِعَةً","اَبصَارُهُم","تَرهَقُهُم","ذِلَّةٌ ؕ","ذٰلِكَ","اليَومُ","الَّذِى","كَانُوا","يُوعَدُونَ"]}]}