{"verses":[{"verse_key":"111:1","text":"تَبَّت يَدَا اَبِى لَهَبٍ وَّتَبَّؕ","words":["تَبَّت","يَدَا","اَبِى","لَهَبٍ","وَّتَبَّؕ"]},{"verse_key":"111:2","text":"مَا اَغنٰى عَنهُ مَالُهٗ وَمَا كَسَبَؕ","words":["مَا","اَغنٰى","عَنهُ","مَالُهٗ","وَمَا","كَسَبَؕ"]},{"verse_key":"111:3","text":"سَيَصلٰى نَارًا ذَاتَ لَهَبٍ ","words":["سَيَصلٰى","نَارًا","ذَاتَ","لَهَبٍ "]},{"verse_key":"111:4","text":"وَّامرَاَ تُهٗ ؕ حَمَّالَةَ الحَطَبِ","words":["وَّامرَاَ تُهٗ ؕ","حَمَّالَةَ","الحَطَبِ"]},{"verse_key":"111:5","text":"فِى جِيدِهَا حَبلٌ مِّن مَّسَدٍ","words":["فِى","جِيدِهَا","حَبلٌ","مِّن","مَّسَدٍ"]}]}