{"verses":[{"verse_key":"82:1","text":"اِذَا السَّمَآءُ انْفَطَرَت","words":["اِذَا","السَّمَآءُ","انْفَطَرَت"]},{"verse_key":"82:2","text":"وَاِذَا الكَوَاكِبُ انْتَثَرَت","words":["وَاِذَا","الكَوَاكِبُ","انْتَثَرَت"]},{"verse_key":"82:3","text":"وَاِذَا البِحَارُ فُجِّرَت","words":["وَاِذَا","البِحَارُ","فُجِّرَت"]},{"verse_key":"82:4","text":"وَاِذَا القُبُورُ بُعثِرَت","words":["وَاِذَا","القُبُورُ","بُعثِرَت"]},{"verse_key":"82:5","text":"عَلِمَت نَفسٌ مَّا قَدَّمَت وَاَخَّرَتؕ","words":["عَلِمَت","نَفسٌ","مَّا","قَدَّمَت","وَاَخَّرَتؕ"]},{"verse_key":"82:6","text":"يٰاَيُّهَا الاِنسَانُ مَا غَرَّكَ بِرَبِّكَ الكَرِيمِ","words":["يٰاَيُّهَا","الاِنسَانُ","مَا","غَرَّكَ","بِرَبِّكَ","الكَرِيمِ"]},{"verse_key":"82:7","text":"الَّذِى خَلَقَكَ فَسَوّٰٮكَ فَعَدَلَـكَ","words":["الَّذِى","خَلَقَكَ","فَسَوّٰٮكَ","فَعَدَلَـكَ"]},{"verse_key":"82:8","text":"فِى اَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَؕ","words":["فِى","اَىِّ","صُورَةٍ","مَّا","شَآءَ","رَكَّبَكَؕ"]},{"verse_key":"82:9","text":"كَلَّا بَل تُكَذِّبُونَ بِالدِّينِ","words":["كَلَّا","بَل","تُكَذِّبُونَ","بِالدِّينِ"]},{"verse_key":"82:10","text":"وَاِنَّ عَلَيكُم لَحٰـفِظِينَ","words":["وَاِنَّ","عَلَيكُم","لَحٰـفِظِينَ"]},{"verse_key":"82:11","text":"كِرَامًا كَاتِبِينَ","words":["كِرَامًا","كَاتِبِينَ"]},{"verse_key":"82:12","text":"يَعلَمُونَ مَا تَفعَلُونَ","words":["يَعلَمُونَ","مَا","تَفعَلُونَ"]},{"verse_key":"82:13","text":"اِنَّ الاَبرَارَ لَفِى نَعِيمٍ","words":["اِنَّ","الاَبرَارَ","لَفِى","نَعِيمٍ"]},{"verse_key":"82:14","text":"وَاِنَّ الفُجَّارَ لَفِى جَحِيمٍ ","words":["وَاِنَّ","الفُجَّارَ","لَفِى","جَحِيمٍ "]},{"verse_key":"82:15","text":"يَّصلَونَهَا يَومَ الدِّينِ","words":["يَّصلَونَهَا","يَومَ","الدِّينِ"]},{"verse_key":"82:16","text":"وَمَا هُم عَنهَا بِغَآٮِٕبِينَؕ","words":["وَمَا","هُم","عَنهَا","بِغَآٮِٕبِينَؕ"]},{"verse_key":"82:17","text":"وَمَا اَدرٰٮكَ مَا يَومُ الدِّينِ","words":["وَمَا","اَدرٰٮكَ","مَا","يَومُ","الدِّينِ"]},{"verse_key":"82:18","text":"ثُمَّ مَا اَدرٰٮكَ مَا يَومُ الدِّينِؕ","words":["ثُمَّ","مَا","اَدرٰٮكَ","مَا","يَومُ","الدِّينِؕ"]},{"verse_key":"82:19","text":"يَومَ لَا تَملِكُ نَفسٌ لِّنَفسٍ شَيـــًٔا ؕ وَالاَمرُ يَومَٮِٕذٍ لِّلَّهِ","words":["يَومَ","لَا","تَملِكُ","نَفسٌ","لِّنَفسٍ","شَيـــًٔا ؕ","وَالاَمرُ","يَومَٮِٕذٍ","لِّلَّهِ"]}]}