{"verses":[{"verse_key":"106:1","text":"لِاِيلٰفِ قُرَيشٍ","words":["لِاِيلٰفِ","قُرَيشٍ"]},{"verse_key":"106:2","text":"اٖلٰفِهِم رِحلَةَ الشِّتَآءِ وَالصَّيفِ","words":["اٖلٰفِهِم","رِحلَةَ","الشِّتَآءِ","وَالصَّيفِ"]},{"verse_key":"106:3","text":"فَليَـعبُدُوا رَبَّ هٰذَا البَيتِ","words":["فَليَـعبُدُوا","رَبَّ","هٰذَا","البَيتِ"]},{"verse_key":"106:4","text":"الَّذِى اَطعَمَهُم مِّن جُوعٍ    وَّاٰمَنَهُم مِّن خَوفٍ","words":["الَّذِى","اَطعَمَهُم","مِّن","جُوعٍ   ","وَّاٰمَنَهُم","مِّن","خَوفٍ"]}]}