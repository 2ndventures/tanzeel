{"verses":[{"verse_key":"92:1","text":"وَالَّيلِ اِذَا يَغشٰى","words":["وَالَّيلِ","اِذَا","يَغشٰى"]},{"verse_key":"92:2","text":"وَالنَّهَارِ اِذَا تَجَلّٰى","words":["وَالنَّهَارِ","اِذَا","تَجَلّٰى"]},{"verse_key":"92:3","text":"وَمَا خَلَقَ الذَّكَرَ وَالاُنثٰٓى","words":["وَمَا","خَلَقَ","الذَّكَرَ","وَالاُنثٰٓى"]},{"verse_key":"92:4","text":"اِنَّ سَعيَكُم لَشَتّٰىؕ","words":["اِنَّ","سَعيَكُم","لَشَتّٰىؕ"]},{"verse_key":"92:5","text":"فَاَمَّا مَن اَعطٰى وَاتَّقٰى","words":["فَاَمَّا","مَن","اَعطٰى","وَاتَّقٰى"]},{"verse_key":"92:6","text":"وَصَدَّقَ بِالحُسنٰى","words":["وَصَدَّقَ","بِالحُسنٰى"]},{"verse_key":"92:7","text":"فَسَنُيَسِّرُهٗ لِليُسرٰىؕ","words":["فَسَنُيَسِّرُهٗ","لِليُسرٰىؕ"]},{"verse_key":"92:8","text":"وَاَمَّا مَن بَخِلَ وَاستَغنٰى","words":["وَاَمَّا","مَن","بَخِلَ","وَاستَغنٰى"]},{"verse_key":"92:9","text":"وَكَذَّبَ بِالحُسنٰى","words":["وَكَذَّبَ","بِالحُسنٰى"]},{"verse_key":"92:10","text":"فَسَنُيَسِّرُهٗ لِلعُسرٰىؕ","words":["فَسَنُيَسِّرُهٗ","لِلعُسرٰىؕ"]},{"verse_key":"92:11","text":"وَمَا يُغنِى عَنهُ مَالُهٗ اِذَا تَرَدّٰىؕ","words":["وَمَا","يُغنِى","عَنهُ","مَالُهٗ","اِذَا","تَرَدّٰىؕ"]},{"verse_key":"92:12","text":"اِنَّ عَلَينَا لَـلهُدٰى","words":["اِنَّ","عَلَينَا","لَـلهُدٰى"]},{"verse_key":"92:13","text":"وَاِنَّ لَـنَا لَـلاٰخِرَةَ وَالاُولٰى","words":["وَاِنَّ","لَـنَا","لَـلاٰخِرَةَ","وَالاُولٰى"]},{"verse_key":"92:14","text":"فَاَنذَرتُكُم نَارًا تَلَظّٰى","words":["فَاَنذَرتُكُم","نَارًا","تَلَظّٰى"]},{"verse_key":"92:15","text":"لَا يَصلٰٮهَا اِلَّا الاَشقَى","words":["لَا","يَصلٰٮهَا","اِلَّا","الاَشقَى"]},{"verse_key":"92:16","text":"الَّذِى كَذَّبَ وَتَوَلّٰىؕ","words":["الَّذِى","كَذَّبَ","وَتَوَلّٰىؕ"]},{"verse_key":"92:17","text":"وَسَيُجَنَّبُهَا الاَتقَى","words":["وَسَيُجَنَّبُهَا","الاَتقَى"]},{"verse_key":"92:18","text":"الَّذِى يُؤتِى مَالَهٗ يَتَزَكّٰى","words":["الَّذِى","يُؤتِى","مَالَهٗ","يَتَزَكّٰى"]},{"verse_key":"92:19","text":"وَمَا لِاَحَدٍ عِندَهٗ مِن نِّعمَةٍ تُجزٰٓى","words":["وَمَا","لِاَحَدٍ","عِندَهٗ","مِن","نِّعمَةٍ","تُجزٰٓى"]},{"verse_key":"92:20","text":"اِلَّا ابتِغَآءَ وَجهِ رَبِّهِ الاَعلٰى","words":["اِلَّا","ابتِغَآءَ","وَجهِ","رَبِّهِ","الاَعلٰى"]},{"verse_key":"92:21","text":"وَلَسَوفَ يَرضٰى","words":["وَلَسَوفَ","يَرضٰى"]}]}