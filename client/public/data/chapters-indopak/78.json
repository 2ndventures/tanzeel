{"verses":[{"verse_key":"78:1","text":"عَمَّ يَتَسَآءَلُونَ","words":["عَمَّ","يَتَسَآءَلُونَ"]},{"verse_key":"78:2","text":"عَنِ النَّبَاِ العَظِيمِ","words":["عَنِ","النَّبَاِ","العَظِيمِ"]},{"verse_key":"78:3","text":"الَّذِى هُم فِيهِ مُختَلِفُونَؕ","words":["الَّذِى","هُم","فِيهِ","مُختَلِفُونَؕ"]},{"verse_key":"78:4","text":"كَلَّا سَيَعلَمُونَ","words":["كَلَّا","سَيَعلَمُونَ"]},{"verse_key":"78:5","text":"ثُمَّ كَلَّا سَيَعلَمُونَ","words":["ثُمَّ","كَلَّا","سَيَعلَمُونَ"]},{"verse_key":"78:6","text":"اَلَم نَجعَلِ الاَرضَ مِهٰدًا ","words":["اَلَم","نَجعَلِ","الاَرضَ","مِهٰدًا "]},{"verse_key":"78:7","text":"وَّالجِبَالَ اَوتَادًا ","words":["وَّالجِبَالَ","اَوتَادًا "]},{"verse_key":"78:8","text":"وَّخَلَقنٰكُم اَزوَاجًا ","words":["وَّخَلَقنٰكُم","اَزوَاجًا "]},{"verse_key":"78:9","text":"وَّجَعَلنَا نَومَكُم سُبَاتًا ","words":["وَّجَعَلنَا","نَومَكُم","سُبَاتًا "]},{"verse_key":"78:10","text":"وَّجَعَلنَا الَّيلَ لِبَاسًا ","words":["وَّجَعَلنَا","الَّيلَ","لِبَاسًا "]},{"verse_key":"78:11","text":"وَّجَعَلنَا النَّهَارَ مَعَاشًا","words":["وَّجَعَلنَا","النَّهَارَ","مَعَاشًا"]},{"verse_key":"78:12","text":"وَّبَنَينَا فَوقَكُم سَبعًا شِدَادًا ","words":["وَّبَنَينَا","فَوقَكُم","سَبعًا","شِدَادًا "]},{"verse_key":"78:13","text":"وَّجَعَلنَا سِرَاجًا وَّهَّاجًا ","words":["وَّجَعَلنَا","سِرَاجًا","وَّهَّاجًا "]},{"verse_key":"78:14","text":"وَّاَنزَلنَا مِنَ المُعصِرٰتِ مَآءً ثَجَّاجًا ","words":["وَّاَنزَلنَا","مِنَ","المُعصِرٰتِ","مَآءً","ثَجَّاجًا "]},{"verse_key":"78:15","text":"لِّـنُخرِجَ بِهٖ حَبًّا وَّنَبَاتًا ","words":["لِّـنُخرِجَ","بِهٖ","حَبًّا","وَّنَبَاتًا "]},{"verse_key":"78:16","text":"وَّجَنّٰتٍ اَلفَافًا ؕ","words":["وَّجَنّٰتٍ","اَلفَافًا ؕ"]},{"verse_key":"78:17","text":"اِنَّ يَومَ الفَصلِ كَانَ مِيقَاتًا ","words":["اِنَّ","يَومَ","الفَصلِ","كَانَ","مِيقَاتًا "]},{"verse_key":"78:18","text":"يَّومَ يُنفَخُ فِى الصُّورِ فَتَاتُونَ اَفوَاجًا ","words":["يَّومَ","يُنفَخُ","فِى","الصُّورِ","فَتَاتُونَ","اَفوَاجًا "]},{"verse_key":"78:19","text":"وَّفُتِحَتِ السَّمَآءُ فَكَانَت اَبوَابًا ","words":["وَّفُتِحَتِ","السَّمَآءُ","فَكَانَت","اَبوَابًا "]},{"verse_key":"78:20","text":"وَّ سُيِّرَتِ الجِبَالُ فَكَانَت سَرَابًا ؕ","words":["وَّ سُيِّرَتِ","الجِبَالُ","فَكَانَت","سَرَابًا ؕ"]},{"verse_key":"78:21","text":"اِنَّ جَهَنَّمَ كَانَت مِرصَادًا ","words":["اِنَّ","جَهَنَّمَ","كَانَت","مِرصَادًا "]},{"verse_key":"78:22","text":"لِّلطّٰغِينَ مَاٰبًا ","words":["لِّلطّٰغِينَ","مَاٰبًا "]},{"verse_key":"78:23","text":"لّٰبِثِينَ فِيهَا اَحقَابًا ","words":["لّٰبِثِينَ","فِيهَا","اَحقَابًا "]},{"verse_key":"78:24","text":"لَا يَذُوقُونَ فِيهَا بَردًا وَّلَا شَرَابًا ","words":["لَا","يَذُوقُونَ","فِيهَا","بَردًا","وَّلَا","شَرَابًا "]},{"verse_key":"78:25","text":"اِلَّا حَمِيمًا وَّغَسَّاقًا ","words":["اِلَّا","حَمِيمًا","وَّغَسَّاقًا "]},{"verse_key":"78:26","text":"جَزَآءً وِّفَاقًا ؕ","words":["جَزَآءً","وِّفَاقًا ؕ"]},{"verse_key":"78:27","text":"اِنَّهُم كَانُوا لَا يَرجُونَ حِسَابًا ","words":["اِنَّهُم","كَانُوا","لَا","يَرجُونَ","حِسَابًا "]},{"verse_key":"78:28","text":"وَّكَذَّبُوا بِاٰيٰتِنَا كِذَّابًا ؕ","words":["وَّكَذَّبُوا","بِاٰيٰتِنَا","كِذَّابًا ؕ"]},{"verse_key":"78:29","text":"وَكُلَّ شَىءٍ اَحصَينٰهُ كِتٰبًا ","words":["وَكُلَّ","شَىءٍ","اَحصَينٰهُ","كِتٰبًا "]},{"verse_key":"78:30","text":"فَذُوقُوا فَلَن نَّزِيدَكُم اِلَّا عَذَابًا","words":["فَذُوقُوا","فَلَن","نَّزِيدَكُم","اِلَّا","عَذَابًا"]},{"verse_key":"78:31","text":"اِنَّ لِلمُتَّقِينَ مَفَازًا ","words":["اِنَّ","لِلمُتَّقِينَ","مَفَازًا "]},{"verse_key":"78:32","text":"حَدَآٮِٕقَ وَاَعنَابًا ","words":["حَدَآٮِٕقَ","وَاَعنَابًا "]},{"verse_key":"78:33","text":"وَّكَوَاعِبَ اَترَابًا ","words":["وَّكَوَاعِبَ","اَترَابًا "]},{"verse_key":"78:34","text":"وَّكَاسًا دِهَاقًا ؕ","words":["وَّكَاسًا","دِهَاقًا ؕ"]},{"verse_key":"78:35","text":"لَا يَسمَعُونَ فِيهَا لَـغوًا وَّلَا كِذّٰبًا ","words":["لَا","يَسمَعُونَ","فِيهَا","لَـغوًا","وَّلَا","كِذّٰبًا "]},{"verse_key":"78:36","text":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا ","words":["جَزَآءً","مِّن","رَّبِّكَ","عَطَآءً","حِسَابًا "]},{"verse_key":"78:37","text":"رَّبِّ السَّمٰوٰتِ وَالاَرضِ وَمَا بَينَهُمَا الرَّحمٰنِ لَا يَملِكُونَ مِنهُ خِطَابًا ","words":["رَّبِّ","السَّمٰوٰتِ","وَالاَرضِ","وَمَا","بَينَهُمَا","الرَّحمٰنِ","لَا","يَملِكُونَ","مِنهُ","خِطَابًا "]},{"verse_key":"78:38","text":"يَومَ يَقُومُ الرُّوحُ وَالمَلٰٓٮِٕكَةُ صَفًّا ؕ لَّا يَتَكَلَّمُونَ اِلَّا مَن اَذِنَ لَهُ الرَّحمٰنُ وَقَالَ صَوَابًا","words":["يَومَ","يَقُومُ","الرُّوحُ","وَالمَلٰٓٮِٕكَةُ","صَفًّا ؕ","لَّا","يَتَكَلَّمُونَ","اِلَّا","مَن","اَذِنَ","لَهُ","الرَّحمٰنُ","وَقَالَ","صَوَابًا"]},{"verse_key":"78:39","text":"ذٰلِكَ اليَومُ الحَـقُّ  فَمَن شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا ","words":["ذٰلِكَ","اليَومُ","الحَـقُّ ","فَمَن","شَآءَ","اتَّخَذَ","اِلٰى","رَبِّهٖ","مَاٰبًا "]},{"verse_key":"78:40","text":"اِنَّا اَنذَرنٰـكُم عَذَابًا قَرِيبًا   يَّومَ يَنظُرُ المَرءُ مَا قَدَّمَت يَدٰهُ وَيَقُولُ الـكٰفِرُ يٰلَيتَنِى كُنتُ تُرٰبًا","words":["اِنَّا","اَنذَرنٰـكُم","عَذَابًا","قَرِيبًا  ","يَّومَ","يَنظُرُ","المَرءُ","مَا","قَدَّمَت","يَدٰهُ","وَيَقُولُ","الـكٰفِرُ","يٰلَيتَنِى","كُنتُ","تُرٰبًا"]}]}