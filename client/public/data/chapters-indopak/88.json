{"verses":[{"verse_key":"88:1","text":"هَل اَتٰٮكَ حَدِيثُ الغَاشِيَةِؕ","words":["هَل","اَتٰٮكَ","حَدِيثُ","الغَاشِيَةِؕ"]},{"verse_key":"88:2","text":"وُجُوهٌ يَّومَٮِٕذٍ خَاشِعَةٌ ","words":["وُجُوهٌ","يَّومَٮِٕذٍ","خَاشِعَةٌ "]},{"verse_key":"88:3","text":"عَامِلَةٌ نَّاصِبَةٌ ","words":["عَامِلَةٌ","نَّاصِبَةٌ "]},{"verse_key":"88:4","text":"تَصلٰى نَارًا حَامِيَةً ","words":["تَصلٰى","نَارًا","حَامِيَةً "]},{"verse_key":"88:5","text":"تُسقٰى مِن عَينٍ اٰنِيَةٍؕ","words":["تُسقٰى","مِن","عَينٍ","اٰنِيَةٍؕ"]},{"verse_key":"88:6","text":"لَـيسَ لَهُم طَعَامٌ اِلَّا مِن ضَرِيعٍ","words":["لَـيسَ","لَهُم","طَعَامٌ","اِلَّا","مِن","ضَرِيعٍ"]},{"verse_key":"88:7","text":"لَّا يُسمِنُ وَلَا يُغنِى مِن جُوعٍؕ","words":["لَّا","يُسمِنُ","وَلَا","يُغنِى","مِن","جُوعٍؕ"]},{"verse_key":"88:8","text":"وُجُوهٌ يَّومَٮِٕذٍ نَّاعِمَةٌ ","words":["وُجُوهٌ","يَّومَٮِٕذٍ","نَّاعِمَةٌ "]},{"verse_key":"88:9","text":"لِّسَعيِهَا رَاضِيَةٌ ","words":["لِّسَعيِهَا","رَاضِيَةٌ "]},{"verse_key":"88:10","text":"فِى جَنَّةٍ عَالِيَةٍ","words":["فِى","جَنَّةٍ","عَالِيَةٍ"]},{"verse_key":"88:11","text":"لَّا تَسمَعُ فِيهَا لَاغِيَةً ؕ","words":["لَّا","تَسمَعُ","فِيهَا","لَاغِيَةً ؕ"]},{"verse_key":"88:12","text":"فِيهَا عَينٌ جَارِيَةٌ ","words":["فِيهَا","عَينٌ","جَارِيَةٌ "]},{"verse_key":"88:13","text":"فِيهَا سُرُرٌ مَّرفُوعَةٌ ","words":["فِيهَا","سُرُرٌ","مَّرفُوعَةٌ "]},{"verse_key":"88:14","text":"وَّاَكوَابٌ مَّوضُوعَةٌ ","words":["وَّاَكوَابٌ","مَّوضُوعَةٌ "]},{"verse_key":"88:15","text":"وَّنَمَارِقُ مَصفُوفَةٌ ","words":["وَّنَمَارِقُ","مَصفُوفَةٌ "]},{"verse_key":"88:16","text":"وَّزَرَابِىُّ مَبثُوثَةٌ ؕ","words":["وَّزَرَابِىُّ","مَبثُوثَةٌ ؕ"]},{"verse_key":"88:17","text":"اَفَلَا يَنظُرُونَ اِلَى الاِ بِلِ كَيفَ خُلِقَت","words":["اَفَلَا","يَنظُرُونَ","اِلَى","الاِ بِلِ","كَيفَ","خُلِقَت"]},{"verse_key":"88:18","text":"وَاِلَى السَّمَآءِ كَيفَ رُفِعَت","words":["وَاِلَى","السَّمَآءِ","كَيفَ","رُفِعَت"]},{"verse_key":"88:19","text":"وَاِلَى الجِبَالِ كَيفَ نُصِبَت","words":["وَاِلَى","الجِبَالِ","كَيفَ","نُصِبَت"]},{"verse_key":"88:20","text":"وَاِلَى الاَرضِ كَيفَ سُطِحَت","words":["وَاِلَى","الاَرضِ","كَيفَ","سُطِحَت"]},{"verse_key":"88:21","text":"فَذَكِّرؕ اِنَّمَا اَنتَ مُذَكِّرٌ ؕ","words":["فَذَكِّرؕ","اِنَّمَا","اَنتَ","مُذَكِّرٌ ؕ"]},{"verse_key":"88:22","text":"لَـستَ عَلَيهِم بِمُصَيطِرٍ","words":["لَـستَ","عَلَيهِم","بِمُصَيطِرٍ"]},{"verse_key":"88:23","text":"اِلَّا مَن تَوَلّٰى وَكَفَرَ","words":["اِلَّا","مَن","تَوَلّٰى","وَكَفَرَ"]},{"verse_key":"88:24","text":"فَيُعَذِّبُهُ اللّٰهُ العَذَابَ الاَكبَرَؕ","words":["فَيُعَذِّبُهُ","اللّٰهُ","العَذَابَ","الاَكبَرَؕ"]},{"verse_key":"88:25","text":"اِنَّ اِلَينَا اِيَابَهُم","words":["اِنَّ","اِلَينَا","اِيَابَهُم"]},{"verse_key":"88:26","text":"ثُمَّ اِنَّ عَلَينَا حِسَابَهُمْ","words":["ثُمَّ","اِنَّ","عَلَينَا","حِسَابَهُمْ"]}]}