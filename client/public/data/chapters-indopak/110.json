{"verses":[{"verse_key":"110:1","text":"اِذَا جَآءَ نَصرُ اللّٰهِ وَالفَتحُ","words":["اِذَا","جَآءَ","نَصرُ","اللّٰهِ","وَالفَتحُ"]},{"verse_key":"110:2","text":"وَرَاَيتَ النَّاسَ يَدخُلُونَ فِى دِينِ اللّٰهِ اَفوَاجًا ","words":["وَرَاَيتَ","النَّاسَ","يَدخُلُونَ","فِى","دِينِ","اللّٰهِ","اَفوَاجًا "]},{"verse_key":"110:3","text":"فَسَبِّح بِحَمدِ رَبِّكَ وَاستَغفِرهُ ؕ اِنَّهٗ كَانَ تَوَّابًا","words":["فَسَبِّح","بِحَمدِ","رَبِّكَ","وَاستَغفِرهُ ؕ","اِنَّهٗ","كَانَ","تَوَّابًا"]}]}