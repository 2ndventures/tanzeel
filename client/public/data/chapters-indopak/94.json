{"verses":[{"verse_key":"94:1","text":"اَلَم نَشرَح لَـكَ صَدرَكَ","words":["اَلَم","نَشرَح","لَـكَ","صَدرَكَ"]},{"verse_key":"94:2","text":"وَوَضَعنَا عَنكَ وِزرَكَ","words":["وَوَضَعنَا","عَنكَ","وِزرَكَ"]},{"verse_key":"94:3","text":"الَّذِى اَنقَضَ ظَهرَكَ","words":["الَّذِى","اَنقَضَ","ظَهرَكَ"]},{"verse_key":"94:4","text":"وَرَفَعنَا لَـكَ ذِكرَكَؕ","words":["وَرَفَعنَا","لَـكَ","ذِكرَكَؕ"]},{"verse_key":"94:5","text":"فَاِنَّ مَعَ العُسرِ يُسرًا ","words":["فَاِنَّ","مَعَ","العُسرِ","يُسرًا "]},{"verse_key":"94:6","text":"اِنَّ مَعَ العُسرِ يُسرًا ؕ","words":["اِنَّ","مَعَ","العُسرِ","يُسرًا ؕ"]},{"verse_key":"94:7","text":"فَاِذَا فَرَغتَ فَانصَب","words":["فَاِذَا","فَرَغتَ","فَانصَب"]},{"verse_key":"94:8","text":"وَاِلٰى رَبِّكَ فَارغَب","words":["وَاِلٰى","رَبِّكَ","فَارغَب"]}]}