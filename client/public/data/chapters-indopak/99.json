{"verses":[{"verse_key":"99:1","text":"اِذَا زُلزِلَتِ الاَرضُ زِلزَالَهَا ","words":["اِذَا","زُلزِلَتِ","الاَرضُ","زِلزَالَهَا "]},{"verse_key":"99:2","text":"وَاَخرَجَتِ الاَرضُ اَثقَالَهَا ","words":["وَاَخرَجَتِ","الاَرضُ","اَثقَالَهَا "]},{"verse_key":"99:3","text":"وَقَالَ الاِنسَانُ مَا لَهَا ","words":["وَقَالَ","الاِنسَانُ","مَا","لَهَا "]},{"verse_key":"99:4","text":"يَومَٮِٕذٍ تُحَدِّثُ اَخبَارَهَا ","words":["يَومَٮِٕذٍ","تُحَدِّثُ","اَخبَارَهَا "]},{"verse_key":"99:5","text":"بِاَنَّ رَبَّكَ اَوحٰى لَهَا ؕ","words":["بِاَنَّ","رَبَّكَ","اَوحٰى","لَهَا ؕ"]},{"verse_key":"99:6","text":"يَومَٮِٕذٍ يَّصدُرُ النَّاسُ اَشتَاتًا   لِّيُرَوا اَعمَالَهُمؕ ","words":["يَومَٮِٕذٍ","يَّصدُرُ","النَّاسُ","اَشتَاتًا  ","لِّيُرَوا","اَعمَالَهُمؕ "]},{"verse_key":"99:7","text":"فَمَن يَّعمَل مِثقَالَ ذَرَّةٍ خَيرًا يَّرَهٗ ؕ","words":["فَمَن","يَّعمَل","مِثقَالَ","ذَرَّةٍ","خَيرًا","يَّرَهٗ ؕ"]},{"verse_key":"99:8","text":"وَمَن يَّعمَل مِثقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ","words":["وَمَن","يَّعمَل","مِثقَالَ","ذَرَّةٍ","شَرًّا","يَّرَهٗ"]}]}