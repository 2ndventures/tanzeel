{"verses":[{"verse_key":"107:1","text":"اَرَءَيتَ الَّذِى يُكَذِّبُ بِالدِّينِؕ","words":["اَرَءَيتَ","الَّذِى","يُكَذِّبُ","بِالدِّينِؕ"]},{"verse_key":"107:2","text":"فَذٰلِكَ الَّذِى يَدُعُّ اليَتِيمَ","words":["فَذٰلِكَ","الَّذِى","يَدُعُّ","اليَتِيمَ"]},{"verse_key":"107:3","text":"وَ لَا يَحُضُّ عَلٰى طَعَامِ المِسكِينِؕ","words":["وَ","لَا","يَحُضُّ","عَلٰى","طَعَامِ المِسكِينِؕ"]},{"verse_key":"107:4","text":"فَوَيلٌ لِّلمُصَلِّينَ","words":["فَوَيلٌ","لِّلمُصَلِّينَ"]},{"verse_key":"107:5","text":"الَّذِينَ هُم عَن صَلَاتِهِم سَاهُونَ","words":["الَّذِينَ","هُم","عَن","صَلَاتِهِم","سَاهُونَ"]},{"verse_key":"107:6","text":"الَّذِينَ هُم يُرَآءُونَ","words":["الَّذِينَ","هُم","يُرَآءُونَ"]},{"verse_key":"107:7","text":"وَيَمنَعُونَ المَاعُونَ","words":["وَيَمنَعُونَ","المَاعُونَ"]}]}