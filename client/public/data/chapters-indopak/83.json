{"verses":[{"verse_key":"83:1","text":"وَيلٌ لِّلمُطَفِّفِينَ","words":["وَيلٌ","لِّلمُطَفِّفِينَ"]},{"verse_key":"83:2","text":"الَّذِينَ اِذَا اكتَالُوا عَلَى النَّاسِ يَستَوفُونَ","words":["الَّذِينَ","اِذَا","اكتَالُوا","عَلَى","النَّاسِ","يَستَوفُونَ"]},{"verse_key":"83:3","text":"وَاِذَا كَالُوهُم اَوْ وَّزَنُوهُم يُخسِرُونَؕ","words":["وَاِذَا","كَالُوهُم","اَوْ","وَّزَنُوهُم","يُخسِرُونَؕ"]},{"verse_key":"83:4","text":"اَلَا يَظُنُّ اُولٰٓٮِٕكَ اَنَّهُم مَّبعُوثُونَ","words":["اَلَا","يَظُنُّ","اُولٰٓٮِٕكَ","اَنَّهُم","مَّبعُوثُونَ"]},{"verse_key":"83:5","text":"لِيَومٍ عَظِيمٍ","words":["لِيَومٍ","عَظِيمٍ"]},{"verse_key":"83:6","text":"يَّومَ يَقُومُ النَّاسُ لِرَبِّ العٰلَمِينَؕ","words":["يَّومَ","يَقُومُ","النَّاسُ","لِرَبِّ","العٰلَمِينَؕ"]},{"verse_key":"83:7","text":"كَلَّا اِنَّ كِتٰبَ الفُجَّارِ لَفِى سِجِّينٍؕ","words":["كَلَّا","اِنَّ","كِتٰبَ","الفُجَّارِ","لَفِى","سِجِّينٍؕ"]},{"verse_key":"83:8","text":"وَمَا اَدرٰٮكَ مَا سِجِّينٌؕ","words":["وَمَا","اَدرٰٮكَ","مَا","سِجِّينٌؕ"]},{"verse_key":"83:9","text":"كِتٰبٌ مَّرقُومٌؕ","words":["كِتٰبٌ","مَّرقُومٌؕ"]},{"verse_key":"83:10","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"83:11","text":"الَّذِينَ يُكَذِّبُونَ بِيَومِ الدِّينِؕ","words":["الَّذِينَ","يُكَذِّبُونَ","بِيَومِ","الدِّينِؕ"]},{"verse_key":"83:12","text":"وَمَا يُكَذِّبُ بِهٖ اِلَّا كُلُّ مُعتَدٍ اَثِيمٍ","words":["وَمَا","يُكَذِّبُ","بِهٖ","اِلَّا","كُلُّ","مُعتَدٍ","اَثِيمٍ"]},{"verse_key":"83:13","text":"اِذَا تُتلٰى عَلَيهِ اٰيٰتُنَا قَالَ اَسَاطِيرُ الاَوَّلِينَؕ","words":["اِذَا","تُتلٰى","عَلَيهِ","اٰيٰتُنَا","قَالَ","اَسَاطِيرُ","الاَوَّلِينَؕ"]},{"verse_key":"83:14","text":"كَلَّا بَل رَانَ عَلٰى قُلُوبِهِم مَّا كَانُوا يَكسِبُونَ","words":["كَلَّا","بَل","رَانَ","عَلٰى","قُلُوبِهِم","مَّا","كَانُوا","يَكسِبُونَ"]},{"verse_key":"83:15","text":"كَلَّا اِنَّهُم عَن رَّبِّهِم يَومَٮِٕذٍ لَّمَحجُوبُونَؕ","words":["كَلَّا","اِنَّهُم","عَن","رَّبِّهِم","يَومَٮِٕذٍ","لَّمَحجُوبُونَؕ"]},{"verse_key":"83:16","text":"ثُمَّ اِنَّهُم لَصَالُوا الجَحِيمِؕ","words":["ثُمَّ","اِنَّهُم","لَصَالُوا","الجَحِيمِؕ"]},{"verse_key":"83:17","text":"ثُمَّ يُقَالُ هٰذَا الَّذِى كُنتُم بِهٖ تُكَذِّبُونَؕ","words":["ثُمَّ","يُقَالُ","هٰذَا","الَّذِى","كُنتُم","بِهٖ","تُكَذِّبُونَؕ"]},{"verse_key":"83:18","text":"كَلَّا اِنَّ كِتٰبَ الاَبرَارِ لَفِى عِلِّيِّينَؕ","words":["كَلَّا","اِنَّ","كِتٰبَ","الاَبرَارِ","لَفِى","عِلِّيِّينَؕ"]},{"verse_key":"83:19","text":"وَمَا اَدرٰٮكَ مَا عِلِّيُّونَؕ","words":["وَمَا","اَدرٰٮكَ","مَا","عِلِّيُّونَؕ"]},{"verse_key":"83:20","text":"كِتٰبٌ مَّرقُومٌ","words":["كِتٰبٌ","مَّرقُومٌ"]},{"verse_key":"83:21","text":"يَّشهَدُهُ المُقَرَّبُونَؕ","words":["يَّشهَدُهُ","المُقَرَّبُونَؕ"]},{"verse_key":"83:22","text":"اِنَّ الاَبرَارَ لَفِى نَعِيمٍ","words":["اِنَّ","الاَبرَارَ","لَفِى","نَعِيمٍ"]},{"verse_key":"83:23","text":"عَلَى الاَرَآٮِٕكِ يَنظُرُونَ","words":["عَلَى","الاَرَآٮِٕكِ","يَنظُرُونَ"]},{"verse_key":"83:24","text":"تَعرِفُ فِى وُجُوهِهِم نَضرَةَ النَّعِيمِ","words":["تَعرِفُ","فِى","وُجُوهِهِم","نَضرَةَ","النَّعِيمِ"]},{"verse_key":"83:25","text":"يُسقَونَ مِن رَّحِيقٍ مَّختُومٍ","words":["يُسقَونَ","مِن","رَّحِيقٍ","مَّختُومٍ"]},{"verse_key":"83:26","text":"خِتٰمُهٗ مِسكٌ ؕ وَفِى ذٰلِكَ فَليَتَنَافَسِ المُتَنــَافِسُونَؕ","words":["خِتٰمُهٗ","مِسكٌ ؕ","وَفِى","ذٰلِكَ","فَليَتَنَافَسِ","المُتَنــَافِسُونَؕ"]},{"verse_key":"83:27","text":"وَ مِزَاجُهٗ مِن تَسنِيمٍ","words":["وَ مِزَاجُهٗ","مِن","تَسنِيمٍ"]},{"verse_key":"83:28","text":"عَينًا يَّشرَبُ بِهَا المُقَرَّبُونَؕ","words":["عَينًا","يَّشرَبُ","بِهَا","المُقَرَّبُونَؕ"]},{"verse_key":"83:29","text":"اِنَّ الَّذِينَ اَجرَمُوا كَانُوا مِنَ الَّذِينَ اٰمَنُوا يَضحَكُونَ  ","words":["اِنَّ","الَّذِينَ","اَجرَمُوا","كَانُوا","مِنَ","الَّذِينَ","اٰمَنُوا","يَضحَكُونَ  "]},{"verse_key":"83:30","text":"وَاِذَا مَرُّوا بِهِم يَتَغَامَزُونَ  ","words":["وَاِذَا","مَرُّوا","بِهِم","يَتَغَامَزُونَ  "]},{"verse_key":"83:31","text":"وَاِذَا انقَلَبُوا اِلٰٓى اَهلِهِمُ انْقَلَبُوا فَكِهِينَ  ","words":["وَاِذَا","انقَلَبُوا","اِلٰٓى","اَهلِهِمُ","انْقَلَبُوا","فَكِهِينَ  "]},{"verse_key":"83:32","text":"وَاِذَا رَاَوهُم قَالُوا اِنَّ هٰٓؤُلَاءِ لَـضَآلُّونَ","words":["وَاِذَا","رَاَوهُم","قَالُوا","اِنَّ","هٰٓؤُلَاءِ","لَـضَآلُّونَ"]},{"verse_key":"83:33","text":"وَمَا اُرسِلُوا عَلَيهِم حٰفِظِينَ","words":["وَمَا","اُرسِلُوا","عَلَيهِم","حٰفِظِينَ"]},{"verse_key":"83:34","text":"فَاليَومَ الَّذِينَ اٰمَنُوا مِنَ الكُفَّارِ يَضحَكُونَ","words":["فَاليَومَ","الَّذِينَ","اٰمَنُوا","مِنَ","الكُفَّارِ","يَضحَكُونَ"]},{"verse_key":"83:35","text":"عَلَى الاَرَآٮِٕكِ يَنظُرُونَؕ","words":["عَلَى","الاَرَآٮِٕكِ","يَنظُرُونَؕ"]},{"verse_key":"83:36","text":"هَل ثُوِّبَ الكُفَّارُ مَا كَانُوا يَفعَلُونَ","words":["هَل","ثُوِّبَ","الكُفَّارُ","مَا","كَانُوا","يَفعَلُونَ"]}]}