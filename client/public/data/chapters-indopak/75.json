{"verses":[{"verse_key":"75:1","text":"لَا اُقسِمُ بِيَومِ القِيٰمَةِ","words":["لَا","اُقسِمُ","بِيَومِ","القِيٰمَةِ"]},{"verse_key":"75:2","text":"وَلَا اُقسِمُ بِالنَّفسِ اللَّوَّامَةِؕ","words":["وَلَا","اُقسِمُ","بِالنَّفسِ","اللَّوَّامَةِؕ"]},{"verse_key":"75:3","text":"اَيَحسَبُ الاِنسَانُ اَلَّن نَّجمَعَ عِظَامَهٗؕ","words":["اَيَحسَبُ","الاِنسَانُ","اَلَّن","نَّجمَعَ","عِظَامَهٗؕ"]},{"verse_key":"75:4","text":"بَلٰى قٰدِرِينَ عَلٰٓى اَن نُّسَوِّىَ بَنَانَهٗ","words":["بَلٰى","قٰدِرِينَ","عَلٰٓى","اَن","نُّسَوِّىَ","بَنَانَهٗ"]},{"verse_key":"75:5","text":"بَل يُرِيدُ الاِنسَانُ لِيَفجُرَ اَمَامَهٗ","words":["بَل","يُرِيدُ","الاِنسَانُ","لِيَفجُرَ","اَمَامَهٗ"]},{"verse_key":"75:6","text":"يَسـَٔـلُ اَيَّانَ يَومُ القِيٰمَةِؕ","words":["يَسـَٔـلُ","اَيَّانَ","يَومُ","القِيٰمَةِؕ"]},{"verse_key":"75:7","text":"فَاِذَا بَرِقَ البَصَرُ","words":["فَاِذَا","بَرِقَ","البَصَرُ"]},{"verse_key":"75:8","text":"وَخَسَفَ القَمَرُ","words":["وَخَسَفَ","القَمَرُ"]},{"verse_key":"75:9","text":"وَجُمِعَ الشَّمسُ وَالقَمَرُ","words":["وَجُمِعَ","الشَّمسُ","وَالقَمَرُ"]},{"verse_key":"75:10","text":"يَقُولُ الاِنسَانُ يَومَٮِٕذٍ اَينَ المَفَرُّ ","words":["يَقُولُ","الاِنسَانُ","يَومَٮِٕذٍ","اَينَ","المَفَرُّ "]},{"verse_key":"75:11","text":"كَلَّا لَا وَزَرَؕ","words":["كَلَّا","لَا","وَزَرَؕ"]},{"verse_key":"75:12","text":"اِلٰى رَبِّكَ يَومَٮِٕذِ المُستَقَرُّ ؕ","words":["اِلٰى","رَبِّكَ","يَومَٮِٕذِ","المُستَقَرُّ ؕ"]},{"verse_key":"75:13","text":"يُنَبَّؤُا الاِنسَانُ يَومَٮِٕذٍ بِمَا قَدَّمَ وَاَخَّرَؕ","words":["يُنَبَّؤُا","الاِنسَانُ","يَومَٮِٕذٍ","بِمَا","قَدَّمَ","وَاَخَّرَؕ"]},{"verse_key":"75:14","text":"بَلِ الاِنسَانُ عَلٰى نَفسِهٖ بَصِيرَةٌ ","words":["بَلِ","الاِنسَانُ","عَلٰى","نَفسِهٖ","بَصِيرَةٌ "]},{"verse_key":"75:15","text":"وَّلَو اَلقٰى مَعَاذِيرَهٗؕ","words":["وَّلَو","اَلقٰى","مَعَاذِيرَهٗؕ"]},{"verse_key":"75:16","text":"لَا تُحَرِّك بِهٖ لِسَانَكَ لِتَعجَلَ بِهٖؕ","words":["لَا","تُحَرِّك","بِهٖ","لِسَانَكَ","لِتَعجَلَ","بِهٖؕ"]},{"verse_key":"75:17","text":"اِنَّ عَلَينَا جَمعَهٗ وَقُراٰنَهٗ  ","words":["اِنَّ","عَلَينَا","جَمعَهٗ","وَقُراٰنَهٗ  "]},{"verse_key":"75:18","text":"فَاِذَا قَرَانٰهُ فَاتَّبِع قُراٰنَهٗ","words":["فَاِذَا","قَرَانٰهُ","فَاتَّبِع","قُراٰنَهٗ"]},{"verse_key":"75:19","text":"ثُمَّ اِنَّ عَلَينَا بَيَانَهٗؕ","words":["ثُمَّ","اِنَّ","عَلَينَا","بَيَانَهٗؕ"]},{"verse_key":"75:20","text":"كَلَّا بَل تُحِبُّونَ العَاجِلَةَ ","words":["كَلَّا","بَل","تُحِبُّونَ","العَاجِلَةَ "]},{"verse_key":"75:21","text":"وَتَذَرُونَ الاٰخِرَةَ ؕ","words":["وَتَذَرُونَ","الاٰخِرَةَ ؕ"]},{"verse_key":"75:22","text":"وُجُوهٌ يَّومَٮِٕذٍ نَّاضِرَةٌ ","words":["وُجُوهٌ","يَّومَٮِٕذٍ","نَّاضِرَةٌ "]},{"verse_key":"75:23","text":"اِلٰى رَبِّهَا نَاظِرَةٌ ","words":["اِلٰى","رَبِّهَا","نَاظِرَةٌ "]},{"verse_key":"75:24","text":"وَوُجُوهٌ يَّومَٮِٕذٍ بَاسِرَةٌ ","words":["وَوُجُوهٌ","يَّومَٮِٕذٍ","بَاسِرَةٌ "]},{"verse_key":"75:25","text":"تَظُنُّ اَن يُّفعَلَ بِهَا فَاقِرَةٌ ؕ","words":["تَظُنُّ","اَن","يُّفعَلَ","بِهَا","فَاقِرَةٌ ؕ"]},{"verse_key":"75:26","text":"كَلَّا اِذَا بَلَغَتِ التَّرَاقِىَ","words":["كَلَّا","اِذَا","بَلَغَتِ","التَّرَاقِىَ"]},{"verse_key":"75:27","text":"وَقِيلَ مَن رَاقٍ","words":["وَقِيلَ","مَن","رَاقٍ"]},{"verse_key":"75:28","text":"وَّظَنَّ اَنَّهُ الفِرَاقُ","words":["وَّظَنَّ","اَنَّهُ","الفِرَاقُ"]},{"verse_key":"75:29","text":"وَالتَفَّتِ السَّاقُ بِالسَّاقِ","words":["وَالتَفَّتِ","السَّاقُ","بِالسَّاقِ"]},{"verse_key":"75:30","text":"اِلٰى رَبِّكَ يَومَٮِٕذِ المَسَاقُؕ","words":["اِلٰى","رَبِّكَ","يَومَٮِٕذِ","المَسَاقُؕ"]},{"verse_key":"75:31","text":"فَلَا صَدَّقَ وَلَا صَلّٰى","words":["فَلَا","صَدَّقَ","وَلَا","صَلّٰى"]},{"verse_key":"75:32","text":"وَلٰڪِن كَذَّبَ وَتَوَلّٰى","words":["وَلٰڪِن","كَذَّبَ","وَتَوَلّٰى"]},{"verse_key":"75:33","text":"ثُمَّ ذَهَبَ اِلٰٓى اَهلِهٖ يَتَمَطّٰىؕ","words":["ثُمَّ","ذَهَبَ","اِلٰٓى","اَهلِهٖ","يَتَمَطّٰىؕ"]},{"verse_key":"75:34","text":"اَولٰى لَكَ فَاَولٰى","words":["اَولٰى","لَكَ","فَاَولٰى"]},{"verse_key":"75:35","text":"ثُمَّ اَولٰى لَكَ فَاَولٰىؕ","words":["ثُمَّ","اَولٰى","لَكَ","فَاَولٰىؕ"]},{"verse_key":"75:36","text":"اَيَحسَبُ الاِنسَانُ اَن يُّترَكَ سُدًىؕ","words":["اَيَحسَبُ","الاِنسَانُ","اَن","يُّترَكَ","سُدًىؕ"]},{"verse_key":"75:37","text":"اَلَم يَكُ نُطفَةً مِّن مَّنِىٍّ يُّمنٰى","words":["اَلَم","يَكُ","نُطفَةً","مِّن","مَّنِىٍّ","يُّمنٰى"]},{"verse_key":"75:38","text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰى","words":["ثُمَّ","كَانَ","عَلَقَةً","فَخَلَقَ","فَسَوّٰى"]},{"verse_key":"75:39","text":"فَجَعَلَ مِنهُ الزَّوجَينِ الذَّكَرَ وَالاُنثٰىؕ","words":["فَجَعَلَ","مِنهُ","الزَّوجَينِ","الذَّكَرَ","وَالاُنثٰىؕ"]},{"verse_key":"75:40","text":"اَلَيسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓى اَن يُّحـىَِ المَوتٰى","words":["اَلَيسَ","ذٰلِكَ","بِقٰدِرٍ","عَلٰٓى","اَن","يُّحـىَِ","المَوتٰى"]}]}