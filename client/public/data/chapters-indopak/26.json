{"verses":[{"verse_key":"26:1","text":"طٰسٓمّٓ","words":["طٰسٓمّٓ"]},{"verse_key":"26:2","text":"تِلكَ اٰيٰتُ الكِتٰبِ المُبِينِ","words":["تِلكَ","اٰيٰتُ","الكِتٰبِ","المُبِينِ"]},{"verse_key":"26:3","text":"لَعَلَّكَ بَاخِعٌ نَّـفسَكَ اَلَّا يَكُونُوا مُؤمِنِينَ","words":["لَعَلَّكَ","بَاخِعٌ","نَّـفسَكَ","اَلَّا","يَكُونُوا","مُؤمِنِينَ"]},{"verse_key":"26:4","text":"اِن نَّشَا نُنَزِّل عَلَيهِم مِّنَ السَّمَآءِ اٰيَةً فَظَلَّت اَعنَاقُهُم لَهَا خٰضِعِينَ","words":["اِن","نَّشَا","نُنَزِّل","عَلَيهِم","مِّنَ","السَّمَآءِ","اٰيَةً","فَظَلَّت","اَعنَاقُهُم","لَهَا","خٰضِعِينَ"]},{"verse_key":"26:5","text":"وَمَا يَاتِيهِم مِّن ذِكرٍ مِّنَ الرَّحمٰنِ مُحدَثٍ اِلَّا كَانُوا عَنهُ مُعرِضِينَ","words":["وَمَا","يَاتِيهِم","مِّن","ذِكرٍ","مِّنَ","الرَّحمٰنِ","مُحدَثٍ","اِلَّا","كَانُوا","عَنهُ","مُعرِضِينَ"]},{"verse_key":"26:6","text":"فَقَد كَذَّبُوا فَسَيَاتِيهِم اَنـبٰٓــؤُا مَا كَانُوا بِهٖ يَستَهزِءُونَ ","words":["فَقَد","كَذَّبُوا","فَسَيَاتِيهِم","اَنـبٰٓــؤُا","مَا","كَانُوا","بِهٖ","يَستَهزِءُونَ "]},{"verse_key":"26:7","text":"اَوَلَم يَرَوا اِلَى الاَرضِ كَم اَنبَتنَا فِيهَا مِن كُلِّ زَوجٍ كَرِيمٍ","words":["اَوَلَم","يَرَوا","اِلَى","الاَرضِ","كَم","اَنبَتنَا","فِيهَا","مِن","كُلِّ","زَوجٍ","كَرِيمٍ"]},{"verse_key":"26:8","text":"اِنَّ فِى ذٰ لِكَ لَاٰيَةً  ؕ وَّمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاٰيَةً  ؕ","وَّمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:9","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:10","text":"وَاِذ نَادٰى رَبُّكَ مُوسٰى اَنِ ائتِ القَومَ الظّٰلِمِينَ","words":["وَاِذ","نَادٰى","رَبُّكَ","مُوسٰى","اَنِ","ائتِ","القَومَ","الظّٰلِمِينَ"]},{"verse_key":"26:11","text":"قَومَ فِرعَونَؕ اَلَا يَتَّقُونَ","words":["قَومَ","فِرعَونَؕ","اَلَا","يَتَّقُونَ"]},{"verse_key":"26:12","text":"قَالَ رَبِّ اِنِّى اَخَافُ اَن يُّكَذِّبُونِؕ","words":["قَالَ","رَبِّ","اِنِّى","اَخَافُ","اَن","يُّكَذِّبُونِؕ"]},{"verse_key":"26:13","text":"وَيَضِيقُ صَدرِى وَلَا يَنطَلِقُ لِسَانِى فَاَرسِل اِلٰى هٰرُونَ ","words":["وَيَضِيقُ","صَدرِى","وَلَا","يَنطَلِقُ","لِسَانِى","فَاَرسِل","اِلٰى","هٰرُونَ "]},{"verse_key":"26:14","text":"وَلَهُم عَلَىَّ ذَنبٌ فَاَخَافُ اَن يَّقتُلُونِ","words":["وَلَهُم","عَلَىَّ","ذَنبٌ","فَاَخَافُ","اَن","يَّقتُلُونِ"]},{"verse_key":"26:15","text":"قَالَ كَلَّا  فَاذهَبَا بِاٰيٰتِنَآ اِنَّا مَعَكُم مُّستَمِعُونَ ","words":["قَالَ","كَلَّا ","فَاذهَبَا","بِاٰيٰتِنَآ","اِنَّا","مَعَكُم","مُّستَمِعُونَ "]},{"verse_key":"26:16","text":"فَاتِيَا فِرعَونَ فَقُولَا اِنَّا رَسُولُ رَبِّ العٰلَمِينَ","words":["فَاتِيَا","فِرعَونَ","فَقُولَا","اِنَّا","رَسُولُ","رَبِّ","العٰلَمِينَ"]},{"verse_key":"26:17","text":"اَن اَرسِل مَعَنَا بَنِى اِسرَآءِيلَ ؕ","words":["اَن","اَرسِل","مَعَنَا","بَنِى","اِسرَآءِيلَ ؕ"]},{"verse_key":"26:18","text":"قَالَ اَلَم نُرَبِّكَ فِينَا وَلِيدًا وَّلَبِثتَ فِينَا مِن عُمُرِكَ سِنِينَ","words":["قَالَ","اَلَم","نُرَبِّكَ","فِينَا","وَلِيدًا","وَّلَبِثتَ","فِينَا","مِن","عُمُرِكَ","سِنِينَ"]},{"verse_key":"26:19","text":"وَفَعَلتَ فَعلَتَكَ الَّتِى فَعَلتَ وَاَنتَ مِنَ الكٰفِرِينَ","words":["وَفَعَلتَ","فَعلَتَكَ","الَّتِى","فَعَلتَ","وَاَنتَ","مِنَ","الكٰفِرِينَ"]},{"verse_key":"26:20","text":"قَالَ فَعَلتُهَا اِذًا وَّاَنَا مِنَ الضَّآلِّينَؕ","words":["قَالَ","فَعَلتُهَا","اِذًا","وَّاَنَا","مِنَ","الضَّآلِّينَؕ"]},{"verse_key":"26:21","text":"فَفَرَرتُ مِنكُم لَمَّا خِفتُكُم فَوَهَبَ لِى رَبِّى حُكمًا وَّجَعَلَنِى مِنَ المُرسَلِينَ","words":["فَفَرَرتُ","مِنكُم","لَمَّا","خِفتُكُم","فَوَهَبَ","لِى","رَبِّى","حُكمًا","وَّجَعَلَنِى","مِنَ","المُرسَلِينَ"]},{"verse_key":"26:22","text":"وَتِلكَ نِعمَةٌ تَمُنُّهَا عَلَىَّ اَن عَبَّدْتَّ بَنِى اِسرَآءِيلَ ؕ","words":["وَتِلكَ","نِعمَةٌ","تَمُنُّهَا","عَلَىَّ","اَن","عَبَّدْتَّ","بَنِى","اِسرَآءِيلَ ؕ"]},{"verse_key":"26:23","text":"قَالَ فِرعَونُ وَمَا رَبُّ العٰلَمِينَؕ","words":["قَالَ","فِرعَونُ","وَمَا","رَبُّ","العٰلَمِينَؕ"]},{"verse_key":"26:24","text":"قَالَ رَبُّ السَّمٰوٰتِ وَالاَرضِ وَمَا بَينَهُمَاؕ اِن كُنتُم مُّوقِنِينَ ","words":["قَالَ","رَبُّ","السَّمٰوٰتِ","وَالاَرضِ","وَمَا","بَينَهُمَاؕ","اِن","كُنتُم","مُّوقِنِينَ "]},{"verse_key":"26:25","text":"قَالَ لِمَن حَولَهٗ اَلَا تَستَمِعُونَ","words":["قَالَ","لِمَن","حَولَهٗ","اَلَا","تَستَمِعُونَ"]},{"verse_key":"26:26","text":"قَالَ رَبُّكُم وَرَبُّ اٰبَآٮِٕكُمُ الاَوَّلِينَ","words":["قَالَ","رَبُّكُم","وَرَبُّ","اٰبَآٮِٕكُمُ","الاَوَّلِينَ"]},{"verse_key":"26:27","text":"قَالَ اِنَّ رَسُولَـكُمُ الَّذِى اُرسِلَ اِلَيكُم لَمَجنُونٌ","words":["قَالَ","اِنَّ","رَسُولَـكُمُ","الَّذِى","اُرسِلَ","اِلَيكُم","لَمَجنُونٌ"]},{"verse_key":"26:28","text":"قَالَ رَبُّ المَشرِقِ وَالمَغرِبِ وَمَا بَينَهُمَا ؕ اِن كُنتُم تَعقِلُونَ ","words":["قَالَ","رَبُّ","المَشرِقِ","وَالمَغرِبِ","وَمَا","بَينَهُمَا ؕ","اِن","كُنتُم","تَعقِلُونَ "]},{"verse_key":"26:29","text":"قَالَ لَٮِٕنِ اتَّخَذتَ اِلٰهًا غَيرِى لَاَجعَلَـنَّكَ مِنَ المَسجُونِينَ ","words":["قَالَ","لَٮِٕنِ","اتَّخَذتَ","اِلٰهًا","غَيرِى","لَاَجعَلَـنَّكَ","مِنَ","المَسجُونِينَ "]},{"verse_key":"26:30","text":"قَالَ اَوَلَو جِئتُكَ بِشَىءٍ مُّبِينٍ","words":["قَالَ","اَوَلَو","جِئتُكَ","بِشَىءٍ","مُّبِينٍ"]},{"verse_key":"26:31","text":"قَالَ فَاتِ بِهٖ اِن كُنتَ مِنَ الصّٰدِقِينَ","words":["قَالَ","فَاتِ","بِهٖ","اِن","كُنتَ","مِنَ","الصّٰدِقِينَ"]},{"verse_key":"26:32","text":"فَاَ لقٰى عَصَاهُ فَاِذَا هِىَ ثُعبَانٌ مُّبِينٌ  ","words":["فَاَ لقٰى","عَصَاهُ","فَاِذَا","هِىَ","ثُعبَانٌ","مُّبِينٌ  "]},{"verse_key":"26:33","text":"وَّنَزَعَ يَدَهٗ فَاِذَا هِىَ بَيضَآءُ لِلنّٰظِرِينَ","words":["وَّنَزَعَ","يَدَهٗ","فَاِذَا","هِىَ","بَيضَآءُ","لِلنّٰظِرِينَ"]},{"verse_key":"26:34","text":"قَالَ لِلمَلَاِ حَولَهٗ اِنَّ هٰذَا لَسٰحِرٌ عَلِيمٌ","words":["قَالَ","لِلمَلَاِ","حَولَهٗ","اِنَّ","هٰذَا","لَسٰحِرٌ","عَلِيمٌ"]},{"verse_key":"26:35","text":"يُّرِيدُ اَن يُّخرِجَكُم مِّن اَرضِكُم بِسِحرِهٖ   فَمَاذَا تَامُرُونَ ","words":["يُّرِيدُ","اَن","يُّخرِجَكُم","مِّن","اَرضِكُم","بِسِحرِهٖ  ","فَمَاذَا","تَامُرُونَ "]},{"verse_key":"26:36","text":"قَالُوا اَرجِه وَاَخَاهُ وَابعَث فِى المَدَآٮِٕنِ حٰشِرِينَ","words":["قَالُوا","اَرجِه","وَاَخَاهُ","وَابعَث","فِى","المَدَآٮِٕنِ","حٰشِرِينَ"]},{"verse_key":"26:37","text":"يَاتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ","words":["يَاتُوكَ","بِكُلِّ","سَحَّارٍ","عَلِيمٍ"]},{"verse_key":"26:38","text":"فَجُمِعَ السَّحَرَةُ لِمِيقَاتِ يَومٍ مَّعلُومٍ","words":["فَجُمِعَ","السَّحَرَةُ","لِمِيقَاتِ","يَومٍ","مَّعلُومٍ"]},{"verse_key":"26:39","text":"وَّقِيلَ لِلنَّاسِ هَل اَنـتُم مُّجتَمِعُونَ","words":["وَّقِيلَ","لِلنَّاسِ","هَل","اَنـتُم","مُّجتَمِعُونَ"]},{"verse_key":"26:40","text":"لَعَلَّنَا نَـتَّبِعُ السَّحَرَةَ اِن كَانُوا هُمُ الغٰلِبِينَ","words":["لَعَلَّنَا","نَـتَّبِعُ","السَّحَرَةَ","اِن","كَانُوا","هُمُ","الغٰلِبِينَ"]},{"verse_key":"26:41","text":"فَلَمَّا جَآءَ السَّحَرَةُ قَالُوا لِفِرعَونَ اَٮِٕنَّ لَـنَا لَاَجرًا اِن كُنَّا نَحنُ الغٰلِبِينَ","words":["فَلَمَّا","جَآءَ","السَّحَرَةُ","قَالُوا","لِفِرعَونَ","اَٮِٕنَّ","لَـنَا","لَاَجرًا","اِن","كُنَّا","نَحنُ","الغٰلِبِينَ"]},{"verse_key":"26:42","text":"قَالَ نَعَم وَاِنَّكُم اِذًا لَّمِنَ المُقَرَّبِينَ","words":["قَالَ","نَعَم","وَاِنَّكُم","اِذًا","لَّمِنَ","المُقَرَّبِينَ"]},{"verse_key":"26:43","text":"قَالَ لَهُم مُّوسٰى اَلقُوا مَا اَنتُم مُّلقُونَ","words":["قَالَ","لَهُم","مُّوسٰى","اَلقُوا","مَا","اَنتُم","مُّلقُونَ"]},{"verse_key":"26:44","text":"فَاَلقَوا حِبَالَهُم وَعِصِيَّهُم وَقَالُوا بِعِزَّةِ فِرعَونَ اِنَّا لَـنَحنُ الغٰلِبُونَ","words":["فَاَلقَوا","حِبَالَهُم","وَعِصِيَّهُم","وَقَالُوا","بِعِزَّةِ","فِرعَونَ","اِنَّا","لَـنَحنُ","الغٰلِبُونَ"]},{"verse_key":"26:45","text":"فَاَ لقٰى مُوسٰى عَصَاهُ فَاِذَا هِىَ تَلقَفُ مَا يَافِكُونَ  ","words":["فَاَ لقٰى","مُوسٰى","عَصَاهُ","فَاِذَا","هِىَ","تَلقَفُ","مَا","يَافِكُونَ  "]},{"verse_key":"26:46","text":"فَاُلقِىَ السَّحَرَةُ سٰجِدِينَ","words":["فَاُلقِىَ","السَّحَرَةُ","سٰجِدِينَ"]},{"verse_key":"26:47","text":"قَالُوا اٰمَنَّا بِرَبِّ العٰلَمِينَ","words":["قَالُوا","اٰمَنَّا","بِرَبِّ","العٰلَمِينَ"]},{"verse_key":"26:48","text":"رَبِّ مُوسٰى وَهٰرُونَ","words":["رَبِّ","مُوسٰى","وَهٰرُونَ"]},{"verse_key":"26:49","text":"قَالَ اٰمَنتُم لَهٗ قَبلَ اَن اٰذَنَ لَـكُم اِنَّهٗ لَـكَبِيرُكُمُ الَّذِى عَلَّمَكُمُ السِّحرَ فَلَسَوفَ تَعلَمُونَ  لَاُقَطِّعَنَّ اَيدِيَكُم وَاَرجُلَـكُم مِّن خِلَافٍ وَّلَاُصَلِّبَنَّكُم اَجمَعِينَ","words":["قَالَ","اٰمَنتُم","لَهٗ","قَبلَ","اَن","اٰذَنَ","لَـكُم","اِنَّهٗ","لَـكَبِيرُكُمُ","الَّذِى","عَلَّمَكُمُ","السِّحرَ","فَلَسَوفَ","تَعلَمُونَ ","لَاُقَطِّعَنَّ","اَيدِيَكُم","وَاَرجُلَـكُم","مِّن","خِلَافٍ","وَّلَاُصَلِّبَنَّكُم","اَجمَعِينَ"]},{"verse_key":"26:50","text":"قَالُوا لَا ضَيرَ اِنَّا اِلٰى رَبِّنَا مُنقَلِبُونَ","words":["قَالُوا","لَا","ضَيرَ","اِنَّا","اِلٰى","رَبِّنَا","مُنقَلِبُونَ"]},{"verse_key":"26:51","text":"اِنَّا نَطمَعُ اَن يَّغفِرَ لَـنَا رَبُّنَا خَطٰيٰـنَا اَن كُنَّا اَوَّلَ المُؤمِنِينَؕ","words":["اِنَّا","نَطمَعُ","اَن","يَّغفِرَ","لَـنَا","رَبُّنَا","خَطٰيٰـنَا","اَن","كُنَّا","اَوَّلَ","المُؤمِنِينَؕ"]},{"verse_key":"26:52","text":" وَاَوحَينَا اِلٰى مُوسٰٓى اَن اَسرِ بِعِبَادِى اِنَّكُم مُّتَّبَعُونَ ","words":[" وَاَوحَينَا","اِلٰى","مُوسٰٓى","اَن","اَسرِ","بِعِبَادِى","اِنَّكُم","مُّتَّبَعُونَ "]},{"verse_key":"26:53","text":"فَاَرسَلَ فِرعَونُ فِى المَدَآٮِٕنِ حٰشِرِينَ","words":["فَاَرسَلَ","فِرعَونُ","فِى","المَدَآٮِٕنِ","حٰشِرِينَ"]},{"verse_key":"26:54","text":"اِنَّ هٰٓؤُلَاءِ لَشِرذِمَةٌ قَلِيلُونَ","words":["اِنَّ","هٰٓؤُلَاءِ","لَشِرذِمَةٌ","قَلِيلُونَ"]},{"verse_key":"26:55","text":"وَاِنَّهُم لَـنَا لَـغَآٮِٕظُونَ","words":["وَاِنَّهُم","لَـنَا","لَـغَآٮِٕظُونَ"]},{"verse_key":"26:56","text":"وَاِنَّا لَجَمِيعٌ حٰذِرُونَؕ","words":["وَاِنَّا","لَجَمِيعٌ","حٰذِرُونَؕ"]},{"verse_key":"26:57","text":"فَاَخرَجنٰهُم مِّن جَنّٰتٍ وَّعُيُونٍ","words":["فَاَخرَجنٰهُم","مِّن","جَنّٰتٍ","وَّعُيُونٍ"]},{"verse_key":"26:58","text":"وَّكُنُوزٍ وَّمَقَامٍ كَرِيمٍ","words":["وَّكُنُوزٍ","وَّمَقَامٍ","كَرِيمٍ"]},{"verse_key":"26:59","text":"كَذٰلِكَؕ وَاَورَثنٰهَا بَنِى اِسرَآءِيلَؕ","words":["كَذٰلِكَؕ","وَاَورَثنٰهَا","بَنِى","اِسرَآءِيلَؕ"]},{"verse_key":"26:60","text":"فَاَ تبَعُوهُم مُّشرِقِينَ","words":["فَاَ تبَعُوهُم","مُّشرِقِينَ"]},{"verse_key":"26:61","text":"فَلَمَّا تَرَآءَ الجَمعٰنِ قَالَ اَصحٰبُ مُوسٰٓى اِنَّا لَمُدرَكُونَ ","words":["فَلَمَّا","تَرَآءَ","الجَمعٰنِ","قَالَ","اَصحٰبُ","مُوسٰٓى","اِنَّا","لَمُدرَكُونَ "]},{"verse_key":"26:62","text":"قَالَ كَلَّا  اِنَّ مَعِىَ رَبِّى سَيَهدِينِ","words":["قَالَ","كَلَّا ","اِنَّ","مَعِىَ","رَبِّى","سَيَهدِينِ"]},{"verse_key":"26:63","text":"فَاَوحَينَا اِلٰى مُوسٰٓى اَنِ اضرِبْ بِّعَصَاكَ البَحرَؕ فَانْفَلَقَ فَكَانَ كُلُّ فِرقٍ كَالطَّودِ العَظِيمِ","words":["فَاَوحَينَا","اِلٰى","مُوسٰٓى","اَنِ","اضرِبْ","بِّعَصَاكَ","البَحرَؕ","فَانْفَلَقَ","فَكَانَ","كُلُّ","فِرقٍ","كَالطَّودِ","العَظِيمِ"]},{"verse_key":"26:64","text":"وَاَزلَـفنَا ثَمَّ الاٰخَرِينَ","words":["وَاَزلَـفنَا","ثَمَّ","الاٰخَرِينَ"]},{"verse_key":"26:65","text":"وَاَنجَينَا مُوسٰى وَمَن مَّعَهٗ اَجمَعِينَ","words":["وَاَنجَينَا","مُوسٰى","وَمَن","مَّعَهٗ","اَجمَعِينَ"]},{"verse_key":"26:66","text":"ثُمَّ اَغرَقنَا الاٰخَرِينَؕ","words":["ثُمَّ","اَغرَقنَا","الاٰخَرِينَؕ"]},{"verse_key":"26:67","text":"اِنَّ فِى ذٰ لِكَ لَاَيَةً  ؕ وَمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاَيَةً  ؕ","وَمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:68","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:69","text":"وَاتلُ عَلَيهِم نَبَاَ اِبرٰهِيمَ","words":["وَاتلُ","عَلَيهِم","نَبَاَ","اِبرٰهِيمَ"]},{"verse_key":"26:70","text":"اِذ قَالَ لِاَبِيهِ وَقَومِهٖ مَا تَعبُدُونَ","words":["اِذ","قَالَ","لِاَبِيهِ","وَقَومِهٖ","مَا","تَعبُدُونَ"]},{"verse_key":"26:71","text":"قَالُوا نَـعبُدُ اَصنَامًا فَنَظَلُّ لَهَا عٰكِفِينَ","words":["قَالُوا","نَـعبُدُ","اَصنَامًا","فَنَظَلُّ","لَهَا","عٰكِفِينَ"]},{"verse_key":"26:72","text":"قَالَ هَل يَسمَعُونَكُم اِذ تَدعُونَ","words":["قَالَ","هَل","يَسمَعُونَكُم","اِذ","تَدعُونَ"]},{"verse_key":"26:73","text":"اَو يَنفَعُونَكُم اَو يَضُرُّونَ","words":["اَو","يَنفَعُونَكُم","اَو","يَضُرُّونَ"]},{"verse_key":"26:74","text":"قَالُوا بَل وَجَدنَا اٰبَآءَنَا كَذٰلِكَ يَفعَلُونَ","words":["قَالُوا","بَل","وَجَدنَا","اٰبَآءَنَا","كَذٰلِكَ","يَفعَلُونَ"]},{"verse_key":"26:75","text":"قَالَ اَفَرَءَيتُم مَّا كُنتُم تَعبُدُونَ","words":["قَالَ","اَفَرَءَيتُم","مَّا","كُنتُم","تَعبُدُونَ"]},{"verse_key":"26:76","text":"اَنـتُم وَاٰبَآؤُكُمُ الاَقدَمُونَ  ","words":["اَنـتُم","وَاٰبَآؤُكُمُ","الاَقدَمُونَ  "]},{"verse_key":"26:77","text":"فَاِنَّهُم عَدُوٌّ لِّى اِلَّا رَبَّ العٰلَمِينَ","words":["فَاِنَّهُم","عَدُوٌّ","لِّى","اِلَّا","رَبَّ","العٰلَمِينَ"]},{"verse_key":"26:78","text":"الَّذِى خَلَقَنِى فَهُوَ يَهدِينِ","words":["الَّذِى","خَلَقَنِى","فَهُوَ","يَهدِينِ"]},{"verse_key":"26:79","text":"وَ الَّذِى هُوَ يُطعِمُنِى وَيَسقِينِ","words":["وَ الَّذِى","هُوَ","يُطعِمُنِى","وَيَسقِينِ"]},{"verse_key":"26:80","text":"وَاِذَا مَرِضتُ فَهُوَ يَشفِينِ ","words":["وَاِذَا","مَرِضتُ","فَهُوَ","يَشفِينِ "]},{"verse_key":"26:81","text":"وَالَّذِى يُمِيتُنِى ثُمَّ يُحيِينِ","words":["وَالَّذِى","يُمِيتُنِى","ثُمَّ","يُحيِينِ"]},{"verse_key":"26:82","text":"وَالَّذِى اَطمَعُ اَن يَّغفِرَ لِى خَطِٓیْــَٔـتِى يَومَ الدِّينِ ؕ","words":["وَالَّذِى","اَطمَعُ","اَن","يَّغفِرَ","لِى","خَطِٓیْــَٔـتِى","يَومَ","الدِّينِ ؕ"]},{"verse_key":"26:83","text":"رَبِّ هَب لِى حُكمًا وَّاَلحِقنِى بِالصّٰلِحِينَ","words":["رَبِّ","هَب","لِى","حُكمًا","وَّاَلحِقنِى","بِالصّٰلِحِينَ"]},{"verse_key":"26:84","text":"وَاجعَلْ لِّى لِسَانَ صِدقٍ فِى الاٰخِرِينَ","words":["وَاجعَلْ","لِّى","لِسَانَ","صِدقٍ","فِى","الاٰخِرِينَ"]},{"verse_key":"26:85","text":"وَاجعَلنِى مِن وَّرَثَةِ جَنَّةِ النَّعِيمِ","words":["وَاجعَلنِى","مِن","وَّرَثَةِ","جَنَّةِ","النَّعِيمِ"]},{"verse_key":"26:86","text":"وَاغفِر لِاَبِى اِنَّهٗ كَانَ مِنَ الضَّآلِّينَ","words":["وَاغفِر","لِاَبِى","اِنَّهٗ","كَانَ","مِنَ","الضَّآلِّينَ"]},{"verse_key":"26:87","text":"وَلَا تُخزِنِى يَومَ يُبعَثُونَ","words":["وَلَا","تُخزِنِى","يَومَ","يُبعَثُونَ"]},{"verse_key":"26:88","text":"يَومَ لَا يَنفَعُ مَالٌ وَّلَا بَنُونَ","words":["يَومَ","لَا","يَنفَعُ","مَالٌ","وَّلَا","بَنُونَ"]},{"verse_key":"26:89","text":"اِلَّا مَن اَتَى اللّٰهَ بِقَلبٍ سَلِيمٍؕ","words":["اِلَّا","مَن","اَتَى","اللّٰهَ","بِقَلبٍ","سَلِيمٍؕ"]},{"verse_key":"26:90","text":"وَاُزلِفَتِ الجَـنَّةُ لِلمُتَّقِينَ","words":["وَاُزلِفَتِ","الجَـنَّةُ","لِلمُتَّقِينَ"]},{"verse_key":"26:91","text":"وَبُرِّزَتِ الجَحِيمُ لِلغٰوِينَ","words":["وَبُرِّزَتِ","الجَحِيمُ","لِلغٰوِينَ"]},{"verse_key":"26:92","text":"وَقِيلَ لَهُم اَينَ مَا كُنتُم تَعبُدُونَ","words":["وَقِيلَ","لَهُم","اَينَ","مَا","كُنتُم","تَعبُدُونَ"]},{"verse_key":"26:93","text":"مِن دُونِ اللّٰهِؕ هَل يَنصُرُونَكُم اَو يَنتَصِرُونَؕ","words":["مِن","دُونِ","اللّٰهِؕ","هَل","يَنصُرُونَكُم","اَو","يَنتَصِرُونَؕ"]},{"verse_key":"26:94","text":"فَكُبكِبُوا فِيهَا هُم وَالغَاوٗنَ","words":["فَكُبكِبُوا","فِيهَا","هُم","وَالغَاوٗنَ"]},{"verse_key":"26:95","text":"وَجُنُودُ اِبلِيسَ اَجمَعُونَؕ","words":["وَجُنُودُ","اِبلِيسَ","اَجمَعُونَؕ"]},{"verse_key":"26:96","text":"قَالُوا وَهُم فِيهَا يَختَصِمُونَ","words":["قَالُوا","وَهُم","فِيهَا","يَختَصِمُونَ"]},{"verse_key":"26:97","text":"تَاللّٰهِ اِن كُنَّا لَفِى ضَلٰلٍ مُّبِينٍ","words":["تَاللّٰهِ","اِن","كُنَّا","لَفِى","ضَلٰلٍ","مُّبِينٍ"]},{"verse_key":"26:98","text":"اِذ نُسَوِّيكُم بِرَبِّ العٰلَمِينَ","words":["اِذ","نُسَوِّيكُم","بِرَبِّ","العٰلَمِينَ"]},{"verse_key":"26:99","text":"وَمَا اَضَلَّنَا اِلَّا المُجرِمُونَ","words":["وَمَا","اَضَلَّنَا","اِلَّا","المُجرِمُونَ"]},{"verse_key":"26:100","text":"فَمَا لَـنَا مِن شٰفِعِينَ","words":["فَمَا","لَـنَا","مِن","شٰفِعِينَ"]},{"verse_key":"26:101","text":"وَلَا صَدِيقٍ حَمِيمٍ","words":["وَلَا","صَدِيقٍ","حَمِيمٍ"]},{"verse_key":"26:102","text":"فَلَو اَنَّ لَـنَا كَرَّةً فَنَكُونَ مِنَ المُؤمِنِينَ","words":["فَلَو","اَنَّ","لَـنَا","كَرَّةً","فَنَكُونَ","مِنَ","المُؤمِنِينَ"]},{"verse_key":"26:103","text":"اِنَّ فِى ذٰ لِكَ لَاٰيَةً  ؕ وَّمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاٰيَةً  ؕ","وَّمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:104","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:105","text":"كَذَّبَت قَومُ نُوحِ المُرسَلِينَ ","words":["كَذَّبَت","قَومُ","نُوحِ","المُرسَلِينَ "]},{"verse_key":"26:106","text":"اِذ قَالَ لَهُم اَخُوهُم نُوحٌ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لَهُم","اَخُوهُم","نُوحٌ","اَلَا","تَتَّقُونَ"]},{"verse_key":"26:107","text":"اِنِّى لَـكُم رَسُولٌ اَمِينٌ","words":["اِنِّى","لَـكُم","رَسُولٌ","اَمِينٌ"]},{"verse_key":"26:108","text":"فَاتَّقُوا اللّٰهَ وَ اَطِيعُونِ","words":["فَاتَّقُوا","اللّٰهَ","وَ اَطِيعُونِ"]},{"verse_key":"26:109","text":"وَمَا اَســـَٔلُكُم عَلَيهِ مِن اَجرٍ اِن اَجرِىَ اِلَّا عَلٰى رَبِّ العٰلَمِينَ","words":["وَمَا","اَســـَٔلُكُم","عَلَيهِ","مِن","اَجرٍ","اِن","اَجرِىَ","اِلَّا","عَلٰى","رَبِّ","العٰلَمِينَ"]},{"verse_key":"26:110","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ ؕ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ ؕ"]},{"verse_key":"26:111","text":" قَالُوا اَنُؤمِنُ لَكَ وَاتَّبَعَكَ الاَرذَلُونَؕ","words":[" قَالُوا","اَنُؤمِنُ","لَكَ","وَاتَّبَعَكَ","الاَرذَلُونَؕ"]},{"verse_key":"26:112","text":"قَالَ وَمَا عِلمِى بِمَا كَانُوا يَعمَلُونَ","words":["قَالَ","وَمَا","عِلمِى","بِمَا","كَانُوا","يَعمَلُونَ"]},{"verse_key":"26:113","text":"اِن حِسَابُهُم اِلَّا عَلٰى رَبِّى لَو تَشعُرُونَ","words":["اِن","حِسَابُهُم","اِلَّا","عَلٰى","رَبِّى","لَو","تَشعُرُونَ"]},{"verse_key":"26:114","text":"وَمَا اَنَا بِطَارِدِ المُؤمِنِينَ","words":["وَمَا","اَنَا","بِطَارِدِ","المُؤمِنِينَ"]},{"verse_key":"26:115","text":"اِن اَنَا اِلَّا نَذِيرٌ مُّبِينٌؕ","words":["اِن","اَنَا","اِلَّا","نَذِيرٌ","مُّبِينٌؕ"]},{"verse_key":"26:116","text":"قَالُوا لَٮِٕن لَّم تَنتَهِ يٰـنُوحُ لَـتَكُونَنَّ مِنَ المَرجُومِينَؕ ","words":["قَالُوا","لَٮِٕن","لَّم","تَنتَهِ","يٰـنُوحُ","لَـتَكُونَنَّ","مِنَ","المَرجُومِينَؕ "]},{"verse_key":"26:117","text":"قَالَ رَبِّ اِنَّ قَومِى كَذَّبُونِ ","words":["قَالَ","رَبِّ","اِنَّ","قَومِى","كَذَّبُونِ "]},{"verse_key":"26:118","text":"فَافتَح بَينِى وَبَينَهُم فَتحًا وَّنَجِّنِى وَمَن مَّعِىَ مِنَ المُؤمِنِينَ ","words":["فَافتَح","بَينِى","وَبَينَهُم","فَتحًا","وَّنَجِّنِى","وَمَن","مَّعِىَ","مِنَ","المُؤمِنِينَ "]},{"verse_key":"26:119","text":"فَاَنجَينٰهُ وَمَن مَّعَهٗ فِى الـفُلكِ المَشحُونِ","words":["فَاَنجَينٰهُ","وَمَن","مَّعَهٗ","فِى","الـفُلكِ","المَشحُونِ"]},{"verse_key":"26:120","text":"ثُمَّ اَغرَقنَا بَعدُ البٰقِينَؕ","words":["ثُمَّ","اَغرَقنَا","بَعدُ","البٰقِينَؕ"]},{"verse_key":"26:121","text":"اِنَّ فِى ذٰ لِكَ لَاَيَةً  ؕ وَّمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاَيَةً  ؕ","وَّمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:122","text":"وَ اِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَ اِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:123","text":"كَذَّبَت عَادُ المُرسَلِينَ  ","words":["كَذَّبَت","عَادُ","المُرسَلِينَ  "]},{"verse_key":"26:124","text":"اِذ قَالَ لَهُم اَخُوهُم هُودٌ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لَهُم","اَخُوهُم","هُودٌ","اَلَا","تَتَّقُونَ"]},{"verse_key":"26:125","text":"اِنِّى لَـكُم رَسُولٌ اَمِينٌ","words":["اِنِّى","لَـكُم","رَسُولٌ","اَمِينٌ"]},{"verse_key":"26:126","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ "]},{"verse_key":"26:127","text":"وَمَا اَســَٔـلُكُم عَلَيهِ مِن اَجرٍ اِن اَجرِىَ اِلَّا عَلٰى رَبِّ العٰلَمِينَ ؕ","words":["وَمَا","اَســَٔـلُكُم","عَلَيهِ","مِن","اَجرٍ","اِن","اَجرِىَ","اِلَّا","عَلٰى","رَبِّ","العٰلَمِينَ ؕ"]},{"verse_key":"26:128","text":"اَتَبنُونَ بِكُلِّ رِيعٍ اٰيَةً تَعبَثُونَ","words":["اَتَبنُونَ","بِكُلِّ","رِيعٍ","اٰيَةً","تَعبَثُونَ"]},{"verse_key":"26:129","text":"وَ تَتَّخِذُونَ مَصَانِعَ لَعَلَّكُم تَخلُدُونَ","words":["وَ تَتَّخِذُونَ","مَصَانِعَ","لَعَلَّكُم","تَخلُدُونَ"]},{"verse_key":"26:130","text":"وَاِذَا بَطَشتُم بَطَشتُم جَبَّارِينَ","words":["وَاِذَا","بَطَشتُم","بَطَشتُم","جَبَّارِينَ"]},{"verse_key":"26:131","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ "]},{"verse_key":"26:132","text":"وَاتَّقُوا الَّذِى اَمَدَّكُم بِمَا تَعلَمُونَ","words":["وَاتَّقُوا","الَّذِى","اَمَدَّكُم","بِمَا","تَعلَمُونَ"]},{"verse_key":"26:133","text":"اَمَدَّكُم بِاَنعَامٍ وَّبَنِينَ ","words":["اَمَدَّكُم","بِاَنعَامٍ","وَّبَنِينَ "]},{"verse_key":"26:134","text":"وَجَنّٰتٍ وَّعُيُونٍ","words":["وَجَنّٰتٍ","وَّعُيُونٍ"]},{"verse_key":"26:135","text":"اِنِّى اَخَافُ عَلَيكُم عَذَابَ يَومٍ عَظِيمٍؕ","words":["اِنِّى","اَخَافُ","عَلَيكُم","عَذَابَ","يَومٍ","عَظِيمٍؕ"]},{"verse_key":"26:136","text":"قَالُوا سَوَآءٌ عَلَينَا اَوَعَظتَ اَم لَم تَكُن مِّنَ الوٰعِظِينَ ","words":["قَالُوا","سَوَآءٌ","عَلَينَا","اَوَعَظتَ","اَم","لَم","تَكُن","مِّنَ","الوٰعِظِينَ "]},{"verse_key":"26:137","text":"اِن هٰذَا اِلَّا خُلُقُ الاَوَّلِينَ","words":["اِن","هٰذَا","اِلَّا","خُلُقُ","الاَوَّلِينَ"]},{"verse_key":"26:138","text":"وَمَا نَحنُ بِمُعَذَّبِينَ","words":["وَمَا","نَحنُ","بِمُعَذَّبِينَ"]},{"verse_key":"26:139","text":"فَكَذَّبُوهُ فَاَهلَـكنٰهُمؕ اِنَّ فِى ذٰلِكَ لَاَيَةً ؕ وَ مَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["فَكَذَّبُوهُ","فَاَهلَـكنٰهُمؕ","اِنَّ","فِى","ذٰلِكَ","لَاَيَةً ؕ","وَ مَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:140","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:141","text":"كَذَّبَت ثَمُودُ المُرسَلِينَ ","words":["كَذَّبَت","ثَمُودُ","المُرسَلِينَ "]},{"verse_key":"26:142","text":"اِذ قَالَ لَهُم اَخُوهُم صٰلِحٌ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لَهُم","اَخُوهُم","صٰلِحٌ","اَلَا","تَتَّقُونَ"]},{"verse_key":"26:143","text":"اِنِّى لَـكُم رَسُولٌ اَمِينٌ","words":["اِنِّى","لَـكُم","رَسُولٌ","اَمِينٌ"]},{"verse_key":"26:144","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ"]},{"verse_key":"26:145","text":"وَمَا اَســَٔلُكُم عَلَيهِ مِن اَجرٍ اِن اَجرِىَ اِلَّا عَلٰى رَبِّ العٰلَمِينَؕ","words":["وَمَا","اَســَٔلُكُم","عَلَيهِ","مِن","اَجرٍ","اِن","اَجرِىَ","اِلَّا","عَلٰى","رَبِّ","العٰلَمِينَؕ"]},{"verse_key":"26:146","text":"اَتُترَكُونَ فِى مَا هٰهُنَا اٰمِنِينَ","words":["اَتُترَكُونَ","فِى","مَا","هٰهُنَا","اٰمِنِينَ"]},{"verse_key":"26:147","text":"فِى جَنّٰتٍ وَّعُيُونٍ","words":["فِى","جَنّٰتٍ","وَّعُيُونٍ"]},{"verse_key":"26:148","text":"وَّزُرُوعٍ وَّنَخلٍ طَلعُهَا هَضِيمٌ","words":["وَّزُرُوعٍ","وَّنَخلٍ","طَلعُهَا","هَضِيمٌ"]},{"verse_key":"26:149","text":"وَتَـنحِتُونَ مِنَ الجِبَالِ بُيُوتًا فٰرِهِينَ","words":["وَتَـنحِتُونَ","مِنَ","الجِبَالِ","بُيُوتًا","فٰرِهِينَ"]},{"verse_key":"26:150","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ "]},{"verse_key":"26:151","text":"وَلَا تُطِيعُوا اَمرَ المُسرِفِينَ","words":["وَلَا","تُطِيعُوا","اَمرَ","المُسرِفِينَ"]},{"verse_key":"26:152","text":"الَّذِينَ يُفسِدُونَ فِى الاَرضِ وَ لَا يُصلِحُونَ","words":["الَّذِينَ","يُفسِدُونَ","فِى","الاَرضِ","وَ لَا","يُصلِحُونَ"]},{"verse_key":"26:153","text":"قَالُوا اِنَّمَا اَنتَ مِنَ المُسَحَّرِينَ","words":["قَالُوا","اِنَّمَا","اَنتَ","مِنَ","المُسَحَّرِينَ"]},{"verse_key":"26:154","text":"مَا اَنتَ اِلَّا بَشَرٌ مِّثلُـنَا   فَاتِ بِاٰيَةٍ اِن كُنتَ مِنَ الصّٰدِقِينَ","words":["مَا","اَنتَ","اِلَّا","بَشَرٌ","مِّثلُـنَا  ","فَاتِ","بِاٰيَةٍ","اِن","كُنتَ","مِنَ","الصّٰدِقِينَ"]},{"verse_key":"26:155","text":"قَالَ هٰذِهٖ نَاقَةٌ لَّهَا شِربٌ وَّلَـكُم شِربُ يَومٍ مَّعلُومٍ ","words":["قَالَ","هٰذِهٖ","نَاقَةٌ","لَّهَا","شِربٌ","وَّلَـكُم","شِربُ","يَومٍ","مَّعلُومٍ "]},{"verse_key":"26:156","text":"وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَاخُذَكُم عَذَابُ يَومٍ عَظِيمٍ","words":["وَلَا","تَمَسُّوهَا","بِسُوٓءٍ","فَيَاخُذَكُم","عَذَابُ","يَومٍ","عَظِيمٍ"]},{"verse_key":"26:157","text":"فَعَقَرُوهَا فَاَصبَحُوا نٰدِمِينَ","words":["فَعَقَرُوهَا","فَاَصبَحُوا","نٰدِمِينَ"]},{"verse_key":"26:158","text":"فَاَخَذَهُمُ العَذَابُؕ اِنَّ فِى ذٰ لِكَ لَاٰيَةً  ؕ وَمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["فَاَخَذَهُمُ","العَذَابُؕ","اِنَّ","فِى","ذٰ لِكَ","لَاٰيَةً  ؕ","وَمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:159","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:160","text":"كَذَّبَت قَومُ لُوطٍ المُرسَلِينَ  ","words":["كَذَّبَت","قَومُ","لُوطٍ","المُرسَلِينَ  "]},{"verse_key":"26:161","text":"اِذ قَالَ لَهُم اَخُوهُم لُوطٌ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لَهُم","اَخُوهُم","لُوطٌ","اَلَا","تَتَّقُونَ"]},{"verse_key":"26:162","text":"اِنِّى لَـكُم رَسُولٌ اَمِينٌ","words":["اِنِّى","لَـكُم","رَسُولٌ","اَمِينٌ"]},{"verse_key":"26:163","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ"]},{"verse_key":"26:164","text":"وَمَا اَســَٔـلُكُم عَلَيهِ مِن اَجرٍ اِن اَجرِىَ اِلَّا عَلٰى رَبِّ العٰلَمِينَ ؕ","words":["وَمَا","اَســَٔـلُكُم","عَلَيهِ","مِن","اَجرٍ","اِن","اَجرِىَ","اِلَّا","عَلٰى","رَبِّ","العٰلَمِينَ ؕ"]},{"verse_key":"26:165","text":"اَتَاتُونَ الذُّكرَانَ مِنَ العٰلَمِينَ","words":["اَتَاتُونَ","الذُّكرَانَ","مِنَ","العٰلَمِينَ"]},{"verse_key":"26:166","text":"وَ تَذَرُونَ مَا خَلَقَ لَـكُم رَبُّكُم مِّن اَزوَاجِكُمؕ بَل اَنـتُم قَومٌ عٰدُونَ","words":["وَ تَذَرُونَ","مَا","خَلَقَ","لَـكُم","رَبُّكُم","مِّن","اَزوَاجِكُمؕ","بَل","اَنـتُم","قَومٌ","عٰدُونَ"]},{"verse_key":"26:167","text":"قَالُوا لَٮِٕن لَّم تَنتَهِ يٰلُوطُ لَـتَكُونَنَّ مِنَ المُخرَجِينَ ","words":["قَالُوا","لَٮِٕن","لَّم","تَنتَهِ","يٰلُوطُ","لَـتَكُونَنَّ","مِنَ","المُخرَجِينَ "]},{"verse_key":"26:168","text":"قَالَ اِنِّى لِعَمَلِكُم مِّنَ القَالِينَؕ","words":["قَالَ","اِنِّى","لِعَمَلِكُم","مِّنَ","القَالِينَؕ"]},{"verse_key":"26:169","text":"رَبِّ نَجِّنِى وَاَهلِى مِمَّا يَعمَلُونَ","words":["رَبِّ","نَجِّنِى","وَاَهلِى","مِمَّا","يَعمَلُونَ"]},{"verse_key":"26:170","text":"فَنَجَّينٰهُ وَ اَهلَهٗ اَجمَعِينَ","words":["فَنَجَّينٰهُ","وَ اَهلَهٗ","اَجمَعِينَ"]},{"verse_key":"26:171","text":"اِلَّا عَجُوزًا فِى الغٰبِرِينَ","words":["اِلَّا","عَجُوزًا","فِى","الغٰبِرِينَ"]},{"verse_key":"26:172","text":"ثُمَّ دَمَّرنَا الاٰخَرِينَ","words":["ثُمَّ","دَمَّرنَا","الاٰخَرِينَ"]},{"verse_key":"26:173","text":"وَاَمطَرنَا عَلَيهِم مَّطَرًا فَسَآءَ مَطَرُ المُنذَرِينَ","words":["وَاَمطَرنَا","عَلَيهِم","مَّطَرًا","فَسَآءَ","مَطَرُ","المُنذَرِينَ"]},{"verse_key":"26:174","text":"اِنَّ فِى ذٰ لِكَ لَاَيَةً  ؕ وَمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاَيَةً  ؕ","وَمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:175","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:176","text":"كَذَّبَ اَصحٰبُ لْئَيكَةِ المُرسَلِينَ ","words":["كَذَّبَ","اَصحٰبُ","لْئَيكَةِ","المُرسَلِينَ "]},{"verse_key":"26:177","text":"اِذ قَالَ لَهُم شُعَيبٌ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لَهُم","شُعَيبٌ","اَلَا","تَتَّقُونَ"]},{"verse_key":"26:178","text":"اِنِّى لَـكُم رَسُولٌ اَمِينٌ","words":["اِنِّى","لَـكُم","رَسُولٌ","اَمِينٌ"]},{"verse_key":"26:179","text":"فَاتَّقُوا اللّٰهَ وَاَطِيعُونِ","words":["فَاتَّقُوا","اللّٰهَ","وَاَطِيعُونِ"]},{"verse_key":"26:180","text":"وَمَا اَسـَٔـــلُكُم عَلَيهِ مِن اَجرٍ اِن اَجرِىَ اِلَّا عَلٰى رَبِّ العٰلَمِينَ ؕ","words":["وَمَا","اَسـَٔـــلُكُم","عَلَيهِ","مِن","اَجرٍ","اِن","اَجرِىَ","اِلَّا","عَلٰى","رَبِّ","العٰلَمِينَ ؕ"]},{"verse_key":"26:181","text":" اَوفُوا الـكَيلَ وَلَا تَكُونُوا مِنَ المُخسِرِينَ","words":[" اَوفُوا","الـكَيلَ","وَلَا","تَكُونُوا","مِنَ","المُخسِرِينَ"]},{"verse_key":"26:182","text":"وَزِنُوا بِالقِسطَاسِ المُستَقِيمِ","words":["وَزِنُوا","بِالقِسطَاسِ","المُستَقِيمِ"]},{"verse_key":"26:183","text":"وَلَا تَبخَسُوا النَّاسَ اَشيَآءَهُم وَلَا تَعثَوا فِى الاَرضِ مُفسِدِينَ ","words":["وَلَا","تَبخَسُوا","النَّاسَ","اَشيَآءَهُم","وَلَا","تَعثَوا","فِى","الاَرضِ","مُفسِدِينَ "]},{"verse_key":"26:184","text":"وَاتَّقُوا الَّذِى خَلَقَكُم وَالجِـبِلَّةَ الاَوَّلِينَؕ","words":["وَاتَّقُوا","الَّذِى","خَلَقَكُم","وَالجِـبِلَّةَ","الاَوَّلِينَؕ"]},{"verse_key":"26:185","text":"قَالُوا اِنَّمَا اَنتَ مِنَ المُسَحَّرِينَ","words":["قَالُوا","اِنَّمَا","اَنتَ","مِنَ","المُسَحَّرِينَ"]},{"verse_key":"26:186","text":"وَمَا اَنتَ اِلَّا بَشَرٌ مِّثلُـنَا وَ اِن نَّظُنُّكَ لَمِنَ الكٰذِبِينَ ","words":["وَمَا","اَنتَ","اِلَّا","بَشَرٌ","مِّثلُـنَا","وَ اِن","نَّظُنُّكَ","لَمِنَ","الكٰذِبِينَ "]},{"verse_key":"26:187","text":"فَاَسقِط عَلَينَا كِسَفًا مِّنَ السَّمَآءِ اِن كُنتَ مِنَ الصّٰدِقِينَؕ ","words":["فَاَسقِط","عَلَينَا","كِسَفًا","مِّنَ","السَّمَآءِ","اِن","كُنتَ","مِنَ","الصّٰدِقِينَؕ "]},{"verse_key":"26:188","text":"قَالَ رَبِّى اَعلَمُ بِمَا تَعمَلُونَ","words":["قَالَ","رَبِّى","اَعلَمُ","بِمَا","تَعمَلُونَ"]},{"verse_key":"26:189","text":"فَكَذَّبُوهُ فَاَخَذَهُم عَذَابُ يَومِ الظُّلَّةِؕ اِنَّهٗ كَانَ عَذَابَ يَومٍ عَظِيمٍ","words":["فَكَذَّبُوهُ","فَاَخَذَهُم","عَذَابُ","يَومِ","الظُّلَّةِؕ","اِنَّهٗ","كَانَ","عَذَابَ","يَومٍ","عَظِيمٍ"]},{"verse_key":"26:190","text":"اِنَّ فِى ذٰ لِكَ لَاَيَةً  ؕ وَمَا كَانَ اَكثَرُهُم مُّؤمِنِينَ","words":["اِنَّ","فِى","ذٰ لِكَ","لَاَيَةً  ؕ","وَمَا","كَانَ","اَكثَرُهُم","مُّؤمِنِينَ"]},{"verse_key":"26:191","text":"وَاِنَّ رَبَّكَ لَهُوَ العَزِيزُ الرَّحِيمُ","words":["وَاِنَّ","رَبَّكَ","لَهُوَ","العَزِيزُ","الرَّحِيمُ"]},{"verse_key":"26:192","text":"وَاِنَّهٗ لَـتَنزِيلُ رَبِّ العٰلَمِينَؕ","words":["وَاِنَّهٗ","لَـتَنزِيلُ","رَبِّ","العٰلَمِينَؕ"]},{"verse_key":"26:193","text":"نَزَلَ بِهِ الرُّوحُ الاَمِينُ","words":["نَزَلَ","بِهِ","الرُّوحُ","الاَمِينُ"]},{"verse_key":"26:194","text":"عَلٰى قَلبِكَ لِتَكُونَ مِنَ المُنذِرِينَ","words":["عَلٰى","قَلبِكَ","لِتَكُونَ","مِنَ","المُنذِرِينَ"]},{"verse_key":"26:195","text":"بِلِسَانٍ عَرَبِىٍّ مُّبِينٍؕ","words":["بِلِسَانٍ","عَرَبِىٍّ","مُّبِينٍؕ"]},{"verse_key":"26:196","text":"وَاِنَّهٗ لَفِى زُبُرِ الاَوَّلِينَ","words":["وَاِنَّهٗ","لَفِى","زُبُرِ","الاَوَّلِينَ"]},{"verse_key":"26:197","text":"اَوَلَم يَكُن لَّهُم اٰيَةً اَن يَّعلَمَهٗ عُلَمٰٓؤُا بَنِى اِسرَآءِيلَؕ ","words":["اَوَلَم","يَكُن","لَّهُم","اٰيَةً","اَن","يَّعلَمَهٗ","عُلَمٰٓؤُا","بَنِى","اِسرَآءِيلَؕ "]},{"verse_key":"26:198","text":"وَلَو نَزَّلنٰهُ عَلٰى بَعضِ الاَعجَمِينَ","words":["وَلَو","نَزَّلنٰهُ","عَلٰى","بَعضِ","الاَعجَمِينَ"]},{"verse_key":"26:199","text":"فَقَرَاَهٗ عَلَيهِم مَّا كَانُوا بِهٖ مُؤمِنِينَؕ","words":["فَقَرَاَهٗ","عَلَيهِم","مَّا","كَانُوا","بِهٖ","مُؤمِنِينَؕ"]},{"verse_key":"26:200","text":"كَذٰلِكَ سَلَكنٰهُ فِى قُلُوبِ المُجرِمِينَؕ","words":["كَذٰلِكَ","سَلَكنٰهُ","فِى","قُلُوبِ","المُجرِمِينَؕ"]},{"verse_key":"26:201","text":"لَا يُؤمِنُونَ بِهٖ حَتّٰى يَرَوُا العَذَابَ الاَلِيمَ","words":["لَا","يُؤمِنُونَ","بِهٖ","حَتّٰى","يَرَوُا","العَذَابَ","الاَلِيمَ"]},{"verse_key":"26:202","text":"فَيَاتِيَهُم بَغتَةً وَّهُم لَا يَشعُرُونَ","words":["فَيَاتِيَهُم","بَغتَةً","وَّهُم","لَا","يَشعُرُونَ"]},{"verse_key":"26:203","text":"فَيَـقُولُوا هَل نَحنُ مُنظَرُونَؕ","words":["فَيَـقُولُوا","هَل","نَحنُ","مُنظَرُونَؕ"]},{"verse_key":"26:204","text":"اَفَبِعَذَابِنَا يَستَعجِلُونَ","words":["اَفَبِعَذَابِنَا","يَستَعجِلُونَ"]},{"verse_key":"26:205","text":"اَفَرَءَيتَ اِن مَّتَّعنٰهُم سِنِينَ","words":["اَفَرَءَيتَ","اِن","مَّتَّعنٰهُم","سِنِينَ"]},{"verse_key":"26:206","text":"ثُمَّ جَآءَهُم مَّا كَانُوا يُوعَدُونَ","words":["ثُمَّ","جَآءَهُم","مَّا","كَانُوا","يُوعَدُونَ"]},{"verse_key":"26:207","text":"مَا اَغنٰى عَنهُم مَّا كَانُوا يُمَتَّعُونَؕ","words":["مَا","اَغنٰى","عَنهُم","مَّا","كَانُوا","يُمَتَّعُونَؕ"]},{"verse_key":"26:208","text":"وَمَا اَهلَكنَا مِن قَريَةٍ اِلَّا لَهَا مُنذِرُونَ   ","words":["وَمَا","اَهلَكنَا","مِن","قَريَةٍ","اِلَّا","لَهَا","مُنذِرُونَ   "]},{"verse_key":"26:209","text":"ذِكرٰى وَمَا كُنَّا ظٰلِمِينَ","words":["ذِكرٰى","وَمَا","كُنَّا","ظٰلِمِينَ"]},{"verse_key":"26:210","text":"وَمَا تَنَزَّلَت بِهِ الشَّيٰطِينُ","words":["وَمَا","تَنَزَّلَت","بِهِ","الشَّيٰطِينُ"]},{"verse_key":"26:211","text":"وَمَا يَنبَغِى لَهُم وَمَا يَستَطِيعُونَؕ","words":["وَمَا","يَنبَغِى","لَهُم","وَمَا","يَستَطِيعُونَؕ"]},{"verse_key":"26:212","text":"اِنَّهُم عَنِ السَّمعِ لَمَعزُولُونَؕ","words":["اِنَّهُم","عَنِ","السَّمعِ","لَمَعزُولُونَؕ"]},{"verse_key":"26:213","text":"فَلَا تَدعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَكُونَ مِنَ المُعَذَّبِينَ ","words":["فَلَا","تَدعُ","مَعَ","اللّٰهِ","اِلٰهًا","اٰخَرَ","فَتَكُونَ","مِنَ","المُعَذَّبِينَ "]},{"verse_key":"26:214","text":"وَاَنذِر عَشِيرَتَكَ الاَقرَبِينَ","words":["وَاَنذِر","عَشِيرَتَكَ","الاَقرَبِينَ"]},{"verse_key":"26:215","text":"وَاخفِض جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ المُؤمِنِينَ","words":["وَاخفِض","جَنَاحَكَ","لِمَنِ","اتَّبَعَكَ","مِنَ","المُؤمِنِينَ"]},{"verse_key":"26:216","text":"فَاِن عَصَوكَ فَقُل اِنِّى بَرِىٓءٌ مِّمَّا تَعمَلُونَ","words":["فَاِن","عَصَوكَ","فَقُل","اِنِّى","بَرِىٓءٌ","مِّمَّا","تَعمَلُونَ"]},{"verse_key":"26:217","text":"وَتَوَكَّل عَلَى العَزِيزِ الرَّحِيمِ","words":["وَتَوَكَّل","عَلَى","العَزِيزِ","الرَّحِيمِ"]},{"verse_key":"26:218","text":"الَّذِى يَرٰٮكَ حِينَ تَقُومُ","words":["الَّذِى","يَرٰٮكَ","حِينَ","تَقُومُ"]},{"verse_key":"26:219","text":"وَتَقَلُّبَكَ فِى السّٰجِدِينَ","words":["وَتَقَلُّبَكَ","فِى","السّٰجِدِينَ"]},{"verse_key":"26:220","text":"اِنَّهٗ هُوَ السَّمِيعُ العَلِيمُ","words":["اِنَّهٗ","هُوَ","السَّمِيعُ","العَلِيمُ"]},{"verse_key":"26:221","text":"هَل اُنَبِّئُكُم عَلٰى مَن تَنَزَّلُ الشَّيٰـطِينُؕ","words":["هَل","اُنَبِّئُكُم","عَلٰى","مَن","تَنَزَّلُ","الشَّيٰـطِينُؕ"]},{"verse_key":"26:222","text":"تَنَزَّلُ عَلٰى كُلِّ اَفَّاكٍ اَثِيمٍ","words":["تَنَزَّلُ","عَلٰى","كُلِّ","اَفَّاكٍ","اَثِيمٍ"]},{"verse_key":"26:223","text":"يُّلقُونَ السَّمعَ وَاَكثَرُهُم كٰذِبُونَؕ","words":["يُّلقُونَ","السَّمعَ","وَاَكثَرُهُم","كٰذِبُونَؕ"]},{"verse_key":"26:224","text":"وَالشُّعَرَآءُ يَتَّبِعُهُمُ الغَاوٗنَؕ","words":["وَالشُّعَرَآءُ","يَتَّبِعُهُمُ","الغَاوٗنَؕ"]},{"verse_key":"26:225","text":"اَلَم تَرَ اَنَّهُم فِى كُلِّ وَادٍ يَّهِيمُونَ","words":["اَلَم","تَرَ","اَنَّهُم","فِى","كُلِّ","وَادٍ","يَّهِيمُونَ"]},{"verse_key":"26:226","text":"وَاَنَّهُم يَقُولُونَ مَا لَا يَفعَلُونَ","words":["وَاَنَّهُم","يَقُولُونَ","مَا","لَا","يَفعَلُونَ"]},{"verse_key":"26:227","text":"اِلَّا الَّذِينَ اٰمَنُوا وَعَمِلُوا الصّٰلِحٰتِ وَذَكَرُوا اللّٰهَ كَثِيرًا وَّانْتَصَرُوا مِن بَعدِ مَا ظُلِمُوا ؕ وَسَيَـعلَمُ الَّذِينَ ظَلَمُوا اَىَّ مُنقَلَبٍ يَّـنقَلِبُونَ","words":["اِلَّا","الَّذِينَ","اٰمَنُوا","وَعَمِلُوا","الصّٰلِحٰتِ","وَذَكَرُوا","اللّٰهَ","كَثِيرًا","وَّانْتَصَرُوا","مِن","بَعدِ","مَا","ظُلِمُوا ؕ","وَسَيَـعلَمُ","الَّذِينَ","ظَلَمُوا","اَىَّ","مُنقَلَبٍ","يَّـنقَلِبُونَ"]}]}