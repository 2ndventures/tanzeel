{"verses":[{"verse_key":"93:1","text":"وَالضُّحٰى","words":["وَالضُّحٰى"]},{"verse_key":"93:2","text":"وَالَّيلِ اِذَا سَجٰى","words":["وَالَّيلِ","اِذَا","سَجٰى"]},{"verse_key":"93:3","text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ","words":["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلٰىؕ"]},{"verse_key":"93:4","text":"وَلَـلاٰخِرَةُ خَيرٌ لَّكَ مِنَ الاُولٰىؕ","words":["وَلَـلاٰخِرَةُ","خَيرٌ","لَّكَ","مِنَ","الاُولٰىؕ"]},{"verse_key":"93:5","text":"وَلَسَوفَ يُعطِيكَ رَبُّكَ فَتَرضٰىؕ","words":["وَلَسَوفَ","يُعطِيكَ","رَبُّكَ","فَتَرضٰىؕ"]},{"verse_key":"93:6","text":"اَلَم يَجِدكَ يَتِيمًا فَاٰوٰى","words":["اَلَم","يَجِدكَ","يَتِيمًا","فَاٰوٰى"]},{"verse_key":"93:7","text":"وَوَجَدَكَ ضَآ لًّا فَهَدٰى","words":["وَوَجَدَكَ","ضَآ","لًّا فَهَدٰى"]},{"verse_key":"93:8","text":"وَوَجَدَكَ عَآٮِٕلًا فَاَغنٰىؕ","words":["وَوَجَدَكَ","عَآٮِٕلًا","فَاَغنٰىؕ"]},{"verse_key":"93:9","text":"فَاَمَّا اليَتِيمَ فَلَا تَقهَرؕ","words":["فَاَمَّا","اليَتِيمَ","فَلَا","تَقهَرؕ"]},{"verse_key":"93:10","text":"وَاَمَّا السَّآٮِٕلَ فَلَا تَنهَرؕ","words":["وَاَمَّا","السَّآٮِٕلَ","فَلَا","تَنهَرؕ"]},{"verse_key":"93:11","text":"وَاَمَّا بِنِعمَةِ رَبِّكَ فَحَدِّث","words":["وَاَمَّا","بِنِعمَةِ","رَبِّكَ","فَحَدِّث"]}]}