{"verses":[{"verse_key":"91:1","text":"وَالشَّمسِ وَضُحٰٮهَا  ","words":["وَالشَّمسِ","وَضُحٰٮهَا  "]},{"verse_key":"91:2","text":"وَالقَمَرِ اِذَا تَلٰٮهَا  ","words":["وَالقَمَرِ","اِذَا","تَلٰٮهَا  "]},{"verse_key":"91:3","text":"وَالنَّهَارِ اِذَا جَلّٰٮهَا ","words":["وَالنَّهَارِ","اِذَا","جَلّٰٮهَا "]},{"verse_key":"91:4","text":"وَالَّيلِ اِذَا يَغشٰٮهَا ","words":["وَالَّيلِ","اِذَا","يَغشٰٮهَا "]},{"verse_key":"91:5","text":"وَالسَّمَآءِ وَمَا بَنٰٮهَا ","words":["وَالسَّمَآءِ","وَمَا","بَنٰٮهَا "]},{"verse_key":"91:6","text":"وَالاَرضِ وَمَا طَحٰٮهَا ","words":["وَالاَرضِ","وَمَا","طَحٰٮهَا "]},{"verse_key":"91:7","text":"وَنَفسٍ وَّمَا سَوّٰٮهَا ","words":["وَنَفسٍ","وَّمَا","سَوّٰٮهَا "]},{"verse_key":"91:8","text":"فَاَلهَمَهَا فُجُورَهَا وَتَقوٰٮهَا ","words":["فَاَلهَمَهَا","فُجُورَهَا","وَتَقوٰٮهَا "]},{"verse_key":"91:9","text":"قَد اَفلَحَ مَن زَكّٰٮهَا ","words":["قَد","اَفلَحَ","مَن","زَكّٰٮهَا "]},{"verse_key":"91:10","text":"وَقَد خَابَ مَن دَسّٰٮهَا ؕ","words":["وَقَد","خَابَ","مَن","دَسّٰٮهَا ؕ"]},{"verse_key":"91:11","text":"كَذَّبَت ثَمُودُ بِطَغوٰٮهَآ  ","words":["كَذَّبَت","ثَمُودُ","بِطَغوٰٮهَآ  "]},{"verse_key":"91:12","text":"اِذِ انبَعَثَ اَشقٰٮهَا  ","words":["اِذِ","انبَعَثَ","اَشقٰٮهَا  "]},{"verse_key":"91:13","text":"فَقَالَ لَهُم رَسُولُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقيٰهَا ؕ","words":["فَقَالَ","لَهُم","رَسُولُ","اللّٰهِ","نَاقَةَ","اللّٰهِ","وَسُقيٰهَا ؕ"]},{"verse_key":"91:14","text":"فَكَذَّبُوهُ فَعَقَرُوهَا   فَدَمدَمَ عَلَيهِم رَبُّهُم بِذَنبِهِم فَسَوّٰٮهَا  ","words":["فَكَذَّبُوهُ","فَعَقَرُوهَا  ","فَدَمدَمَ","عَلَيهِم","رَبُّهُم","بِذَنبِهِم","فَسَوّٰٮهَا  "]},{"verse_key":"91:15","text":"وَلَا يَخَافُ عُقبٰهَا","words":["وَلَا","يَخَافُ","عُقبٰهَا"]}]}