{"verses":[{"verse_key":"69:1","text":"اَلحَـآقَّةُ ","words":["اَلحَـآقَّةُ "]},{"verse_key":"69:2","text":"مَا الحَـآقَّةُ ","words":["مَا","الحَـآقَّةُ "]},{"verse_key":"69:3","text":"وَمَا اَدرٰٮكَ مَا الحَــآقَّةُ ؕ","words":["وَمَا","اَدرٰٮكَ","مَا","الحَــآقَّةُ ؕ"]},{"verse_key":"69:4","text":"كَذَّبَت ثَمُودُ وَعَادٌ بِالقَارِعَةِ","words":["كَذَّبَت","ثَمُودُ","وَعَادٌ","بِالقَارِعَةِ"]},{"verse_key":"69:5","text":"فَاَمَّا ثَمُودُ فَاُهلِكُوا بِالطَّاغِيَةِ","words":["فَاَمَّا","ثَمُودُ","فَاُهلِكُوا","بِالطَّاغِيَةِ"]},{"verse_key":"69:6","text":"وَاَمَّا عَادٌ فَاُهلِكُوا بِرِيحٍ صَرصَرٍ عَاتِيَةٍ","words":["وَاَمَّا","عَادٌ","فَاُهلِكُوا","بِرِيحٍ","صَرصَرٍ","عَاتِيَةٍ"]},{"verse_key":"69:7","text":"سَخَّرَهَا عَلَيهِم سَبعَ لَيَالٍ وَّثَمٰنِيَةَ اَيَّامٍ حُسُومًا  فَتَرَى القَومَ فِيهَا صَرعٰى كَاَنَّهُم اَعجَازُ نَخلٍ خَاوِيَةٍ ","words":["سَخَّرَهَا","عَلَيهِم","سَبعَ","لَيَالٍ","وَّثَمٰنِيَةَ","اَيَّامٍ","حُسُومًا ","فَتَرَى","القَومَ","فِيهَا","صَرعٰى","كَاَنَّهُم","اَعجَازُ","نَخلٍ","خَاوِيَةٍ "]},{"verse_key":"69:8","text":"فَهَل تَرٰى لَهُم مِّن بَاقِيَةٍ","words":["فَهَل","تَرٰى","لَهُم","مِّن","بَاقِيَةٍ"]},{"verse_key":"69:9","text":"وَجَآءَ فِرعَونُ وَمَن قَبلَهٗ وَالمُؤتَفِكٰتُ بِالخَـاطِئَةِ","words":["وَجَآءَ","فِرعَونُ","وَمَن","قَبلَهٗ","وَالمُؤتَفِكٰتُ","بِالخَـاطِئَةِ"]},{"verse_key":"69:10","text":"فَعَصَوا رَسُولَ رَبِّهِم فَاَخَذَهُم اَخذَةً رَّابِيَةً","words":["فَعَصَوا","رَسُولَ","رَبِّهِم","فَاَخَذَهُم","اَخذَةً","رَّابِيَةً"]},{"verse_key":"69:11","text":"اِنَّا لَمَّا طَغَا المَآءُ حَمَلنٰكُم فِى الجَارِيَةِ ","words":["اِنَّا","لَمَّا","طَغَا","المَآءُ","حَمَلنٰكُم","فِى","الجَارِيَةِ "]},{"verse_key":"69:12","text":"لِنَجعَلَهَا لَـكُم تَذكِرَةً وَّتَعِيَهَا اُذُنٌ وَّاعِيَةٌ","words":["لِنَجعَلَهَا","لَـكُم","تَذكِرَةً","وَّتَعِيَهَا","اُذُنٌ","وَّاعِيَةٌ"]},{"verse_key":"69:13","text":"فَاِذَا نُفِخَ فِى الصُّورِ نَفخَةٌ وَّاحِدَةٌ ","words":["فَاِذَا","نُفِخَ","فِى","الصُّورِ","نَفخَةٌ","وَّاحِدَةٌ "]},{"verse_key":"69:14","text":"وَحُمِلَتِ الاَرضُ وَ الجِبَالُ فَدُكَّتَا دَكَّةً وَّاحِدَةً ","words":["وَحُمِلَتِ","الاَرضُ","وَ الجِبَالُ","فَدُكَّتَا","دَكَّةً","وَّاحِدَةً "]},{"verse_key":"69:15","text":"فَيَومَٮِٕذٍ وَّقَعَتِ الوَاقِعَةُ ","words":["فَيَومَٮِٕذٍ","وَّقَعَتِ","الوَاقِعَةُ "]},{"verse_key":"69:16","text":"وَانْشَقَّتِ السَّمَآءُ فَهِىَ يَومَٮِٕذٍ وَّاهِيَةٌ ","words":["وَانْشَقَّتِ","السَّمَآءُ","فَهِىَ","يَومَٮِٕذٍ","وَّاهِيَةٌ "]},{"verse_key":"69:17","text":"وَّالمَلَكُ عَلٰٓى اَرجَآٮِٕهَا ؕ وَيَحمِلُ عَرشَ رَبِّكَ فَوقَهُم يَومَٮِٕذٍ ثَمٰنِيَةٌ ؕ","words":["وَّالمَلَكُ","عَلٰٓى","اَرجَآٮِٕهَا ؕ","وَيَحمِلُ","عَرشَ","رَبِّكَ","فَوقَهُم","يَومَٮِٕذٍ","ثَمٰنِيَةٌ ؕ"]},{"verse_key":"69:18","text":"يَومَٮِٕذٍ تُعرَضُونَ لَا تَخفٰى مِنكُم خَافِيَةٌ","words":["يَومَٮِٕذٍ","تُعرَضُونَ","لَا","تَخفٰى","مِنكُم","خَافِيَةٌ"]},{"verse_key":"69:19","text":"فَاَمَّا مَن اُوتِىَ كِتٰبَهٗ بِيَمِينِهٖ فَيَقُولُ هَآؤُمُ اقرَءُوا كِتٰبِيَه","words":["فَاَمَّا","مَن","اُوتِىَ","كِتٰبَهٗ","بِيَمِينِهٖ","فَيَقُولُ","هَآؤُمُ","اقرَءُوا","كِتٰبِيَه"]},{"verse_key":"69:20","text":"اِنِّى ظَنَنتُ اَنِّى مُلٰقٍ حِسَابِيَه","words":["اِنِّى","ظَنَنتُ","اَنِّى","مُلٰقٍ","حِسَابِيَه"]},{"verse_key":"69:21","text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","words":["فَهُوَ","فِى","عِيشَةٍ","رَّاضِيَةٍ"]},{"verse_key":"69:22","text":"فِى جَنَّةٍ عَالِيَةٍ","words":["فِى","جَنَّةٍ","عَالِيَةٍ"]},{"verse_key":"69:23","text":"قُطُوفُهَا دَانِيَةٌ","words":["قُطُوفُهَا","دَانِيَةٌ"]},{"verse_key":"69:24","text":"كُلُوا وَاشرَبُوا هَنِيٓـــًٔا  بِمَا اَسلَفتُم فِى الاَيَّامِ الخَـالِيَةِ ","words":["كُلُوا","وَاشرَبُوا","هَنِيٓـــًٔا ","بِمَا","اَسلَفتُم","فِى","الاَيَّامِ","الخَـالِيَةِ "]},{"verse_key":"69:25","text":"وَاَمَّا مَن اُوتِىَ كِتٰبَهٗ بِشِمَالِهٖ   فَيَقُولُ يٰلَيتَنِى لَم اُوتَ كِتٰبِيَه","words":["وَاَمَّا","مَن","اُوتِىَ","كِتٰبَهٗ","بِشِمَالِهٖ  ","فَيَقُولُ","يٰلَيتَنِى","لَم","اُوتَ","كِتٰبِيَه"]},{"verse_key":"69:26","text":"وَلَم اَدرِ مَا حِسَابِيَه","words":["وَلَم","اَدرِ","مَا","حِسَابِيَه"]},{"verse_key":"69:27","text":"يٰلَيتَهَا كَانَتِ القَاضِيَةَ ","words":["يٰلَيتَهَا","كَانَتِ","القَاضِيَةَ "]},{"verse_key":"69:28","text":"مَا اَغنٰى عَنِّى مَالِيَه","words":["مَا","اَغنٰى","عَنِّى","مَالِيَه"]},{"verse_key":"69:29","text":"هَلَكَ عَنِّى سُلطٰنِيَه","words":["هَلَكَ","عَنِّى","سُلطٰنِيَه"]},{"verse_key":"69:30","text":"خُذُوهُ فَغُلُّوهُ ","words":["خُذُوهُ","فَغُلُّوهُ "]},{"verse_key":"69:31","text":"ثُمَّ الجَحِيمَ صَلُّوهُ ","words":["ثُمَّ","الجَحِيمَ","صَلُّوهُ "]},{"verse_key":"69:32","text":"ثُمَّ فِى سِلسِلَةٍ ذَرعُهَا سَبعُونَ ذِرَاعًا فَاسلُكُوهُ ؕ","words":["ثُمَّ","فِى","سِلسِلَةٍ","ذَرعُهَا","سَبعُونَ","ذِرَاعًا","فَاسلُكُوهُ ؕ"]},{"verse_key":"69:33","text":"اِنَّهٗ كَانَ لَا يُؤمِنُ بِاللّٰهِ العَظِيمِ","words":["اِنَّهٗ","كَانَ","لَا","يُؤمِنُ","بِاللّٰهِ","العَظِيمِ"]},{"verse_key":"69:34","text":"وَلَا يَحُضُّ عَلٰى طَعَامِ المِسكِينِؕ","words":["وَلَا","يَحُضُّ","عَلٰى","طَعَامِ","المِسكِينِؕ"]},{"verse_key":"69:35","text":"فَلَيسَ لَـهُ اليَومَ هٰهُنَا حَمِيمٌ","words":["فَلَيسَ","لَـهُ","اليَومَ","هٰهُنَا","حَمِيمٌ"]},{"verse_key":"69:36","text":"وَّلَا طَعَامٌ اِلَّا مِن غِسلِينٍ","words":["وَّلَا","طَعَامٌ","اِلَّا","مِن","غِسلِينٍ"]},{"verse_key":"69:37","text":"لَّا يَاكُلُهٗ اِلَّا الخٰطِئُوْنَ","words":["لَّا","يَاكُلُهٗ","اِلَّا","الخٰطِئُوْنَ"]},{"verse_key":"69:38","text":"فَلَا اُقسِمُ بِمَا تُبصِرُونَ","words":["فَلَا","اُقسِمُ","بِمَا","تُبصِرُونَ"]},{"verse_key":"69:39","text":"وَمَا لَا تُبصِرُونَ","words":["وَمَا","لَا","تُبصِرُونَ"]},{"verse_key":"69:40","text":"اِنَّهٗ لَقَولُ رَسُولٍ كَرِيمٍ ","words":["اِنَّهٗ","لَقَولُ","رَسُولٍ","كَرِيمٍ "]},{"verse_key":"69:41","text":"وَّمَا هُوَ بِقَولِ شَاعِرٍؕ قَلِيلًا مَّا تُؤمِنُونَ","words":["وَّمَا","هُوَ","بِقَولِ","شَاعِرٍؕ","قَلِيلًا","مَّا","تُؤمِنُونَ"]},{"verse_key":"69:42","text":"وَلَا بِقَولِ كَاهِنٍؕ قَلِيلًا مَّا تَذَكَّرُونَؕ","words":["وَلَا","بِقَولِ","كَاهِنٍؕ","قَلِيلًا","مَّا","تَذَكَّرُونَؕ"]},{"verse_key":"69:43","text":"تَنزِيلٌ مِّن رَّبِّ العٰلَمِينَ","words":["تَنزِيلٌ","مِّن","رَّبِّ","العٰلَمِينَ"]},{"verse_key":"69:44","text":"وَلَو تَقَوَّلَ عَلَينَا بَعضَ الاَقَاوِيلِ","words":["وَلَو","تَقَوَّلَ","عَلَينَا","بَعضَ","الاَقَاوِيلِ"]},{"verse_key":"69:45","text":"لَاَخَذنَا مِنهُ بِاليَمِينِ","words":["لَاَخَذنَا","مِنهُ","بِاليَمِينِ"]},{"verse_key":"69:46","text":"ثُمَّ لَقَطَعنَا مِنهُ الوَتِينَ  ","words":["ثُمَّ","لَقَطَعنَا","مِنهُ","الوَتِينَ  "]},{"verse_key":"69:47","text":"فَمَا مِنكُم مِّن اَحَدٍ عَنهُ حَاجِزِينَ","words":["فَمَا","مِنكُم","مِّن","اَحَدٍ","عَنهُ","حَاجِزِينَ"]},{"verse_key":"69:48","text":"وَاِنَّهٗ لَتَذكِرَةٌ لِّلمُتَّقِينَ","words":["وَاِنَّهٗ","لَتَذكِرَةٌ","لِّلمُتَّقِينَ"]},{"verse_key":"69:49","text":"وَاِنَّا لَنَعلَمُ اَنَّ مِنكُم مُّكَذِّبِينَ","words":["وَاِنَّا","لَنَعلَمُ","اَنَّ","مِنكُم","مُّكَذِّبِينَ"]},{"verse_key":"69:50","text":"وَاِنَّهٗ لَحَسرَةٌ عَلَى الكٰفِرِينَ","words":["وَاِنَّهٗ","لَحَسرَةٌ","عَلَى","الكٰفِرِينَ"]},{"verse_key":"69:51","text":" وَاِنَّهٗ لَحَـقُّ اليَقِينِ","words":[" وَاِنَّهٗ","لَحَـقُّ","اليَقِينِ"]},{"verse_key":"69:52","text":"فَسَبِّح بِاسمِ رَبِّكَ العَظِيمِ","words":["فَسَبِّح","بِاسمِ","رَبِّكَ","العَظِيمِ"]}]}