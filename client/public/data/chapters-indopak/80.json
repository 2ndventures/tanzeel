{"verses":[{"verse_key":"80:1","text":"عَبَسَ وَتَوَلّٰٓى","words":["عَبَسَ","وَتَوَلّٰٓى"]},{"verse_key":"80:2","text":"اَن جَآءَهُ الاَعمٰىؕ","words":["اَن","جَآءَهُ","الاَعمٰىؕ"]},{"verse_key":"80:3","text":"وَمَا يُدرِيكَ لَعَلَّهٗ يَزَّكّٰٓى","words":["وَمَا","يُدرِيكَ","لَعَلَّهٗ","يَزَّكّٰٓى"]},{"verse_key":"80:4","text":"اَو يَذَّكَّرُ فَتَنفَعَهُ الذِّكرٰىؕ","words":["اَو","يَذَّكَّرُ","فَتَنفَعَهُ","الذِّكرٰىؕ"]},{"verse_key":"80:5","text":"اَمَّا مَنِ استَغنٰى","words":["اَمَّا","مَنِ","استَغنٰى"]},{"verse_key":"80:6","text":"فَاَنتَ لَهٗ تَصَدّٰىؕ","words":["فَاَنتَ","لَهٗ","تَصَدّٰىؕ"]},{"verse_key":"80:7","text":"وَمَا عَلَيكَ اَلَّا يَزَّكّٰٓىؕ","words":["وَمَا","عَلَيكَ","اَلَّا","يَزَّكّٰٓىؕ"]},{"verse_key":"80:8","text":"وَاَمَّا مَن جَآءَكَ يَسعٰى","words":["وَاَمَّا","مَن","جَآءَكَ","يَسعٰى"]},{"verse_key":"80:9","text":"وَهُوَ يَخشٰى","words":["وَهُوَ","يَخشٰى"]},{"verse_key":"80:10","text":"فَاَنتَ عَنهُ تَلَهّٰى","words":["فَاَنتَ","عَنهُ","تَلَهّٰى"]},{"verse_key":"80:11","text":"كَلَّا اِنَّهَا تَذكِرَةٌ ","words":["كَلَّا","اِنَّهَا","تَذكِرَةٌ "]},{"verse_key":"80:12","text":"فَمَن شَآءَ ذَكَرَهٗ","words":["فَمَن","شَآءَ","ذَكَرَهٗ"]},{"verse_key":"80:13","text":"فِى صُحُفٍ مُّكَرَّمَةٍ","words":["فِى","صُحُفٍ","مُّكَرَّمَةٍ"]},{"verse_key":"80:14","text":"مَّرفُوعَةٍ مُّطَهَّرَةٍ ","words":["مَّرفُوعَةٍ","مُّطَهَّرَةٍ "]},{"verse_key":"80:15","text":"بِاَيدِى سَفَرَةٍ","words":["بِاَيدِى","سَفَرَةٍ"]},{"verse_key":"80:16","text":"كِرَامٍ بَرَرَةٍؕ","words":["كِرَامٍ","بَرَرَةٍؕ"]},{"verse_key":"80:17","text":"قُتِلَ الاِنسَانُ مَا اَكفَرَهٗؕ","words":["قُتِلَ","الاِنسَانُ","مَا","اَكفَرَهٗؕ"]},{"verse_key":"80:18","text":"مِن اَىِّ شَىءٍ خَلَقَهٗؕ","words":["مِن","اَىِّ","شَىءٍ","خَلَقَهٗؕ"]},{"verse_key":"80:19","text":"مِن نُّطفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ","words":["مِن","نُّطفَةٍؕ","خَلَقَهٗ","فَقَدَّرَهٗ "]},{"verse_key":"80:20","text":"ثُمَّ السَّبِيلَ يَسَّرَهٗ","words":["ثُمَّ","السَّبِيلَ","يَسَّرَهٗ"]},{"verse_key":"80:21","text":"ثُمَّ اَمَاتَهٗ فَاَقبَرَهٗ","words":["ثُمَّ","اَمَاتَهٗ","فَاَقبَرَهٗ"]},{"verse_key":"80:22","text":"ثُمَّ اِذَا شَآءَ اَنشَرَهٗؕ","words":["ثُمَّ","اِذَا","شَآءَ","اَنشَرَهٗؕ"]},{"verse_key":"80:23","text":"كَلَّا لَـمَّا يَقضِ مَا اَمَرَهٗؕ","words":["كَلَّا","لَـمَّا","يَقضِ","مَا","اَمَرَهٗؕ"]},{"verse_key":"80:24","text":"فَليَنظُرِ الاِنسَانُ اِلٰى طَعَامِهٖ","words":["فَليَنظُرِ","الاِنسَانُ","اِلٰى","طَعَامِهٖ"]},{"verse_key":"80:25","text":"اَنَّا صَبَبنَا المَآءَ صَبًّا ","words":["اَنَّا","صَبَبنَا","المَآءَ","صَبًّا "]},{"verse_key":"80:26","text":"ثُمَّ شَقَقنَا الاَرضَ شَقًّا ","words":["ثُمَّ","شَقَقنَا","الاَرضَ","شَقًّا "]},{"verse_key":"80:27","text":"فَاَنبَتنَا فِيهَا حَبًّا ","words":["فَاَنبَتنَا","فِيهَا","حَبًّا "]},{"verse_key":"80:28","text":"وَّ عِنَبًا وَّقَضبًا ","words":["وَّ عِنَبًا","وَّقَضبًا "]},{"verse_key":"80:29","text":"وَّزَيتُونًا وَّنَخلًا ؕ","words":["وَّزَيتُونًا","وَّنَخلًا ؕ"]},{"verse_key":"80:30","text":"وَحَدَآٮِٕقَ غُلبًا ","words":["وَحَدَآٮِٕقَ","غُلبًا "]},{"verse_key":"80:31","text":"وَّفَاكِهَةً وَّاَبًّا ","words":["وَّفَاكِهَةً","وَّاَبًّا "]},{"verse_key":"80:32","text":"مَّتَاعًا لَّـكُم وَلِاَنعَامِكُمؕ","words":["مَّتَاعًا","لَّـكُم","وَلِاَنعَامِكُمؕ"]},{"verse_key":"80:33","text":"فَاِذَا جَآءَتِ الصَّآخَّةُ","words":["فَاِذَا","جَآءَتِ","الصَّآخَّةُ"]},{"verse_key":"80:34","text":"يَومَ يَفِرُّ المَرءُ مِن اَخِيهِ","words":["يَومَ","يَفِرُّ","المَرءُ","مِن","اَخِيهِ"]},{"verse_key":"80:35","text":"وَاُمِّهٖ وَاَبِيهِ","words":["وَاُمِّهٖ","وَاَبِيهِ"]},{"verse_key":"80:36","text":"وَصَاحِبَتِهٖ وَبَنِيهِؕ","words":["وَصَاحِبَتِهٖ","وَبَنِيهِؕ"]},{"verse_key":"80:37","text":"لِكُلِّ امرِیءٍ مِّنهُم يَومَٮِٕذٍ شَانٌ يُّغنِيهِؕ","words":["لِكُلِّ","امرِیءٍ","مِّنهُم","يَومَٮِٕذٍ","شَانٌ","يُّغنِيهِؕ"]},{"verse_key":"80:38","text":"وُجُوهٌ يَّومَٮِٕذٍ مُّسفِرَةٌ ","words":["وُجُوهٌ","يَّومَٮِٕذٍ","مُّسفِرَةٌ "]},{"verse_key":"80:39","text":"ضَاحِكَةٌ مُّستَبشِرَةٌ ","words":["ضَاحِكَةٌ","مُّستَبشِرَةٌ "]},{"verse_key":"80:40","text":"وَوُجُوهٌ يَّومَٮِٕذٍ عَلَيهَا غَبَرَةٌ ","words":["وَوُجُوهٌ","يَّومَٮِٕذٍ","عَلَيهَا","غَبَرَةٌ "]},{"verse_key":"80:41","text":"تَرهَقُهَا قَتَرَةٌ ؕ","words":["تَرهَقُهَا","قَتَرَةٌ ؕ"]},{"verse_key":"80:42","text":"اُولٰٓٮِٕكَ هُمُ الكَفَرَةُ الفَجَرَةُ","words":["اُولٰٓٮِٕكَ","هُمُ","الكَفَرَةُ","الفَجَرَةُ"]}]}