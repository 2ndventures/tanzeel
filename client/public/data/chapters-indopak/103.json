{"verses":[{"verse_key":"103:1","text":"وَالعَصرِ","words":["وَالعَصرِ"]},{"verse_key":"103:2","text":"اِنَّ الاِنسَانَ لَفِى خُسرٍ","words":["اِنَّ","الاِنسَانَ","لَفِى","خُسرٍ"]},{"verse_key":"103:3","text":"اِلَّا الَّذِينَ اٰمَنُوا وَ عَمِلُوا الصّٰلِحٰتِ وَتَوَاصَوا بِالحَقِّ    وَتَوَاصَوا بِالصَّبرِ","words":["اِلَّا","الَّذِينَ","اٰمَنُوا","وَ","عَمِلُوا","الصّٰلِحٰتِ","وَتَوَاصَوا","بِالحَقِّ   ","وَتَوَاصَوا بِالصَّبرِ"]}]}