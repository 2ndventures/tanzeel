{"verses":[{"verse_key":"37:1","text":"وَالصّٰٓفّٰتِ صَفًّا ","words":["وَالصّٰٓفّٰتِ","صَفًّا "]},{"verse_key":"37:2","text":"فَالزّٰجِرٰتِ زَجرًا ","words":["فَالزّٰجِرٰتِ","زَجرًا "]},{"verse_key":"37:3","text":"فَالتّٰلِيٰتِ ذِكرًا ","words":["فَالتّٰلِيٰتِ","ذِكرًا "]},{"verse_key":"37:4","text":"اِنَّ اِلٰهَكُم لَوَاحِدٌ ؕ","words":["اِنَّ","اِلٰهَكُم","لَوَاحِدٌ ؕ"]},{"verse_key":"37:5","text":"رَبُّ السَّمٰوٰتِ وَالاَرضِ وَمَا بَينَهُمَا وَرَبُّ المَشَارِقِ ؕ","words":["رَبُّ","السَّمٰوٰتِ","وَالاَرضِ","وَمَا","بَينَهُمَا","وَرَبُّ","المَشَارِقِ ؕ"]},{"verse_key":"37:6","text":"اِنَّا زَيَّنَّا السَّمَآءَ الدُّنيَا بِزِينَةِ الكَوَاكِبِ","words":["اِنَّا","زَيَّنَّا","السَّمَآءَ","الدُّنيَا","بِزِينَةِ","الكَوَاكِبِ"]},{"verse_key":"37:7","text":"وَحِفظًا مِّن كُلِّ شَيطٰنٍ مَّارِدٍ","words":["وَحِفظًا","مِّن","كُلِّ","شَيطٰنٍ","مَّارِدٍ"]},{"verse_key":"37:8","text":"لَّا يَسَّمَّعُونَ اِلَى المَلَاِ الاَعلٰى وَيُقذَفُونَ مِن كُلِّ جَانِبٍ ","words":["لَّا","يَسَّمَّعُونَ","اِلَى","المَلَاِ","الاَعلٰى","وَيُقذَفُونَ","مِن","كُلِّ","جَانِبٍ "]},{"verse_key":"37:9","text":"دُحُورًا  وَّلَهُم عَذَابٌ وَّاصِبٌ  ","words":["دُحُورًا ","وَّلَهُم","عَذَابٌ","وَّاصِبٌ  "]},{"verse_key":"37:10","text":"اِلَّا مَن خَطِفَ الخَطفَةَ فَاَتبَعَهٗ شِهَابٌ ثَاقِبٌ","words":["اِلَّا","مَن","خَطِفَ","الخَطفَةَ","فَاَتبَعَهٗ","شِهَابٌ","ثَاقِبٌ"]},{"verse_key":"37:11","text":"فَاستَفتِهِم اَهُم اَشَدُّ خَلقًا اَم مَّن خَلَقنَاؕ اِنَّا خَلَقنٰهُم مِّن طِينٍ لَّازِبٍ","words":["فَاستَفتِهِم","اَهُم","اَشَدُّ","خَلقًا","اَم","مَّن","خَلَقنَاؕ","اِنَّا","خَلَقنٰهُم","مِّن","طِينٍ","لَّازِبٍ"]},{"verse_key":"37:12","text":"بَل عَجِبتَ وَيَسخَرُونَ","words":["بَل","عَجِبتَ","وَيَسخَرُونَ"]},{"verse_key":"37:13","text":"وَاِذَا ذُكِّرُوا لَا يَذكُرُونَ","words":["وَاِذَا","ذُكِّرُوا","لَا","يَذكُرُونَ"]},{"verse_key":"37:14","text":"وَاِذَا رَاَوا اٰيَةً يَّستَسخِرُونَ","words":["وَاِذَا","رَاَوا","اٰيَةً","يَّستَسخِرُونَ"]},{"verse_key":"37:15","text":"وَقَالُوا اِن هٰذَا اِلَّا سِحرٌ مُّبِينٌ ","words":["وَقَالُوا","اِن","هٰذَا","اِلَّا","سِحرٌ","مُّبِينٌ "]},{"verse_key":"37:16","text":"ءَاِذَا مِتنَا وَكُـنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبعُوثُونَ ","words":["ءَاِذَا","مِتنَا","وَكُـنَّا","تُرَابًا","وَّعِظَامًا","ءَاِنَّا","لَمَبعُوثُونَ "]},{"verse_key":"37:17","text":"اَوَاٰبَآؤُنَا الاَوَّلُونَؕ","words":["اَوَاٰبَآؤُنَا","الاَوَّلُونَؕ"]},{"verse_key":"37:18","text":"قُل نَعَم وَاَنـتُم دٰخِرُونَ","words":["قُل","نَعَم","وَاَنـتُم","دٰخِرُونَ"]},{"verse_key":"37:19","text":"فَاِنَّمَا هِىَ زَجرَةٌ وَّاحِدَةٌ فَاِذَا هُم يَنظُرُونَ","words":["فَاِنَّمَا","هِىَ","زَجرَةٌ","وَّاحِدَةٌ","فَاِذَا","هُم","يَنظُرُونَ"]},{"verse_key":"37:20","text":"وَقَالُوا يٰوَيلَنَا هٰذَا يَومُ الدِّينِ","words":["وَقَالُوا","يٰوَيلَنَا","هٰذَا","يَومُ","الدِّينِ"]},{"verse_key":"37:21","text":"هٰذَا يَومُ الفَصلِ الَّذِى كُنتُم بِهٖ تُكَذِّبُونَ","words":["هٰذَا","يَومُ","الفَصلِ","الَّذِى","كُنتُم","بِهٖ","تُكَذِّبُونَ"]},{"verse_key":"37:22","text":" اُحشُرُوا الَّذِينَ ظَلَمُوا وَاَزوَاجَهُم وَمَا كَانُوا يَعبُدُونَ ","words":[" اُحشُرُوا","الَّذِينَ","ظَلَمُوا","وَاَزوَاجَهُم","وَمَا","كَانُوا","يَعبُدُونَ "]},{"verse_key":"37:23","text":"مِن دُونِ اللّٰهِ فَاهدُوهُم اِلٰى صِرَاطِ الجَحِيمِ","words":["مِن","دُونِ","اللّٰهِ","فَاهدُوهُم","اِلٰى","صِرَاطِ","الجَحِيمِ"]},{"verse_key":"37:24","text":"وَقِفُوهُم اِنَّهُم مَّسْـُٔـولُونَ","words":["وَقِفُوهُم","اِنَّهُم","مَّسْـُٔـولُونَ"]},{"verse_key":"37:25","text":"مَا لَـكُم لَا تَنَاصَرُونَ","words":["مَا","لَـكُم","لَا","تَنَاصَرُونَ"]},{"verse_key":"37:26","text":"بَل هُمُ اليَومَ مُستَسلِمُونَ","words":["بَل","هُمُ","اليَومَ","مُستَسلِمُونَ"]},{"verse_key":"37:27","text":"وَاَقبَلَ بَعضُهُم عَلٰى بَعضٍ يَّتَسَآءَلُونَ","words":["وَاَقبَلَ","بَعضُهُم","عَلٰى","بَعضٍ","يَّتَسَآءَلُونَ"]},{"verse_key":"37:28","text":"قَالُوا اِنَّكُم كُنتُم تَاتُونَنَا عَنِ اليَمِينِ","words":["قَالُوا","اِنَّكُم","كُنتُم","تَاتُونَنَا","عَنِ","اليَمِينِ"]},{"verse_key":"37:29","text":"قَالُوا بَلْ لَّم تَكُونُوا مُؤمِنِينَ","words":["قَالُوا","بَلْ","لَّم","تَكُونُوا","مُؤمِنِينَ"]},{"verse_key":"37:30","text":"وَمَا كَانَ لَنَا عَلَيكُم مِّن سُلطٰنِ بَل كُنتُم قَومًا طٰغِينَ ","words":["وَمَا","كَانَ","لَنَا","عَلَيكُم","مِّن","سُلطٰنِ","بَل","كُنتُم","قَومًا","طٰغِينَ "]},{"verse_key":"37:31","text":"فَحَقَّ عَلَينَا قَولُ رَبِّنَآ  اِنَّا لَذَآٮِٕقُونَ","words":["فَحَقَّ","عَلَينَا","قَولُ","رَبِّنَآ ","اِنَّا","لَذَآٮِٕقُونَ"]},{"verse_key":"37:32","text":"فَاَغوَينٰكُم اِنَّا كُنَّا غٰوِينَ","words":["فَاَغوَينٰكُم","اِنَّا","كُنَّا","غٰوِينَ"]},{"verse_key":"37:33","text":"فَاِنَّهُم يَومَٮِٕذٍ فِى العَذَابِ مُشتَرِكُونَ","words":["فَاِنَّهُم","يَومَٮِٕذٍ","فِى","العَذَابِ","مُشتَرِكُونَ"]},{"verse_key":"37:34","text":"اِنَّا كَذٰلِكَ نَفعَلُ بِالمُجرِمِينَ","words":["اِنَّا","كَذٰلِكَ","نَفعَلُ","بِالمُجرِمِينَ"]},{"verse_key":"37:35","text":"اِنَّهُم كَانُوا اِذَا قِيلَ لَهُم لَا اِلٰهَ اِلَّا اللّٰهُ يَستَكبِرُونَ ","words":["اِنَّهُم","كَانُوا","اِذَا","قِيلَ","لَهُم","لَا","اِلٰهَ","اِلَّا","اللّٰهُ","يَستَكبِرُونَ "]},{"verse_key":"37:36","text":"وَيَقُولُونَ اَٮِٕنَّا لَتٰرِكُوا اٰلِهَـتِنَا لِشَاعِرٍ مَّجـنُونٍ ؕ","words":["وَيَقُولُونَ","اَٮِٕنَّا","لَتٰرِكُوا","اٰلِهَـتِنَا","لِشَاعِرٍ","مَّجـنُونٍ ؕ"]},{"verse_key":"37:37","text":"بَل جَآءَ بِالحَقِّ وَصَدَّقَ المُرسَلِينَ","words":["بَل","جَآءَ","بِالحَقِّ","وَصَدَّقَ","المُرسَلِينَ"]},{"verse_key":"37:38","text":"اِنَّكُم لَذَآٮِٕقُوا العَذَابِ الاَلِيمِ","words":["اِنَّكُم","لَذَآٮِٕقُوا","العَذَابِ","الاَلِيمِ"]},{"verse_key":"37:39","text":"وَمَا تُجزَونَ اِلَّا مَا كُنتُم تَعمَلُونَ","words":["وَمَا","تُجزَونَ","اِلَّا","مَا","كُنتُم","تَعمَلُونَ"]},{"verse_key":"37:40","text":"اِلَّا عِبَادَ اللّٰهِ المُخلَصِينَ","words":["اِلَّا","عِبَادَ","اللّٰهِ","المُخلَصِينَ"]},{"verse_key":"37:41","text":"اُولٰٓٮِٕكَ لَهُم رِزقٌ مَّعلُومٌ","words":["اُولٰٓٮِٕكَ","لَهُم","رِزقٌ","مَّعلُومٌ"]},{"verse_key":"37:42","text":"فَوَاكِهُ وَهُم مُّكرَمُونَ","words":["فَوَاكِهُ","وَهُم","مُّكرَمُونَ"]},{"verse_key":"37:43","text":"فِى جَنّٰتِ النَّعِيمِ","words":["فِى","جَنّٰتِ","النَّعِيمِ"]},{"verse_key":"37:44","text":"عَلٰى سُرُرٍ مُّتَقٰبِلِينَ","words":["عَلٰى","سُرُرٍ","مُّتَقٰبِلِينَ"]},{"verse_key":"37:45","text":"يُطَافُ عَلَيهِم بِكَاسٍ مِّن مَّعِينٍ ","words":["يُطَافُ","عَلَيهِم","بِكَاسٍ","مِّن","مَّعِينٍ "]},{"verse_key":"37:46","text":"بَيضَآءَ لَذَّةٍ لِّلشّٰرِبِينَ ","words":["بَيضَآءَ","لَذَّةٍ","لِّلشّٰرِبِينَ "]},{"verse_key":"37:47","text":"لَا فِيهَا غَولٌ وَّلَا هُم عَنهَا يُنزَفُونَ","words":["لَا","فِيهَا","غَولٌ","وَّلَا","هُم","عَنهَا","يُنزَفُونَ"]},{"verse_key":"37:48","text":"وَعِندَهُم قٰصِرٰتُ الطَّرفِ عِينٌ","words":["وَعِندَهُم","قٰصِرٰتُ","الطَّرفِ","عِينٌ"]},{"verse_key":"37:49","text":"كَاَنَّهُنَّ بَيضٌ مَّكنُونٌ","words":["كَاَنَّهُنَّ","بَيضٌ","مَّكنُونٌ"]},{"verse_key":"37:50","text":"فَاَقبَلَ بَعضُهُم عَلٰى بَعضٍ يَّتَسَآءَلُونَ","words":["فَاَقبَلَ","بَعضُهُم","عَلٰى","بَعضٍ","يَّتَسَآءَلُونَ"]},{"verse_key":"37:51","text":"قَالَ قَآٮِٕلٌ مِّنهُم اِنِّى كَانَ لِى قَرِينٌ","words":["قَالَ","قَآٮِٕلٌ","مِّنهُم","اِنِّى","كَانَ","لِى","قَرِينٌ"]},{"verse_key":"37:52","text":"يَقُولُ اَءِ نَّكَ لَمِنَ المُصَدِّقِينَ","words":["يَقُولُ","اَءِ نَّكَ","لَمِنَ","المُصَدِّقِينَ"]},{"verse_key":"37:53","text":"ءَاِذَا مِتنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَدِينُونَ","words":["ءَاِذَا","مِتنَا","وَكُنَّا","تُرَابًا","وَّعِظَامًا","ءَاِنَّا","لَمَدِينُونَ"]},{"verse_key":"37:54","text":"قَالَ هَل اَنتُم مُّطَّلِعُونَ","words":["قَالَ","هَل","اَنتُم","مُّطَّلِعُونَ"]},{"verse_key":"37:55","text":"فَاطَّلَعَ فَرَاٰهُ فِى سَوَآءِ الجَحِيمِ","words":["فَاطَّلَعَ","فَرَاٰهُ","فِى","سَوَآءِ","الجَحِيمِ"]},{"verse_key":"37:56","text":"قَالَ تَاللّٰهِ اِن كِدْتَّ لَـتُردِينِ","words":["قَالَ","تَاللّٰهِ","اِن","كِدْتَّ","لَـتُردِينِ"]},{"verse_key":"37:57","text":"وَلَولَا نِعمَةُ رَبِّى لَـكُنتُ مِنَ المُحضَرِينَ","words":["وَلَولَا","نِعمَةُ","رَبِّى","لَـكُنتُ","مِنَ","المُحضَرِينَ"]},{"verse_key":"37:58","text":"اَفَمَا نَحنُ بِمَيِّتِينَ","words":["اَفَمَا","نَحنُ","بِمَيِّتِينَ"]},{"verse_key":"37:59","text":"اِلَّا مَوتَتَـنَا الاُولٰى وَمَا نَحنُ بِمُعَذَّبِينَ","words":["اِلَّا","مَوتَتَـنَا","الاُولٰى","وَمَا","نَحنُ","بِمُعَذَّبِينَ"]},{"verse_key":"37:60","text":"اِنَّ هٰذَا لَهُوَ الفَوزُ العَظِيمُ","words":["اِنَّ","هٰذَا","لَهُوَ","الفَوزُ","العَظِيمُ"]},{"verse_key":"37:61","text":"لِمِثلِ هٰذَا فَليَعمَلِ العٰمِلُونَ","words":["لِمِثلِ","هٰذَا","فَليَعمَلِ","العٰمِلُونَ"]},{"verse_key":"37:62","text":"اَذٰ لِكَ خَيرٌ نُّزُلًا اَم شَجَرَةُ الزَّقُّومِ","words":["اَذٰ لِكَ","خَيرٌ","نُّزُلًا","اَم","شَجَرَةُ","الزَّقُّومِ"]},{"verse_key":"37:63","text":"اِنَّا جَعَلنٰهَا فِتنَةً لِّلظّٰلِمِينَ","words":["اِنَّا","جَعَلنٰهَا","فِتنَةً","لِّلظّٰلِمِينَ"]},{"verse_key":"37:64","text":"اِنَّهَا شَجَرَةٌ تَخرُجُ فِى اَصلِ الجَحِيمِ","words":["اِنَّهَا","شَجَرَةٌ","تَخرُجُ","فِى","اَصلِ","الجَحِيمِ"]},{"verse_key":"37:65","text":"طَلعُهَا كَاَنَّهٗ رُءُوسُ الشَّيٰطِينِ","words":["طَلعُهَا","كَاَنَّهٗ","رُءُوسُ","الشَّيٰطِينِ"]},{"verse_key":"37:66","text":"فَاِنَّهُم لَاٰكِلُونَ مِنهَا فَمٰلِــُٔــونَ مِنهَا البُطُونَ ؕ ","words":["فَاِنَّهُم","لَاٰكِلُونَ","مِنهَا","فَمٰلِــُٔــونَ","مِنهَا","البُطُونَ ؕ "]},{"verse_key":"37:67","text":"ثُمَّ اِنَّ لَهُم عَلَيهَا لَشَوبًا مِّن حَمِيمٍ","words":["ثُمَّ","اِنَّ","لَهُم","عَلَيهَا","لَشَوبًا","مِّن","حَمِيمٍ"]},{"verse_key":"37:68","text":"ثُمَّ اِنَّ مَرجِعَهُم لَااِلَى الجَحِيمِ","words":["ثُمَّ","اِنَّ","مَرجِعَهُم","لَااِلَى","الجَحِيمِ"]},{"verse_key":"37:69","text":"اِنَّهُم اَلفَوا اٰبَآءَهُم ضَآلِّينَ","words":["اِنَّهُم","اَلفَوا","اٰبَآءَهُم","ضَآلِّينَ"]},{"verse_key":"37:70","text":"فَهُم عَلٰٓى اٰثٰرِهِم يُهرَعُونَ","words":["فَهُم","عَلٰٓى","اٰثٰرِهِم","يُهرَعُونَ"]},{"verse_key":"37:71","text":"وَلَـقَد ضَلَّ قَبلَهُم اَكثَرُ الاَوَّلِينَ","words":["وَلَـقَد","ضَلَّ","قَبلَهُم","اَكثَرُ","الاَوَّلِينَ"]},{"verse_key":"37:72","text":"وَلَقَد اَرسَلنَا فِيهِم مُّنذِرِينَ","words":["وَلَقَد","اَرسَلنَا","فِيهِم","مُّنذِرِينَ"]},{"verse_key":"37:73","text":"فَانْظُر كَيفَ كَانَ عَاقِبَةُ المُنذَرِينَ","words":["فَانْظُر","كَيفَ","كَانَ","عَاقِبَةُ","المُنذَرِينَ"]},{"verse_key":"37:74","text":"اِلَّا عِبَادَ اللّٰهِ المُخلَصِينَ","words":["اِلَّا","عِبَادَ","اللّٰهِ","المُخلَصِينَ"]},{"verse_key":"37:75","text":"وَلَقَد نَادٰٮنَا نُوحٌ فَلَنِعمَ المُجِيبُونَ  ","words":["وَلَقَد","نَادٰٮنَا","نُوحٌ","فَلَنِعمَ","المُجِيبُونَ  "]},{"verse_key":"37:76","text":"وَنَجَّينٰهُ وَاَهلَهٗ مِنَ الكَربِ العَظِيمِ  ","words":["وَنَجَّينٰهُ","وَاَهلَهٗ","مِنَ","الكَربِ","العَظِيمِ  "]},{"verse_key":"37:77","text":"وَجَعَلنَا ذُرِّيَّتَهٗ هُمُ البٰقِينَ  ","words":["وَجَعَلنَا","ذُرِّيَّتَهٗ","هُمُ","البٰقِينَ  "]},{"verse_key":"37:78","text":"وَتَرَكنَا عَلَيهِ فِى الاٰخِرِينَ  ","words":["وَتَرَكنَا","عَلَيهِ","فِى","الاٰخِرِينَ  "]},{"verse_key":"37:79","text":"سَلٰمٌ عَلٰى نُوحٍ فِى العٰلَمِينَ","words":["سَلٰمٌ","عَلٰى","نُوحٍ","فِى","العٰلَمِينَ"]},{"verse_key":"37:80","text":"اِنَّا كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["اِنَّا","كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"37:81","text":"اِنَّهٗ مِن عِبَادِنَا المُؤمِنِينَ","words":["اِنَّهٗ","مِن","عِبَادِنَا","المُؤمِنِينَ"]},{"verse_key":"37:82","text":"ثُمَّ اَغرَقنَا الاٰخَرِينَ","words":["ثُمَّ","اَغرَقنَا","الاٰخَرِينَ"]},{"verse_key":"37:83","text":" وَاِنَّ مِن شِيعَتِهٖ لَاِبرٰهِيمَ","words":[" وَاِنَّ","مِن","شِيعَتِهٖ","لَاِبرٰهِيمَ"]},{"verse_key":"37:84","text":"اِذ جَآءَ رَبَّهٗ بِقَلبٍ سَلِيمٍ","words":["اِذ","جَآءَ","رَبَّهٗ","بِقَلبٍ","سَلِيمٍ"]},{"verse_key":"37:85","text":"اِذ قَالَ لِاَبِيهِ وَقَومِهٖ مَاذَا تَعبُدُونَ","words":["اِذ","قَالَ","لِاَبِيهِ","وَقَومِهٖ","مَاذَا","تَعبُدُونَ"]},{"verse_key":"37:86","text":"اَٮِٕفكًا اٰلِهَةً دُونَ اللّٰهِ تُرِيدُونَؕ","words":["اَٮِٕفكًا","اٰلِهَةً","دُونَ","اللّٰهِ","تُرِيدُونَؕ"]},{"verse_key":"37:87","text":"فَمَا ظَنُّكُم بِرَبِّ العٰلَمِينَ","words":["فَمَا","ظَنُّكُم","بِرَبِّ","العٰلَمِينَ"]},{"verse_key":"37:88","text":"فَنَظَرَ نَظرَةً فِى النُّجُومِ","words":["فَنَظَرَ","نَظرَةً","فِى","النُّجُومِ"]},{"verse_key":"37:89","text":"فَقَالَ اِنِّى سَقِيمٌ","words":["فَقَالَ","اِنِّى","سَقِيمٌ"]},{"verse_key":"37:90","text":"فَتَوَلَّوا عَنهُ مُدبِرِينَ","words":["فَتَوَلَّوا","عَنهُ","مُدبِرِينَ"]},{"verse_key":"37:91","text":"فَرَاغَ اِلٰٓى اٰلِهَتِهِم فَقَالَ اَلَا تَاكُلُونَ","words":["فَرَاغَ","اِلٰٓى","اٰلِهَتِهِم","فَقَالَ","اَلَا","تَاكُلُونَ"]},{"verse_key":"37:92","text":"مَا لَـكُم لَا تَنطِقُونَ","words":["مَا","لَـكُم","لَا","تَنطِقُونَ"]},{"verse_key":"37:93","text":"فَرَاغَ عَلَيهِم ضَربًا بِاليَمِينِ","words":["فَرَاغَ","عَلَيهِم","ضَربًا","بِاليَمِينِ"]},{"verse_key":"37:94","text":"فَاَقبَلُوا اِلَيهِ يَزِفُّونَ","words":["فَاَقبَلُوا","اِلَيهِ","يَزِفُّونَ"]},{"verse_key":"37:95","text":"قَالَ اَتَعبُدُونَ مَا تَنحِتُونَ","words":["قَالَ","اَتَعبُدُونَ","مَا","تَنحِتُونَ"]},{"verse_key":"37:96","text":"وَاللّٰهُ خَلَقَكُم وَمَا تَعمَلُونَ","words":["وَاللّٰهُ","خَلَقَكُم","وَمَا","تَعمَلُونَ"]},{"verse_key":"37:97","text":"قَالُوا ابنُوا لَهٗ بُنيَانًا فَاَلقُوهُ فِى الجَحِيمِ","words":["قَالُوا","ابنُوا","لَهٗ","بُنيَانًا","فَاَلقُوهُ","فِى","الجَحِيمِ"]},{"verse_key":"37:98","text":"فَاَرَادُوا بِهٖ كَيدًا فَجَعَلنٰهُمُ الاَسفَلِينَ","words":["فَاَرَادُوا","بِهٖ","كَيدًا","فَجَعَلنٰهُمُ","الاَسفَلِينَ"]},{"verse_key":"37:99","text":"وَقَالَ اِنِّى ذَاهِبٌ اِلٰى رَبِّى سَيَهدِينِ","words":["وَقَالَ","اِنِّى","ذَاهِبٌ","اِلٰى","رَبِّى","سَيَهدِينِ"]},{"verse_key":"37:100","text":"رَبِّ هَب لِى مِنَ الصّٰلِحِينَ","words":["رَبِّ","هَب","لِى","مِنَ","الصّٰلِحِينَ"]},{"verse_key":"37:101","text":"فَبَشَّرنٰهُ بِغُلٰمٍ حَلِيمٍ","words":["فَبَشَّرنٰهُ","بِغُلٰمٍ","حَلِيمٍ"]},{"verse_key":"37:102","text":"فَلَمَّا بَلَغَ مَعَهُ السَّعىَ قَالَ يٰبُنَىَّ اِنِّى اَرٰى فِى المَنَامِ اَنِّى اَذبَحُكَ فَانْظُر مَاذَا تَرٰىؕ قَالَ يٰاَبَتِ افعَل مَا تُؤمَرُ سَتَجِدُنِى اِن شَآءَ اللّٰهُ مِنَ الصّٰبِرِينَ","words":["فَلَمَّا","بَلَغَ","مَعَهُ","السَّعىَ","قَالَ","يٰبُنَىَّ","اِنِّى","اَرٰى","فِى","المَنَامِ","اَنِّى","اَذبَحُكَ","فَانْظُر","مَاذَا","تَرٰىؕ","قَالَ","يٰاَبَتِ","افعَل","مَا","تُؤمَرُ","سَتَجِدُنِى","اِن","شَآءَ","اللّٰهُ","مِنَ","الصّٰبِرِينَ"]},{"verse_key":"37:103","text":"فَلَمَّا اَسلَمَا وَتَلَّهٗ لِلجَبِينِ","words":["فَلَمَّا","اَسلَمَا","وَتَلَّهٗ","لِلجَبِينِ"]},{"verse_key":"37:104","text":"وَنَادَينٰهُ اَن يّٰاِبرٰهِيمُ","words":["وَنَادَينٰهُ","اَن","يّٰاِبرٰهِيمُ"]},{"verse_key":"37:105","text":"قَد صَدَّقتَ الرُّءيَا   اِنَّا كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["قَد","صَدَّقتَ","الرُّءيَا  ","اِنَّا","كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"37:106","text":"اِنَّ هٰذَا لَهُوَ البَلٰٓؤُا المُبِينُ","words":["اِنَّ","هٰذَا","لَهُوَ","البَلٰٓؤُا","المُبِينُ"]},{"verse_key":"37:107","text":"وَفَدَينٰهُ بِذِبحٍ عَظِيمٍ","words":["وَفَدَينٰهُ","بِذِبحٍ","عَظِيمٍ"]},{"verse_key":"37:108","text":"وَتَرَكنَا عَلَيهِ فِى الاٰخِرِينَ","words":["وَتَرَكنَا","عَلَيهِ","فِى","الاٰخِرِينَ"]},{"verse_key":"37:109","text":"سَلٰمٌ عَلٰٓى اِبرٰهِيمَ","words":["سَلٰمٌ","عَلٰٓى","اِبرٰهِيمَ"]},{"verse_key":"37:110","text":"كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"37:111","text":"اِنَّهٗ مِن عِبَادِنَا المُؤمِنِينَ","words":["اِنَّهٗ","مِن","عِبَادِنَا","المُؤمِنِينَ"]},{"verse_key":"37:112","text":"وَبَشَّرنٰهُ بِاِسحٰقَ نَبِيًّا مِّنَ الصّٰلِحِينَ","words":["وَبَشَّرنٰهُ","بِاِسحٰقَ","نَبِيًّا","مِّنَ","الصّٰلِحِينَ"]},{"verse_key":"37:113","text":"وَبٰرَكنَا عَلَيهِ وَعَلٰٓى اِسحٰقَؕ وَ مِن ذُرِّيَّتِهِمَا مُحسِنٌ وَّظَالِمٌ لِّنَفسِهٖ مُبِينٌ","words":["وَبٰرَكنَا","عَلَيهِ","وَعَلٰٓى","اِسحٰقَؕ","وَ مِن","ذُرِّيَّتِهِمَا","مُحسِنٌ","وَّظَالِمٌ","لِّنَفسِهٖ","مُبِينٌ"]},{"verse_key":"37:114","text":"وَلَقَد مَنَنَّا عَلٰى مُوسٰى وَهٰرُونَ","words":["وَلَقَد","مَنَنَّا","عَلٰى","مُوسٰى","وَهٰرُونَ"]},{"verse_key":"37:115","text":"وَنَجَّينٰهُمَا وَقَومَهُمَا مِنَ الكَربِ العَظِيمِ","words":["وَنَجَّينٰهُمَا","وَقَومَهُمَا","مِنَ","الكَربِ","العَظِيمِ"]},{"verse_key":"37:116","text":"وَنَصَرنٰهُم فَكَانُوا هُمُ الغٰلِبِينَ","words":["وَنَصَرنٰهُم","فَكَانُوا","هُمُ","الغٰلِبِينَ"]},{"verse_key":"37:117","text":"وَاٰتَينٰهُمَا الكِتٰبَ المُستَبِينَ","words":["وَاٰتَينٰهُمَا","الكِتٰبَ","المُستَبِينَ"]},{"verse_key":"37:118","text":"وَهَدَينٰهُمَا الصِّرَاطَ المُستَقِيمَ","words":["وَهَدَينٰهُمَا","الصِّرَاطَ","المُستَقِيمَ"]},{"verse_key":"37:119","text":"وَتَرَكنَا عَلَيهِمَا فِى الاٰخِرِينَ","words":["وَتَرَكنَا","عَلَيهِمَا","فِى","الاٰخِرِينَ"]},{"verse_key":"37:120","text":"سَلٰمٌ عَلٰى مُوسٰى وَهٰرُونَ","words":["سَلٰمٌ","عَلٰى","مُوسٰى","وَهٰرُونَ"]},{"verse_key":"37:121","text":"اِنَّا كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["اِنَّا","كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"37:122","text":"اِنَّهُمَا مِن عِبَادِنَا المُؤمِنِينَ","words":["اِنَّهُمَا","مِن","عِبَادِنَا","المُؤمِنِينَ"]},{"verse_key":"37:123","text":"وَاِنَّ اِليَاسَ لَمِنَ المُرسَلِينَؕ","words":["وَاِنَّ","اِليَاسَ","لَمِنَ","المُرسَلِينَؕ"]},{"verse_key":"37:124","text":"اِذ قَالَ لِقَومِهٖ اَلَا تَتَّقُونَ","words":["اِذ","قَالَ","لِقَومِهٖ","اَلَا","تَتَّقُونَ"]},{"verse_key":"37:125","text":"اَتَدعُونَ بَعلًا وَّتَذَرُونَ اَحسَنَ الخٰلِقِينَ","words":["اَتَدعُونَ","بَعلًا","وَّتَذَرُونَ","اَحسَنَ","الخٰلِقِينَ"]},{"verse_key":"37:126","text":"اللّٰهَ رَبَّكُم وَرَبَّ اٰبَآٮِٕكُمُ الاَوَّلِينَ","words":["اللّٰهَ","رَبَّكُم","وَرَبَّ","اٰبَآٮِٕكُمُ","الاَوَّلِينَ"]},{"verse_key":"37:127","text":"فَكَذَّبُوهُ فَاِنَّهُم لَمُحضَرُونَ","words":["فَكَذَّبُوهُ","فَاِنَّهُم","لَمُحضَرُونَ"]},{"verse_key":"37:128","text":"اِلَّا عِبَادَ اللّٰهِ المُخلَصِينَ","words":["اِلَّا","عِبَادَ","اللّٰهِ","المُخلَصِينَ"]},{"verse_key":"37:129","text":"وَتَرَكنَا عَلَيهِ فِى الاٰخِرِينَ","words":["وَتَرَكنَا","عَلَيهِ","فِى","الاٰخِرِينَ"]},{"verse_key":"37:130","text":"سَلٰمٌ عَلٰٓى اِل يَاسِينَ","words":["سَلٰمٌ","عَلٰٓى","اِل يَاسِينَ"]},{"verse_key":"37:131","text":"اِنَّا كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["اِنَّا","كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"37:132","text":"اِنَّهٗ مِن عِبَادِنَا المُؤمِنِينَ","words":["اِنَّهٗ","مِن","عِبَادِنَا","المُؤمِنِينَ"]},{"verse_key":"37:133","text":"وَاِنَّ لُوطًا لَّمِنَ المُرسَلِينَؕ","words":["وَاِنَّ","لُوطًا","لَّمِنَ","المُرسَلِينَؕ"]},{"verse_key":"37:134","text":"اِذ نَجَّينٰهُ وَاَهلَهٗ اَجمَعِينَ","words":["اِذ","نَجَّينٰهُ","وَاَهلَهٗ","اَجمَعِينَ"]},{"verse_key":"37:135","text":"اِلَّا عَجُوزًا فِى الغٰبِرِينَ","words":["اِلَّا","عَجُوزًا","فِى","الغٰبِرِينَ"]},{"verse_key":"37:136","text":"ثُمَّ دَمَّرنَا الاٰخَرِينَ","words":["ثُمَّ","دَمَّرنَا","الاٰخَرِينَ"]},{"verse_key":"37:137","text":"وَاِنَّكُم لَتَمُرُّونَ عَلَيهِم مُّصبِحِينَ","words":["وَاِنَّكُم","لَتَمُرُّونَ","عَلَيهِم","مُّصبِحِينَ"]},{"verse_key":"37:138","text":"وَبِالَّيلِؕ اَفَلَا تَعقِلُونَ","words":["وَبِالَّيلِؕ","اَفَلَا","تَعقِلُونَ"]},{"verse_key":"37:139","text":"وَاِنَّ يُونُسَ لَمِنَ المُرسَلِينَؕ","words":["وَاِنَّ","يُونُسَ","لَمِنَ","المُرسَلِينَؕ"]},{"verse_key":"37:140","text":"اِذ اَبَقَ اِلَى الفُلكِ المَشحُونِ","words":["اِذ","اَبَقَ","اِلَى","الفُلكِ","المَشحُونِ"]},{"verse_key":"37:141","text":"فَسَاهَمَ فَكَانَ مِنَ المُدحَضِينَ","words":["فَسَاهَمَ","فَكَانَ","مِنَ","المُدحَضِينَ"]},{"verse_key":"37:142","text":"فَالتَقَمَهُ الحُوتُ وَهُوَ مُلِيمٌ","words":["فَالتَقَمَهُ","الحُوتُ","وَهُوَ","مُلِيمٌ"]},{"verse_key":"37:143","text":"فَلَولَا اَنَّهٗ كَانَ مِنَ المُسَبِّحِينَ","words":["فَلَولَا","اَنَّهٗ","كَانَ","مِنَ","المُسَبِّحِينَ"]},{"verse_key":"37:144","text":"لَلَبِثَ فِى بَطنِهٖ اِلٰى يَومِ يُبعَثُونَ","words":["لَلَبِثَ","فِى","بَطنِهٖ","اِلٰى","يَومِ","يُبعَثُونَ"]},{"verse_key":"37:145","text":" فَنَبَذنٰهُ بِالعَرَآءِ وَهُوَ سَقِيمٌ","words":[" فَنَبَذنٰهُ","بِالعَرَآءِ","وَهُوَ","سَقِيمٌ"]},{"verse_key":"37:146","text":"وَاَنبَتنَا عَلَيهِ شَجَرَةً مِّن يَّقطِينٍ","words":["وَاَنبَتنَا","عَلَيهِ","شَجَرَةً","مِّن","يَّقطِينٍ"]},{"verse_key":"37:147","text":"وَاَرسَلنٰهُ اِلٰى مِائَةِ اَلفٍ اَو يَزِيدُونَ","words":["وَاَرسَلنٰهُ","اِلٰى","مِائَةِ","اَلفٍ","اَو","يَزِيدُونَ"]},{"verse_key":"37:148","text":"فَاٰمَنُوا فَمَتَّعنٰهُم اِلٰى حِينٍؕ","words":["فَاٰمَنُوا","فَمَتَّعنٰهُم","اِلٰى","حِينٍؕ"]},{"verse_key":"37:149","text":"فَاستَفتِهِم اَلِرَبِّكَ البَنَاتُ وَلَهُمُ البَنُونَ","words":["فَاستَفتِهِم","اَلِرَبِّكَ","البَنَاتُ","وَلَهُمُ","البَنُونَ"]},{"verse_key":"37:150","text":"اَم خَلَقنَا المَلٰٓٮِٕكَةَ اِنَاثًا وَّهُم شٰهِدُونَ","words":["اَم","خَلَقنَا","المَلٰٓٮِٕكَةَ","اِنَاثًا","وَّهُم","شٰهِدُونَ"]},{"verse_key":"37:151","text":"اَلَا اِنَّهُم مِّن اِفكِهِم لَيَقُولُونَ","words":["اَلَا","اِنَّهُم","مِّن","اِفكِهِم","لَيَقُولُونَ"]},{"verse_key":"37:152","text":"وَلَدَ اللّٰهُ وَاِنَّهُم لَـكٰذِبُونَ","words":["وَلَدَ","اللّٰهُ","وَاِنَّهُم","لَـكٰذِبُونَ"]},{"verse_key":"37:153","text":"اَصطَفَى البَنَاتِ عَلَى البَنِينَؕ","words":["اَصطَفَى","البَنَاتِ","عَلَى","البَنِينَؕ"]},{"verse_key":"37:154","text":"مَا لَـكُم كَيفَ تَحكُمُونَ","words":["مَا","لَـكُم","كَيفَ","تَحكُمُونَ"]},{"verse_key":"37:155","text":"اَفَلَا تَذَكَّرُونَ","words":["اَفَلَا","تَذَكَّرُونَ"]},{"verse_key":"37:156","text":"اَم لَـكُم سُلطٰنٌ مُّبِينٌ","words":["اَم","لَـكُم","سُلطٰنٌ","مُّبِينٌ"]},{"verse_key":"37:157","text":"فَاتُوا بِكِتٰبِكُم اِن كُنتُم صٰدِقِينَ","words":["فَاتُوا","بِكِتٰبِكُم","اِن","كُنتُم","صٰدِقِينَ"]},{"verse_key":"37:158","text":"وَجَعَلُوا بَينَهٗ وَبَينَ الجِنَّةِ نَسَبًا ؕ وَلَقَد عَلِمَتِ الجِنَّةُ اِنَّهُم لَمُحضَرُونَ","words":["وَجَعَلُوا","بَينَهٗ","وَبَينَ","الجِنَّةِ","نَسَبًا ؕ","وَلَقَد","عَلِمَتِ","الجِنَّةُ","اِنَّهُم","لَمُحضَرُونَ"]},{"verse_key":"37:159","text":"سُبحٰنَ اللّٰهِ عَمَّا يَصِفُونَ","words":["سُبحٰنَ","اللّٰهِ","عَمَّا","يَصِفُونَ"]},{"verse_key":"37:160","text":"اِلَّا عِبَادَ اللّٰهِ المُخلَصِينَ","words":["اِلَّا","عِبَادَ","اللّٰهِ","المُخلَصِينَ"]},{"verse_key":"37:161","text":"فَاِنَّكُم وَمَا تَعبُدُونَ","words":["فَاِنَّكُم","وَمَا","تَعبُدُونَ"]},{"verse_key":"37:162","text":"مَا اَنـتُم عَلَيهِ بِفٰتِنِينَ","words":["مَا","اَنـتُم","عَلَيهِ","بِفٰتِنِينَ"]},{"verse_key":"37:163","text":"اِلَّا مَن هُوَ صَالِ الجَحِيمِ","words":["اِلَّا","مَن","هُوَ","صَالِ","الجَحِيمِ"]},{"verse_key":"37:164","text":"وَمَا مِنَّا اِلَّا لَهٗ مَقَامٌ مَّعلُومٌ","words":["وَمَا","مِنَّا","اِلَّا","لَهٗ","مَقَامٌ","مَّعلُومٌ"]},{"verse_key":"37:165","text":"وَّاِنَّا لَـنَحنُ الصَّآفُّونَ","words":["وَّاِنَّا","لَـنَحنُ","الصَّآفُّونَ"]},{"verse_key":"37:166","text":"وَاِنَّا لَـنَحنُ المُسَبِّحُونَ","words":["وَاِنَّا","لَـنَحنُ","المُسَبِّحُونَ"]},{"verse_key":"37:167","text":"وَاِن كَانُوا لَيَقُولُونَ","words":["وَاِن","كَانُوا","لَيَقُولُونَ"]},{"verse_key":"37:168","text":"لَو اَنَّ عِندَنَا ذِكرًا مِّنَ الاَوَّلِينَ","words":["لَو","اَنَّ","عِندَنَا","ذِكرًا","مِّنَ","الاَوَّلِينَ"]},{"verse_key":"37:169","text":"لَـكُنَّا عِبَادَ اللّٰهِ المُخلَصِينَ","words":["لَـكُنَّا","عِبَادَ","اللّٰهِ","المُخلَصِينَ"]},{"verse_key":"37:170","text":"فَكَفَرُوا بِهٖ فَسَوفَ يَعلَمُونَ","words":["فَكَفَرُوا","بِهٖ","فَسَوفَ","يَعلَمُونَ"]},{"verse_key":"37:171","text":"وَلَقَد سَبَقَت كَلِمَتُنَا لِعِبَادِنَا المُرسَلِينَ ","words":["وَلَقَد","سَبَقَت","كَلِمَتُنَا","لِعِبَادِنَا","المُرسَلِينَ "]},{"verse_key":"37:172","text":"اِنَّهُم لَهُمُ المَنصُورُونَ ","words":["اِنَّهُم","لَهُمُ","المَنصُورُونَ "]},{"verse_key":"37:173","text":"وَاِنَّ جُندَنَا لَهُمُ الغٰلِبُونَ","words":["وَاِنَّ","جُندَنَا","لَهُمُ","الغٰلِبُونَ"]},{"verse_key":"37:174","text":"فَتَوَلَّ عَنهُم حَتّٰى حِينٍ","words":["فَتَوَلَّ","عَنهُم","حَتّٰى","حِينٍ"]},{"verse_key":"37:175","text":"وَاَبصِرهُم فَسَوفَ يُبصِرُونَ","words":["وَاَبصِرهُم","فَسَوفَ","يُبصِرُونَ"]},{"verse_key":"37:176","text":"اَفَبِعَذَابِنَا يَستَعجِلُونَ","words":["اَفَبِعَذَابِنَا","يَستَعجِلُونَ"]},{"verse_key":"37:177","text":"فَاِذَا نَزَلَ بِسَاحَتِهِم فَسَآءَ صَبَاحُ المُنذَرِينَ","words":["فَاِذَا","نَزَلَ","بِسَاحَتِهِم","فَسَآءَ","صَبَاحُ","المُنذَرِينَ"]},{"verse_key":"37:178","text":"وَتَوَلَّ عَنهُم حَتّٰى حِينٍ","words":["وَتَوَلَّ","عَنهُم","حَتّٰى","حِينٍ"]},{"verse_key":"37:179","text":"وَّاَبصِر فَسَوفَ يُبصِرُونَ","words":["وَّاَبصِر","فَسَوفَ","يُبصِرُونَ"]},{"verse_key":"37:180","text":"سُبحٰنَ رَبِّكَ رَبِّ العِزَّةِ عَمَّا يَصِفُونَ","words":["سُبحٰنَ","رَبِّكَ","رَبِّ","العِزَّةِ","عَمَّا","يَصِفُونَ"]},{"verse_key":"37:181","text":"وَسَلٰمٌ عَلَى المُرسَلِينَ","words":["وَسَلٰمٌ","عَلَى","المُرسَلِينَ"]},{"verse_key":"37:182","text":"وَالحَمدُ لِلّٰهِ رَبِّ العٰلَمِينَ","words":["وَالحَمدُ","لِلّٰهِ","رَبِّ","العٰلَمِينَ"]}]}