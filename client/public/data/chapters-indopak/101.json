{"verses":[{"verse_key":"101:1","text":"اَلقَارِعَةُ ","words":["اَلقَارِعَةُ "]},{"verse_key":"101:2","text":"مَا القَارِعَةُ ","words":["مَا","القَارِعَةُ "]},{"verse_key":"101:3","text":"وَمَا اَدرٰٮكَ مَا القَارِعَةُ ؕ","words":["وَمَا","اَدرٰٮكَ","مَا","القَارِعَةُ ؕ"]},{"verse_key":"101:4","text":"يَومَ يَكُونُ النَّاسُ كَالفَرَاشِ المَبثُوثِ","words":["يَومَ","يَكُونُ","النَّاسُ","كَالفَرَاشِ","المَبثُوثِ"]},{"verse_key":"101:5","text":"وَتَكُونُ الجِبَالُ كَالعِهنِ المَنفُوشِؕ","words":["وَتَكُونُ","الجِبَالُ","كَالعِهنِ","المَنفُوشِؕ"]},{"verse_key":"101:6","text":"فَاَمَّا مَن ثَقُلَت مَوَازِينُهٗ ","words":["فَاَمَّا","مَن","ثَقُلَت","مَوَازِينُهٗ "]},{"verse_key":"101:7","text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ ؕ","words":["فَهُوَ","فِى","عِيشَةٍ","رَّاضِيَةٍ ؕ"]},{"verse_key":"101:8","text":"وَاَمَّا مَن خَفَّت مَوَازِينُهٗ ","words":["وَاَمَّا","مَن","خَفَّت","مَوَازِينُهٗ "]},{"verse_key":"101:9","text":"فَاُمُّهٗ هَاوِيَةٌ ؕ","words":["فَاُمُّهٗ","هَاوِيَةٌ ؕ"]},{"verse_key":"101:10","text":"وَمَا اَدرٰٮكَ مَا هِيَه ؕ","words":["وَمَا","اَدرٰٮكَ","مَا","هِيَه ؕ"]},{"verse_key":"101:11","text":"نَارٌ حَامِيَةٌ","words":["نَارٌ","حَامِيَةٌ"]}]}