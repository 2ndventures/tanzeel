{"verses":[{"verse_key":"74:1","text":"يٰاَيُّهَا المُدَّثِّرُ","words":["يٰاَيُّهَا","المُدَّثِّرُ"]},{"verse_key":"74:2","text":"قُم فَاَنذِر","words":["قُم","فَاَنذِر"]},{"verse_key":"74:3","text":"وَرَبَّكَ فَكَبِّر","words":["وَرَبَّكَ","فَكَبِّر"]},{"verse_key":"74:4","text":"وَثِيَابَكَ فَطَهِّر","words":["وَثِيَابَكَ","فَطَهِّر"]},{"verse_key":"74:5","text":"وَالرُّجزَ فَاهجُر","words":["وَالرُّجزَ","فَاهجُر"]},{"verse_key":"74:6","text":"وَلَا تَمنُن تَستَكثِرُ","words":["وَلَا","تَمنُن","تَستَكثِرُ"]},{"verse_key":"74:7","text":"وَلِرَبِّكَ فَاصبِرؕ","words":["وَلِرَبِّكَ","فَاصبِرؕ"]},{"verse_key":"74:8","text":"فَاِذَا نُقِرَ فِى النَّاقُورِ","words":["فَاِذَا","نُقِرَ","فِى","النَّاقُورِ"]},{"verse_key":"74:9","text":"فَذٰلِكَ يَومَٮِٕذٍ يَّومٌ عَسِيرٌ","words":["فَذٰلِكَ","يَومَٮِٕذٍ","يَّومٌ","عَسِيرٌ"]},{"verse_key":"74:10","text":"عَلَى الكٰفِرِينَ غَيرُ يَسِيرٍ","words":["عَلَى","الكٰفِرِينَ","غَيرُ","يَسِيرٍ"]},{"verse_key":"74:11","text":"ذَرنِى وَمَن خَلَقتُ وَحِيدًا ","words":["ذَرنِى","وَمَن","خَلَقتُ","وَحِيدًا "]},{"verse_key":"74:12","text":"وَّجَعَلتُ لَهٗ مَالًا مَّمدُودًا ","words":["وَّجَعَلتُ","لَهٗ","مَالًا","مَّمدُودًا "]},{"verse_key":"74:13","text":"وَّبَنِينَ شُهُودًا ","words":["وَّبَنِينَ","شُهُودًا "]},{"verse_key":"74:14","text":"وَّمَهَّدتُّ لَهٗ تَمهِيدًا ","words":["وَّمَهَّدتُّ","لَهٗ","تَمهِيدًا "]},{"verse_key":"74:15","text":"ثُمَّ يَطمَعُ اَن اَزِيدَ  ","words":["ثُمَّ","يَطمَعُ","اَن","اَزِيدَ  "]},{"verse_key":"74:16","text":"كَلَّا ؕ اِنَّهٗ كَانَ لِاٰيٰتِنَا عَنِيدًا ؕ","words":["كَلَّا ؕ","اِنَّهٗ","كَانَ","لِاٰيٰتِنَا","عَنِيدًا ؕ"]},{"verse_key":"74:17","text":"سَاُرهِقُهٗ صَعُودًا ؕ","words":["سَاُرهِقُهٗ","صَعُودًا ؕ"]},{"verse_key":"74:18","text":"اِنَّهٗ فَكَّرَ وَقَدَّرَ","words":["اِنَّهٗ","فَكَّرَ","وَقَدَّرَ"]},{"verse_key":"74:19","text":"فَقُتِلَ كَيفَ قَدَّرَ","words":["فَقُتِلَ","كَيفَ","قَدَّرَ"]},{"verse_key":"74:20","text":"ثُمَّ قُتِلَ كَيفَ قَدَّرَ","words":["ثُمَّ","قُتِلَ","كَيفَ","قَدَّرَ"]},{"verse_key":"74:21","text":"ثُمَّ نَظَرَ","words":["ثُمَّ","نَظَرَ"]},{"verse_key":"74:22","text":"ثُمَّ عَبَسَ وَبَسَرَ","words":["ثُمَّ","عَبَسَ","وَبَسَرَ"]},{"verse_key":"74:23","text":"ثُمَّ اَدبَرَ وَاستَكبَرَ","words":["ثُمَّ","اَدبَرَ","وَاستَكبَرَ"]},{"verse_key":"74:24","text":"فَقَالَ اِن هٰذَا اِلَّا سِحرٌ يُّؤثَرُ","words":["فَقَالَ","اِن","هٰذَا","اِلَّا","سِحرٌ","يُّؤثَرُ"]},{"verse_key":"74:25","text":"اِن هٰذَا اِلَّا قَولُ البَشَرِؕ","words":["اِن","هٰذَا","اِلَّا","قَولُ","البَشَرِؕ"]},{"verse_key":"74:26","text":"سَاُصلِيهِ سَقَرَ","words":["سَاُصلِيهِ","سَقَرَ"]},{"verse_key":"74:27","text":"وَمَا اَدرٰٮكَ مَا سَقَرُؕ","words":["وَمَا","اَدرٰٮكَ","مَا","سَقَرُؕ"]},{"verse_key":"74:28","text":"لَا تُبقِى وَلَا تَذَرُ","words":["لَا","تُبقِى","وَلَا","تَذَرُ"]},{"verse_key":"74:29","text":"لَـوَّاحَةٌ لِّلبَشَرِ","words":["لَـوَّاحَةٌ","لِّلبَشَرِ"]},{"verse_key":"74:30","text":"عَلَيهَا تِسعَةَ عَشَرَؕ","words":["عَلَيهَا","تِسعَةَ","عَشَرَؕ"]},{"verse_key":"74:31","text":"وَمَا جَعَلنَا اَصحٰبَ النَّارِ اِلَّا مَلٰٓٮِٕكَةً وَّمَا جَعَلنَا عِدَّتَهُم اِلَّا فِتنَةً لِّلَّذِينَ كَفَرُوا  لِيَستَيقِنَ الَّذِينَ اُوتُوا الكِتٰبَ وَيَزدَادَ الَّذِينَ اٰمَنُوا اِيمَانًا وَّلَا يَرتَابَ الَّذِينَ اُوتُوا الكِتٰبَ وَالمُؤمِنُونَ وَلِيَقُولَ الَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَّالكٰفِرُونَ مَاذَا اَرَادَ اللّٰهُ بِهٰذَا مَثَلًا ؕ كَذٰلِكَ يُضِلُّ اللّٰهُ مَن يَّشَآءُ وَيَهدِى مَن يَّشَآءُ ؕ وَمَا يَعلَمُ جُنُودَ رَبِّكَ اِلَّا هُوَ ؕ وَمَا هِىَ اِلَّا ذِكرٰى لِلبَشَرِ","words":["وَمَا","جَعَلنَا","اَصحٰبَ","النَّارِ","اِلَّا","مَلٰٓٮِٕكَةً","وَّمَا","جَعَلنَا","عِدَّتَهُم","اِلَّا","فِتنَةً","لِّلَّذِينَ","كَفَرُوا ","لِيَستَيقِنَ","الَّذِينَ","اُوتُوا","الكِتٰبَ","وَيَزدَادَ","الَّذِينَ","اٰمَنُوا","اِيمَانًا","وَّلَا","يَرتَابَ","الَّذِينَ","اُوتُوا","الكِتٰبَ","وَالمُؤمِنُونَ","وَلِيَقُولَ","الَّذِينَ","فِى","قُلُوبِهِم","مَّرَضٌ","وَّالكٰفِرُونَ","مَاذَا","اَرَادَ","اللّٰهُ","بِهٰذَا","مَثَلًا ؕ","كَذٰلِكَ","يُضِلُّ","اللّٰهُ","مَن","يَّشَآءُ","وَيَهدِى","مَن","يَّشَآءُ ؕ","وَمَا","يَعلَمُ","جُنُودَ","رَبِّكَ","اِلَّا","هُوَ ؕ","وَمَا","هِىَ","اِلَّا","ذِكرٰى","لِلبَشَرِ"]},{"verse_key":"74:32","text":"كَلَّا وَالقَمَرِ","words":["كَلَّا","وَالقَمَرِ"]},{"verse_key":"74:33","text":"وَالَّيلِ اِذ اَدبَرَ","words":["وَالَّيلِ","اِذ","اَدبَرَ"]},{"verse_key":"74:34","text":"وَالصُّبحِ اِذَا اَسفَرَ","words":["وَالصُّبحِ","اِذَا","اَسفَرَ"]},{"verse_key":"74:35","text":"اِنَّهَا لَاِحدَى الكُبَرِ","words":["اِنَّهَا","لَاِحدَى","الكُبَرِ"]},{"verse_key":"74:36","text":"نَذِيرًا لِّلبَشَرِ","words":["نَذِيرًا","لِّلبَشَرِ"]},{"verse_key":"74:37","text":"لِمَن شَآءَ مِنكُم اَن يَّتَقَدَّمَ اَو يَتَاَخَّرَؕ","words":["لِمَن","شَآءَ","مِنكُم","اَن","يَّتَقَدَّمَ","اَو","يَتَاَخَّرَؕ"]},{"verse_key":"74:38","text":"كُلُّ نَفسٍ  بِمَا كَسَبَت رَهِينَةٌ ","words":["كُلُّ","نَفسٍ ","بِمَا","كَسَبَت","رَهِينَةٌ "]},{"verse_key":"74:39","text":"اِلَّا اَصحٰبَ اليَمِينِ ؕ","words":["اِلَّا","اَصحٰبَ","اليَمِينِ ؕ"]},{"verse_key":"74:40","text":"فِى جَنّٰتٍ  يَتَسَآءَلُونَ","words":["فِى","جَنّٰتٍ ","يَتَسَآءَلُونَ"]},{"verse_key":"74:41","text":"عَنِ المُجرِمِينَ","words":["عَنِ","المُجرِمِينَ"]},{"verse_key":"74:42","text":"مَا سَلَـكَكُم فِى سَقَرَ","words":["مَا","سَلَـكَكُم","فِى","سَقَرَ"]},{"verse_key":"74:43","text":"قَالُوا لَم نَكُ مِنَ المُصَلِّينَ","words":["قَالُوا","لَم","نَكُ","مِنَ","المُصَلِّينَ"]},{"verse_key":"74:44","text":"وَلَم نَكُ نُطعِمُ المِسكِينَ","words":["وَلَم","نَكُ","نُطعِمُ","المِسكِينَ"]},{"verse_key":"74:45","text":"وَكُنَّا نَخُوضُ مَعَ الخَـآٮِٕضِينَ","words":["وَكُنَّا","نَخُوضُ","مَعَ","الخَـآٮِٕضِينَ"]},{"verse_key":"74:46","text":"وَ كُنَّا نُكَذِّبُ بِيَومِ الدِّينِ","words":["وَ","كُنَّا","نُكَذِّبُ","بِيَومِ الدِّينِ"]},{"verse_key":"74:47","text":"حَتّٰٓى اَتٰٮنَا اليَقِينُؕ","words":["حَتّٰٓى","اَتٰٮنَا","اليَقِينُؕ"]},{"verse_key":"74:48","text":"فَمَا تَنفَعُهُم شَفَاعَةُ الشّٰفِعِينَؕ","words":["فَمَا","تَنفَعُهُم","شَفَاعَةُ","الشّٰفِعِينَؕ"]},{"verse_key":"74:49","text":"فَمَا لَهُم عَنِ التَّذكِرَةِ مُعرِضِينَ","words":["فَمَا","لَهُم","عَنِ","التَّذكِرَةِ","مُعرِضِينَ"]},{"verse_key":"74:50","text":"كَاَنَّهُم حُمُرٌ مُّستَنفِرَةٌ ","words":["كَاَنَّهُم","حُمُرٌ","مُّستَنفِرَةٌ "]},{"verse_key":"74:51","text":"فَرَّت مِن قَسوَرَةٍ ؕ","words":["فَرَّت","مِن","قَسوَرَةٍ ؕ"]},{"verse_key":"74:52","text":"بَل يُرِيدُ كُلُّ امرِىٴٍ مِّنهُم اَن يُّؤتٰى صُحُفًا مُّنَشَّرَةً  ","words":["بَل","يُرِيدُ","كُلُّ","امرِىٴٍ","مِّنهُم","اَن","يُّؤتٰى","صُحُفًا","مُّنَشَّرَةً  "]},{"verse_key":"74:53","text":"كَلَّا ؕ بَل لَّا يَخَافُونَ الاٰخِرَةَ ؕ","words":["كَلَّا ؕ","بَل","لَّا","يَخَافُونَ","الاٰخِرَةَ ؕ"]},{"verse_key":"74:54","text":"كَلَّا اِنَّهٗ تَذكِرَةٌ ","words":["كَلَّا","اِنَّهٗ","تَذكِرَةٌ "]},{"verse_key":"74:55","text":"فَمَن شَآءَ ذَكَرَهٗ ؕ","words":["فَمَن","شَآءَ","ذَكَرَهٗ ؕ"]},{"verse_key":"74:56","text":"وَمَا يَذكُرُونَ اِلَّا اَن يَّشَآءَ اللّٰهُ ؕ هُوَ اَهلُ التَّقوٰى وَاَهلُ المَغفِرَةِ","words":["وَمَا","يَذكُرُونَ","اِلَّا","اَن","يَّشَآءَ","اللّٰهُ ؕ","هُوَ","اَهلُ","التَّقوٰى","وَاَهلُ","المَغفِرَةِ"]}]}