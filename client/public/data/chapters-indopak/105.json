{"verses":[{"verse_key":"105:1","text":"اَلَم تَرَ كَيفَ فَعَلَ رَبُّكَ بِاَصحٰبِ الفِيلِؕ","words":["اَلَم","تَرَ","كَيفَ","فَعَلَ","رَبُّكَ","بِاَصحٰبِ","الفِيلِؕ"]},{"verse_key":"105:2","text":"اَلَم يَجعَل كَيدَهُم فِى تَضلِيلٍ","words":["اَلَم","يَجعَل","كَيدَهُم","فِى","تَضلِيلٍ"]},{"verse_key":"105:3","text":"وَّاَرسَلَ عَلَيهِم طَيرًا اَبَابِيلَ","words":["وَّاَرسَلَ","عَلَيهِم","طَيرًا","اَبَابِيلَ"]},{"verse_key":"105:4","text":"تَرمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","words":["تَرمِيهِم","بِحِجَارَةٍ","مِّن","سِجِّيلٍ"]},{"verse_key":"105:5","text":"فَجَعَلَهُم كَعَصفٍ مَّاكُولٍ","words":["فَجَعَلَهُم","كَعَصفٍ","مَّاكُولٍ"]}]}