{"verses":[{"verse_key":"104:1","text":"وَيلٌ لِّـكُلِّ هُمَزَةٍ لُّمَزَةِ ","words":["وَيلٌ","لِّـكُلِّ","هُمَزَةٍ","لُّمَزَةِ "]},{"verse_key":"104:2","text":"الَّذِى جَمَعَ مَالًا وَّعَدَّدَهٗ ","words":["الَّذِى","جَمَعَ","مَالًا","وَّعَدَّدَهٗ "]},{"verse_key":"104:3","text":"يَحسَبُ اَنَّ مَالَهٗ اَخلَدَهٗ ","words":["يَحسَبُ","اَنَّ","مَالَهٗ","اَخلَدَهٗ "]},{"verse_key":"104:4","text":"كَلَّا لَيُنبَذَنَّ فِى الحُطَمَةِ  ","words":["كَلَّا","لَيُنبَذَنَّ","فِى","الحُطَمَةِ  "]},{"verse_key":"104:5","text":"وَمَا اَدرٰٮكَ مَا الحُطَمَةُ ؕ","words":["وَمَا","اَدرٰٮكَ","مَا","الحُطَمَةُ ؕ"]},{"verse_key":"104:6","text":"نَارُ اللّٰهِ المُوقَدَةُ ","words":["نَارُ","اللّٰهِ","المُوقَدَةُ "]},{"verse_key":"104:7","text":"الَّتِى تَطَّلِعُ عَلَى الاَفـــِٕدَةِ ؕ","words":["الَّتِى","تَطَّلِعُ","عَلَى","الاَفـــِٕدَةِ ؕ"]},{"verse_key":"104:8","text":"اِنَّهَا عَلَيهِم مُّؤصَدَةٌ ","words":["اِنَّهَا","عَلَيهِم","مُّؤصَدَةٌ "]},{"verse_key":"104:9","text":"فِى عَمَدٍ مُّمَدَّدَةٍ","words":["فِى","عَمَدٍ","مُّمَدَّدَةٍ"]}]}