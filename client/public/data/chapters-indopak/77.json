{"verses":[{"verse_key":"77:1","text":"وَالمُرسَلٰتِ عُرفًا ","words":["وَالمُرسَلٰتِ","عُرفًا "]},{"verse_key":"77:2","text":"فَالعٰصِفٰتِ عَصفًا ","words":["فَالعٰصِفٰتِ","عَصفًا "]},{"verse_key":"77:3","text":"وَّالنّٰشِرٰتِ نَشرًا ","words":["وَّالنّٰشِرٰتِ","نَشرًا "]},{"verse_key":"77:4","text":"فَالفٰرِقٰتِ فَرقًا ","words":["فَالفٰرِقٰتِ","فَرقًا "]},{"verse_key":"77:5","text":"فَالمُلقِيٰتِ ذِكرًا ","words":["فَالمُلقِيٰتِ","ذِكرًا "]},{"verse_key":"77:6","text":"عُذرًا اَو نُذرًا ","words":["عُذرًا","اَو","نُذرًا "]},{"verse_key":"77:7","text":"اِنَّمَا تُوعَدُونَ لَوَاقِعٌ ؕ","words":["اِنَّمَا","تُوعَدُونَ","لَوَاقِعٌ ؕ"]},{"verse_key":"77:8","text":"فَاِذَا النُّجُومُ طُمِسَت","words":["فَاِذَا","النُّجُومُ","طُمِسَت"]},{"verse_key":"77:9","text":"وَ اِذَا السَّمَآءُ فُرِجَت","words":["وَ اِذَا","السَّمَآءُ","فُرِجَت"]},{"verse_key":"77:10","text":"وَاِذَا الجِبَالُ نُسِفَت","words":["وَاِذَا","الجِبَالُ","نُسِفَت"]},{"verse_key":"77:11","text":"وَاِذَا الرُّسُلُ اُقِّتَتؕ","words":["وَاِذَا","الرُّسُلُ","اُقِّتَتؕ"]},{"verse_key":"77:12","text":"لِاَىِّ يَومٍ اُجِّلَتؕ","words":["لِاَىِّ","يَومٍ","اُجِّلَتؕ"]},{"verse_key":"77:13","text":"لِيَومِ الفَصلِ","words":["لِيَومِ","الفَصلِ"]},{"verse_key":"77:14","text":"وَمَا اَدرٰٮكَ مَا يَومُ الفَصلِؕ","words":["وَمَا","اَدرٰٮكَ","مَا","يَومُ","الفَصلِؕ"]},{"verse_key":"77:15","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:16","text":"اَلَم نُهلِكِ الاَوَّلِينَؕ","words":["اَلَم","نُهلِكِ","الاَوَّلِينَؕ"]},{"verse_key":"77:17","text":"ثُمَّ نُتبِعُهُمُ الاٰخِرِينَ","words":["ثُمَّ","نُتبِعُهُمُ","الاٰخِرِينَ"]},{"verse_key":"77:18","text":"كَذٰلِكَ نَفعَلُ بِالمُجرِمِينَ","words":["كَذٰلِكَ","نَفعَلُ","بِالمُجرِمِينَ"]},{"verse_key":"77:19","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:20","text":"اَلَم نَخلُقكُّم مِّن مَّآءٍ مَّهِينٍ","words":["اَلَم","نَخلُقكُّم","مِّن","مَّآءٍ","مَّهِينٍ"]},{"verse_key":"77:21","text":"فَجَعَلنٰهُ فِى قَرَارٍ مَّكِينٍ","words":["فَجَعَلنٰهُ","فِى","قَرَارٍ","مَّكِينٍ"]},{"verse_key":"77:22","text":"اِلٰى قَدَرٍ مَّعلُومٍ","words":["اِلٰى","قَدَرٍ","مَّعلُومٍ"]},{"verse_key":"77:23","text":"فَقَدَرنَا  فَنِعمَ القٰدِرُونَ","words":["فَقَدَرنَا ","فَنِعمَ","القٰدِرُونَ"]},{"verse_key":"77:24","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:25","text":"اَلَم نَجعَلِ الاَرضَ كِفَاتًا ","words":["اَلَم","نَجعَلِ","الاَرضَ","كِفَاتًا "]},{"verse_key":"77:26","text":"اَحيَآءً وَّاَموَاتًا ","words":["اَحيَآءً","وَّاَموَاتًا "]},{"verse_key":"77:27","text":"وَّجَعَلنَا فِيهَا رَوَاسِىَ شٰمِخٰتٍ وَّ اَسقَينٰكُم مَّآءً فُرَاتًا ؕ","words":["وَّجَعَلنَا","فِيهَا","رَوَاسِىَ","شٰمِخٰتٍ","وَّ اَسقَينٰكُم","مَّآءً","فُرَاتًا ؕ"]},{"verse_key":"77:28","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:29","text":"اِنْطَلِقُوا اِلٰى مَا كُنتُم بِهٖ تُكَذِّبُونَ","words":["اِنْطَلِقُوا","اِلٰى","مَا","كُنتُم","بِهٖ","تُكَذِّبُونَ"]},{"verse_key":"77:30","text":"اِنْطَلِقُوا اِلٰى ظِلٍّ ذِى ثَلٰثِ شُعَبٍ","words":["اِنْطَلِقُوا","اِلٰى","ظِلٍّ","ذِى","ثَلٰثِ","شُعَبٍ"]},{"verse_key":"77:31","text":"لَّا ظَلِيلٍ وَّلَا يُغنِى مِنَ اللَّهَبِؕ","words":["لَّا","ظَلِيلٍ","وَّلَا","يُغنِى","مِنَ","اللَّهَبِؕ"]},{"verse_key":"77:32","text":"اِنَّهَا تَرمِى بِشَرَرٍ كَالقَصرِ","words":["اِنَّهَا","تَرمِى","بِشَرَرٍ","كَالقَصرِ"]},{"verse_key":"77:33","text":"كَاَنَّهٗ جِمٰلَتٌ صُفرٌ ؕ","words":["كَاَنَّهٗ","جِمٰلَتٌ","صُفرٌ ؕ"]},{"verse_key":"77:34","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:35","text":"هٰذَا يَومُ لَا يَنطِقُونَ","words":["هٰذَا","يَومُ","لَا","يَنطِقُونَ"]},{"verse_key":"77:36","text":"وَلَا يُؤذَنُ لَهُم فَيَـعتَذِرُونَ","words":["وَلَا","يُؤذَنُ","لَهُم","فَيَـعتَذِرُونَ"]},{"verse_key":"77:37","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:38","text":"هٰذَا يَومُ الفَصلِ جَمَعنٰكُم وَالاَوَّلِينَ","words":["هٰذَا","يَومُ","الفَصلِ","جَمَعنٰكُم","وَالاَوَّلِينَ"]},{"verse_key":"77:39","text":"فَاِن كَانَ لَـكُم كَيدٌ فَكِيدُونِ","words":["فَاِن","كَانَ","لَـكُم","كَيدٌ","فَكِيدُونِ"]},{"verse_key":"77:40","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:41","text":"اِنَّ المُتَّقِينَ فِى ظِلٰلٍ وَّعُيُونٍ","words":["اِنَّ","المُتَّقِينَ","فِى","ظِلٰلٍ","وَّعُيُونٍ"]},{"verse_key":"77:42","text":"وَّفَوَاكِهَ مِمَّا يَشتَهُونَؕ","words":["وَّفَوَاكِهَ","مِمَّا","يَشتَهُونَؕ"]},{"verse_key":"77:43","text":"كُلُوا وَاشرَبُوا هَنِيْٓئًا  بِمَا كُنتُم تَعمَلُونَ","words":["كُلُوا","وَاشرَبُوا","هَنِيْٓئًا ","بِمَا","كُنتُم","تَعمَلُونَ"]},{"verse_key":"77:44","text":"اِنَّا كَذٰلِكَ نَجزِى المُحسِنِينَ","words":["اِنَّا","كَذٰلِكَ","نَجزِى","المُحسِنِينَ"]},{"verse_key":"77:45","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:46","text":"كُلُوا وَتَمَتَّعُوا قَلِيلًا اِنَّكُم مُّجرِمُونَ","words":["كُلُوا","وَتَمَتَّعُوا","قَلِيلًا","اِنَّكُم","مُّجرِمُونَ"]},{"verse_key":"77:47","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:48","text":"وَاِذَا قِيلَ لَهُمُ اركَعُوا لَا يَركَعُونَ","words":["وَاِذَا","قِيلَ","لَهُمُ","اركَعُوا","لَا","يَركَعُونَ"]},{"verse_key":"77:49","text":"وَيلٌ يَّومَٮِٕذٍ لِّلمُكَذِّبِينَ","words":["وَيلٌ","يَّومَٮِٕذٍ","لِّلمُكَذِّبِينَ"]},{"verse_key":"77:50","text":"فَبِاَىِّ حَدِيثٍ بَعدَهٗ يُؤمِنُونَ","words":["فَبِاَىِّ","حَدِيثٍ","بَعدَهٗ","يُؤمِنُونَ"]}]}