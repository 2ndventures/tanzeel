{"verses":[{"verse_key":"89:1","text":"وَالفَجرِ","words":["وَالفَجرِ"]},{"verse_key":"89:2","text":"وَلَيَالٍ عَشرٍ","words":["وَلَيَالٍ","عَشرٍ"]},{"verse_key":"89:3","text":"وَّالشَّفعِ وَالوَترِ","words":["وَّالشَّفعِ","وَالوَترِ"]},{"verse_key":"89:4","text":"وَالَّيلِ اِذَا يَسرِ","words":["وَالَّيلِ","اِذَا","يَسرِ"]},{"verse_key":"89:5","text":"هَل فِى ذٰلِكَ قَسَمٌ لِّذِى حِجرٍؕ","words":["هَل","فِى","ذٰلِكَ","قَسَمٌ","لِّذِى","حِجرٍؕ"]},{"verse_key":"89:6","text":"اَلَم تَرَ كَيفَ فَعَلَ رَبُّكَ بِعَادٍ","words":["اَلَم","تَرَ","كَيفَ","فَعَلَ","رَبُّكَ","بِعَادٍ"]},{"verse_key":"89:7","text":"اِرَمَ ذَاتِ العِمَادِ","words":["اِرَمَ","ذَاتِ","العِمَادِ"]},{"verse_key":"89:8","text":"الَّتِى لَم يُخلَق مِثلُهَا فِى البِلَادِ","words":["الَّتِى","لَم","يُخلَق","مِثلُهَا","فِى","البِلَادِ"]},{"verse_key":"89:9","text":"وَثَمُودَ الَّذِينَ جَابُوا الصَّخرَ بِالوَادِ","words":["وَثَمُودَ","الَّذِينَ","جَابُوا","الصَّخرَ","بِالوَادِ"]},{"verse_key":"89:10","text":"وَفِرعَونَ ذِى الاَوتَادِ","words":["وَفِرعَونَ","ذِى","الاَوتَادِ"]},{"verse_key":"89:11","text":"الَّذِينَ طَغَوا فِى البِلَادِ","words":["الَّذِينَ","طَغَوا","فِى","البِلَادِ"]},{"verse_key":"89:12","text":"فَاَكثَرُوا فِيهَا الفَسَادَ","words":["فَاَكثَرُوا","فِيهَا","الفَسَادَ"]},{"verse_key":"89:13","text":"فَصَبَّ عَلَيهِم رَبُّكَ سَوطَ عَذَابٍ ","words":["فَصَبَّ","عَلَيهِم","رَبُّكَ","سَوطَ","عَذَابٍ "]},{"verse_key":"89:14","text":"اِنَّ رَبَّكَ لَبِالمِرصَادِؕ","words":["اِنَّ","رَبَّكَ","لَبِالمِرصَادِؕ"]},{"verse_key":"89:15","text":"فَاَمَّا الاِنسَانُ اِذَا مَا ابتَلٰٮهُ رَبُّهٗ فَاَكرَمَهٗ وَنَعَّمَهٗ   فَيَقُولُ رَبِّى اَكرَمَنِؕ","words":["فَاَمَّا","الاِنسَانُ","اِذَا","مَا","ابتَلٰٮهُ","رَبُّهٗ","فَاَكرَمَهٗ","وَنَعَّمَهٗ  ","فَيَقُولُ","رَبِّى","اَكرَمَنِؕ"]},{"verse_key":"89:16","text":"وَاَمَّا اِذَا مَا ابتَلٰٮهُ فَقَدَرَ عَلَيهِ رِزقَهٗ  فَيَقُولُ رَبِّى اَهَانَنِ","words":["وَاَمَّا","اِذَا","مَا","ابتَلٰٮهُ","فَقَدَرَ","عَلَيهِ","رِزقَهٗ ","فَيَقُولُ","رَبِّى","اَهَانَنِ"]},{"verse_key":"89:17","text":"كَلَّا بَل لَّا تُكرِمُونَ اليَتِيمَ","words":["كَلَّا","بَل","لَّا","تُكرِمُونَ","اليَتِيمَ"]},{"verse_key":"89:18","text":"وَلَا تَحٰٓضُّونَ عَلٰى طَعَامِ المِسكِينِ","words":["وَلَا","تَحٰٓضُّونَ","عَلٰى","طَعَامِ","المِسكِينِ"]},{"verse_key":"89:19","text":"وَتَاكُلُونَ التُّرَاثَ اَكلًا لَّـمًّا ","words":["وَتَاكُلُونَ","التُّرَاثَ","اَكلًا","لَّـمًّا "]},{"verse_key":"89:20","text":"وَّتُحِبُّونَ المَالَ حُبًّا جَمًّا ؕ","words":["وَّتُحِبُّونَ","المَالَ","حُبًّا","جَمًّا ؕ"]},{"verse_key":"89:21","text":"كَلَّا اِذَا دُكَّتِ الاَرضُ دَكًّا دَكًّا ","words":["كَلَّا","اِذَا","دُكَّتِ","الاَرضُ","دَكًّا","دَكًّا "]},{"verse_key":"89:22","text":"وَّجَآءَ رَبُّكَ وَالمَلَكُ صَفًّا صَفًّا ","words":["وَّجَآءَ","رَبُّكَ","وَالمَلَكُ","صَفًّا","صَفًّا "]},{"verse_key":"89:23","text":"وَجِاىْٓءَ يَومَٮِٕذٍ بِجَهَنَّمَ   يَومَٮِٕذٍ يَّتَذَكَّرُ الاِنسَانُ وَاَنّٰى لَـهُ الذِّكرٰىؕ","words":["وَجِاىْٓءَ","يَومَٮِٕذٍ","بِجَهَنَّمَ  ","يَومَٮِٕذٍ","يَّتَذَكَّرُ","الاِنسَانُ","وَاَنّٰى","لَـهُ","الذِّكرٰىؕ"]},{"verse_key":"89:24","text":"يَقُولُ يٰلَيتَنِى قَدَّمتُ لِحَـيَاتِى","words":["يَقُولُ","يٰلَيتَنِى","قَدَّمتُ","لِحَـيَاتِى"]},{"verse_key":"89:25","text":"فَيَومَٮِٕذٍ لَّا يُعَذِّبُ عَذَابَهٗ اَحَدٌ ","words":["فَيَومَٮِٕذٍ","لَّا","يُعَذِّبُ","عَذَابَهٗ","اَحَدٌ "]},{"verse_key":"89:26","text":"وَّلَا يُوثِقُ وَثَاقَهٗ اَحَدٌ ؕ","words":["وَّلَا","يُوثِقُ","وَثَاقَهٗ","اَحَدٌ ؕ"]},{"verse_key":"89:27","text":"يٰاَيَّتُهَا النَّفسُ المُطمَٮِٕنَّةُ  ","words":["يٰاَيَّتُهَا","النَّفسُ","المُطمَٮِٕنَّةُ  "]},{"verse_key":"89:28","text":"ارجِعِى اِلٰى رَبِّكِ رَاضِيَةً مَّرضِيَّةً ","words":["ارجِعِى","اِلٰى","رَبِّكِ","رَاضِيَةً","مَّرضِيَّةً "]},{"verse_key":"89:29","text":"فَادخُلِى فِى عِبٰدِى","words":["فَادخُلِى","فِى","عِبٰدِى"]},{"verse_key":"89:30","text":"وَادخُلِى جَنَّتِى","words":["وَادخُلِى","جَنَّتِى"]}]}