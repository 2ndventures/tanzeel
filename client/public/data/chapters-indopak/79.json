{"verses":[{"verse_key":"79:1","text":"وَالنّٰزِعٰتِ غَرقًا ","words":["وَالنّٰزِعٰتِ","غَرقًا "]},{"verse_key":"79:2","text":"وَّالنّٰشِطٰتِ نَشطًا ","words":["وَّالنّٰشِطٰتِ","نَشطًا "]},{"verse_key":"79:3","text":"وَّالسّٰبِحٰتِ سَبحًا ","words":["وَّالسّٰبِحٰتِ","سَبحًا "]},{"verse_key":"79:4","text":"فَالسّٰبِقٰتِ سَبقًا ","words":["فَالسّٰبِقٰتِ","سَبقًا "]},{"verse_key":"79:5","text":"فَالمُدَبِّرٰتِ اَمرًا ","words":["فَالمُدَبِّرٰتِ","اَمرًا "]},{"verse_key":"79:6","text":"يَومَ تَرجُفُ الرَّاجِفَةُ ","words":["يَومَ","تَرجُفُ","الرَّاجِفَةُ "]},{"verse_key":"79:7","text":"تَتبَعُهَا الرَّادِفَةُ ؕ","words":["تَتبَعُهَا","الرَّادِفَةُ ؕ"]},{"verse_key":"79:8","text":"قُلُوبٌ يَّومَٮِٕذٍ وَّاجِفَةٌ ","words":["قُلُوبٌ","يَّومَٮِٕذٍ","وَّاجِفَةٌ "]},{"verse_key":"79:9","text":"اَبصَارُهَا خَاشِعَةٌ ","words":["اَبصَارُهَا","خَاشِعَةٌ "]},{"verse_key":"79:10","text":"يَقُولُونَ ءَاِنَّا لَمَردُودُونَ فِى الحَـافِرَةِ ؕ","words":["يَقُولُونَ","ءَاِنَّا","لَمَردُودُونَ","فِى","الحَـافِرَةِ ؕ"]},{"verse_key":"79:11","text":"ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ؕ","words":["ءَاِذَا","كُنَّا","عِظَامًا","نَّخِرَةً ؕ"]},{"verse_key":"79:12","text":"قَالُوا تِلكَ اِذًا كَرَّةٌ خَاسِرَةٌ ","words":["قَالُوا","تِلكَ","اِذًا","كَرَّةٌ","خَاسِرَةٌ "]},{"verse_key":"79:13","text":"فَاِنَّمَا هِىَ زَجرَةٌ وَّاحِدَةٌ ","words":["فَاِنَّمَا","هِىَ","زَجرَةٌ","وَّاحِدَةٌ "]},{"verse_key":"79:14","text":"فَاِذَا هُم بِالسَّاهِرَةِ ؕ","words":["فَاِذَا","هُم","بِالسَّاهِرَةِ ؕ"]},{"verse_key":"79:15","text":"هَل اَتٰٮكَ حَدِيثُ مُوسٰى","words":["هَل","اَتٰٮكَ","حَدِيثُ","مُوسٰى"]},{"verse_key":"79:16","text":"اِذ نَادٰٮهُ رَبُّهٗ بِالوَادِ المُقَدَّسِ طُوًى","words":["اِذ","نَادٰٮهُ","رَبُّهٗ","بِالوَادِ","المُقَدَّسِ","طُوًى"]},{"verse_key":"79:17","text":"اِذهَب اِلٰى فِرعَونَ اِنَّهٗ طَغٰى ","words":["اِذهَب","اِلٰى","فِرعَونَ","اِنَّهٗ","طَغٰى "]},{"verse_key":"79:18","text":"فَقُل هَل لَّكَ اِلٰٓى اَن تَزَكّٰى ","words":["فَقُل","هَل","لَّكَ","اِلٰٓى","اَن","تَزَكّٰى "]},{"verse_key":"79:19","text":"وَاَهدِيَكَ اِلٰى رَبِّكَ فَتَخشٰى","words":["وَاَهدِيَكَ","اِلٰى","رَبِّكَ","فَتَخشٰى"]},{"verse_key":"79:20","text":"فَاَرٰٮهُ الاٰيَةَ الكُبرٰى ","words":["فَاَرٰٮهُ","الاٰيَةَ","الكُبرٰى "]},{"verse_key":"79:21","text":"فَكَذَّبَ وَعَصٰى ","words":["فَكَذَّبَ","وَعَصٰى "]},{"verse_key":"79:22","text":"ثُمَّ اَدبَرَ يَسعٰى","words":["ثُمَّ","اَدبَرَ","يَسعٰى"]},{"verse_key":"79:23","text":"فَحَشَرَ فَنَادٰى","words":["فَحَشَرَ","فَنَادٰى"]},{"verse_key":"79:24","text":"فَقَالَ اَنَا رَبُّكُمُ الاَعلٰى ","words":["فَقَالَ","اَنَا","رَبُّكُمُ","الاَعلٰى "]},{"verse_key":"79:25","text":"فَاَخَذَهُ اللّٰهُ نَڪَالَ الاٰخِرَةِ وَالاُولٰى ؕ","words":["فَاَخَذَهُ","اللّٰهُ","نَڪَالَ","الاٰخِرَةِ","وَالاُولٰى ؕ"]},{"verse_key":"79:26","text":"اِنَّ فِى ذٰلِكَ لَعِبرَةً لِّمَن يَّخشٰىؕ","words":["اِنَّ","فِى","ذٰلِكَ","لَعِبرَةً","لِّمَن","يَّخشٰىؕ"]},{"verse_key":"79:27","text":"ءَاَنتُم اَشَدُّ خَلقًا اَمِ السَّمَآءُ ؕ بَنٰٮهَا","words":["ءَاَنتُم","اَشَدُّ","خَلقًا","اَمِ","السَّمَآءُ ؕ","بَنٰٮهَا"]},{"verse_key":"79:28","text":"رَفَعَ سَمكَهَا فَسَوَّٮهَا ","words":["رَفَعَ","سَمكَهَا","فَسَوَّٮهَا "]},{"verse_key":"79:29","text":"وَ اَغطَشَ لَيلَهَا وَاَخرَجَ ضُحٰٮهَا","words":["وَ اَغطَشَ","لَيلَهَا","وَاَخرَجَ","ضُحٰٮهَا"]},{"verse_key":"79:30","text":"وَالاَرضَ بَعدَ ذٰلِكَ دَحٰٮهَا ؕ","words":["وَالاَرضَ","بَعدَ","ذٰلِكَ","دَحٰٮهَا ؕ"]},{"verse_key":"79:31","text":"اَخرَجَ مِنهَا مَآءَهَا وَمَرعٰٮهَا","words":["اَخرَجَ","مِنهَا","مَآءَهَا","وَمَرعٰٮهَا"]},{"verse_key":"79:32","text":"وَالجِبَالَ اَرسٰٮهَا ","words":["وَالجِبَالَ","اَرسٰٮهَا "]},{"verse_key":"79:33","text":"مَتَاعًا لَّـكُم وَلِاَنعَامِكُمؕ","words":["مَتَاعًا","لَّـكُم","وَلِاَنعَامِكُمؕ"]},{"verse_key":"79:34","text":"فَاِذَا جَآءَتِ الطَّآمَّةُ الكُبرٰى ","words":["فَاِذَا","جَآءَتِ","الطَّآمَّةُ","الكُبرٰى "]},{"verse_key":"79:35","text":"يَومَ يَتَذَكَّرُ الاِنسَانُ مَا سَعٰى","words":["يَومَ","يَتَذَكَّرُ","الاِنسَانُ","مَا","سَعٰى"]},{"verse_key":"79:36","text":"وَبُرِّزَتِ الجَحِيمُ لِمَن يَّرٰى","words":["وَبُرِّزَتِ","الجَحِيمُ","لِمَن","يَّرٰى"]},{"verse_key":"79:37","text":"فَاَمَّا مَن طَغٰى","words":["فَاَمَّا","مَن","طَغٰى"]},{"verse_key":"79:38","text":"وَاٰثَرَ الحَيٰوةَ الدُّنيَا ","words":["وَاٰثَرَ","الحَيٰوةَ","الدُّنيَا "]},{"verse_key":"79:39","text":"فَاِنَّ الجَحِيمَ هِىَ المَاوٰىؕ","words":["فَاِنَّ","الجَحِيمَ","هِىَ","المَاوٰىؕ"]},{"verse_key":"79:40","text":"وَاَمَّا مَن خَافَ مَقَامَ رَبِّهٖ وَ نَهَى النَّفسَ عَنِ الهَوٰى","words":["وَاَمَّا","مَن","خَافَ","مَقَامَ","رَبِّهٖ","وَ نَهَى","النَّفسَ","عَنِ","الهَوٰى"]},{"verse_key":"79:41","text":"فَاِنَّ الجَـنَّةَ هِىَ المَاوٰىؕ","words":["فَاِنَّ","الجَـنَّةَ","هِىَ","المَاوٰىؕ"]},{"verse_key":"79:42","text":"يَســـَٔلُونَكَ عَنِ السَّاعَةِ اَيَّانَ مُرسٰٮهَا ؕ","words":["يَســـَٔلُونَكَ","عَنِ","السَّاعَةِ","اَيَّانَ","مُرسٰٮهَا ؕ"]},{"verse_key":"79:43","text":"فِيمَ اَنتَ مِن ذِكرٰٮهَاؕ","words":["فِيمَ","اَنتَ","مِن","ذِكرٰٮهَاؕ"]},{"verse_key":"79:44","text":"اِلٰى رَبِّكَ مُنتَهٰٮهَاؕ","words":["اِلٰى","رَبِّكَ","مُنتَهٰٮهَاؕ"]},{"verse_key":"79:45","text":"اِنَّمَا اَنتَ مُنذِرُ مَن يَّخشٰٮهَاؕ","words":["اِنَّمَا","اَنتَ","مُنذِرُ","مَن","يَّخشٰٮهَاؕ"]},{"verse_key":"79:46","text":"كَاَنَّهُم يَومَ يَرَونَهَا لَم يَلبَثُوا اِلَّا عَشِيَّةً اَو ضُحٰٮهَا ","words":["كَاَنَّهُم","يَومَ","يَرَونَهَا","لَم","يَلبَثُوا","اِلَّا","عَشِيَّةً","اَو","ضُحٰٮهَا "]}]}