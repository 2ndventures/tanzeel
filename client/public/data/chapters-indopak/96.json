{"verses":[{"verse_key":"96:1","text":"اِقرَا بِاسمِ رَبِّكَ الَّذِى خَلَقَ","words":["اِقرَا","بِاسمِ","رَبِّكَ","الَّذِى","خَلَقَ"]},{"verse_key":"96:2","text":"خَلَقَ الاِنسَانَ مِن عَلَقٍ","words":["خَلَقَ","الاِنسَانَ","مِن","عَلَقٍ"]},{"verse_key":"96:3","text":"اِقرَا وَرَبُّكَ الاَكرَمُ","words":["اِقرَا","وَرَبُّكَ","الاَكرَمُ"]},{"verse_key":"96:4","text":"الَّذِى عَلَّمَ بِالقَلَمِ","words":["الَّذِى","عَلَّمَ","بِالقَلَمِ"]},{"verse_key":"96:5","text":"عَلَّمَ الاِنسَانَ مَا لَم يَعلَمؕ","words":["عَلَّمَ","الاِنسَانَ","مَا","لَم","يَعلَمؕ"]},{"verse_key":"96:6","text":"كَلَّا اِنَّ الاِنسَانَ لَيَطغٰٓى","words":["كَلَّا","اِنَّ","الاِنسَانَ","لَيَطغٰٓى"]},{"verse_key":"96:7","text":"اَن رَّاٰهُ استَغنٰىؕ","words":["اَن","رَّاٰهُ","استَغنٰىؕ"]},{"verse_key":"96:8","text":"اِنَّ اِلٰى رَبِّكَ الرُّجعٰىؕ","words":["اِنَّ","اِلٰى","رَبِّكَ","الرُّجعٰىؕ"]},{"verse_key":"96:9","text":"اَرَءَيتَ الَّذِى يَنهٰىؕ","words":["اَرَءَيتَ","الَّذِى","يَنهٰىؕ"]},{"verse_key":"96:10","text":"عَبدًا اِذَا صَلّٰىؕ","words":["عَبدًا","اِذَا","صَلّٰىؕ"]},{"verse_key":"96:11","text":"اَرَءَيتَ اِن كَانَ عَلَى الهُدٰٓى","words":["اَرَءَيتَ","اِن","كَانَ","عَلَى","الهُدٰٓى"]},{"verse_key":"96:12","text":"اَو اَمَرَ بِالتَّقوٰى","words":["اَو","اَمَرَ","بِالتَّقوٰى"]},{"verse_key":"96:13","text":"اَرَءَيتَ اِن كَذَّبَ وَتَوَلّٰىؕ","words":["اَرَءَيتَ","اِن","كَذَّبَ","وَتَوَلّٰىؕ"]},{"verse_key":"96:14","text":"اَلَم يَعلَم بِاَنَّ اللّٰهَ يَرٰىؕ","words":["اَلَم","يَعلَم","بِاَنَّ","اللّٰهَ","يَرٰىؕ"]},{"verse_key":"96:15","text":"كَلَّا لَٮِٕن لَّم يَنتَهِ   لَنَسفَعًا بِالنَّاصِيَةِ","words":["كَلَّا","لَٮِٕن","لَّم","يَنتَهِ  ","لَنَسفَعًا","بِالنَّاصِيَةِ"]},{"verse_key":"96:16","text":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ ","words":["نَاصِيَةٍ","كَاذِبَةٍ","خَاطِئَةٍ "]},{"verse_key":"96:17","text":"فَليَدعُ نَادِيَهٗ ","words":["فَليَدعُ","نَادِيَهٗ "]},{"verse_key":"96:18","text":"سَنَدعُ الزَّبَانِيَةَ ","words":["سَنَدعُ","الزَّبَانِيَةَ "]},{"verse_key":"96:19","text":"كَلَّاؕ لَا تُطِعهُ وَاسجُد وَاقتَرِبْ","words":["كَلَّاؕ","لَا","تُطِعهُ","وَاسجُد","وَاقتَرِبْ"]}]}