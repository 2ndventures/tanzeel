{"verses":[{"verse_key":"1:1","text":"بِسمِ اللهِ الرَّحمٰنِ الرَّحِيمِ","words":["بِسمِ","اللهِ","الرَّحمٰنِ","الرَّحِيمِ"]},{"verse_key":"1:2","text":"اَلحَمدُ لِلّٰهِ رَبِّ العٰلَمِينَ","words":["اَلحَمدُ","لِلّٰهِ","رَبِّ","العٰلَمِينَ"]},{"verse_key":"1:3","text":"الرَّحمٰنِ الرَّحِيمِ","words":["الرَّحمٰنِ","الرَّحِيمِ"]},{"verse_key":"1:4","text":"مٰلِكِ يَومِ الدِّينِؕ","words":["مٰلِكِ","يَومِ","الدِّينِؕ"]},{"verse_key":"1:5","text":"اِيَّاكَ نَعبُدُ وَاِيَّاكَ نَستَعِينُؕ","words":["اِيَّاكَ","نَعبُدُ","وَاِيَّاكَ","نَستَعِينُؕ"]},{"verse_key":"1:6","text":"اِهدِنَا الصِّرَاطَ المُستَقِيمَ","words":["اِهدِنَا","الصِّرَاطَ","المُستَقِيمَ"]},{"verse_key":"1:7","text":"صِرَاطَ الَّذِينَ اَنعَمتَ عَلَيهِم  غَيرِ المَغضُوبِ عَلَيهِم وَلَا الضَّآلِّينَ","words":["صِرَاطَ","الَّذِينَ","اَنعَمتَ","عَلَيهِم ","غَيرِ","المَغضُوبِ","عَلَيهِم","وَلَا","الضَّآلِّينَ"]}]}