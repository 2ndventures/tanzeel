{"verses":[{"verse_key":"113:1","text":"قُل اَعُوذُ بِرَبِّ الفَلَقِ","words":["قُل","اَعُوذُ","بِرَبِّ","الفَلَقِ"]},{"verse_key":"113:2","text":"مِن شَرِّ مَا خَلَقَ","words":["مِن","شَرِّ","مَا","خَلَقَ"]},{"verse_key":"113:3","text":"وَمِن شَرِّ غَاسِقٍ اِذَا وَقَبَ","words":["وَمِن","شَرِّ","غَاسِقٍ","اِذَا","وَقَبَ"]},{"verse_key":"113:4","text":"وَمِن شَرِّ النَّفّٰثٰتِ فِى العُقَدِ","words":["وَمِن","شَرِّ","النَّفّٰثٰتِ","فِى","العُقَدِ"]},{"verse_key":"113:5","text":"وَمِن شَرِّ حَاسِدٍ اِذَا حَسَدَ","words":["وَمِن","شَرِّ","حَاسِدٍ","اِذَا","حَسَدَ"]}]}