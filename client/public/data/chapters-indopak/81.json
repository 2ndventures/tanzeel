{"verses":[{"verse_key":"81:1","text":"اِذَا الشَّمسُ كُوِّرَت","words":["اِذَا","الشَّمسُ","كُوِّرَت"]},{"verse_key":"81:2","text":"وَاِذَا النُّجُومُ انْكَدَرَت","words":["وَاِذَا","النُّجُومُ","انْكَدَرَت"]},{"verse_key":"81:3","text":"وَاِذَا الجِبَالُ سُيِّرَت","words":["وَاِذَا","الجِبَالُ","سُيِّرَت"]},{"verse_key":"81:4","text":"وَاِذَا العِشَارُ عُطِّلَت","words":["وَاِذَا","العِشَارُ","عُطِّلَت"]},{"verse_key":"81:5","text":"وَاِذَا الوُحُوشُ حُشِرَت","words":["وَاِذَا","الوُحُوشُ","حُشِرَت"]},{"verse_key":"81:6","text":"وَاِذَا البِحَارُ سُجِّرَت","words":["وَاِذَا","البِحَارُ","سُجِّرَت"]},{"verse_key":"81:7","text":"وَاِذَا النُّفُوسُ زُوِّجَت","words":["وَاِذَا","النُّفُوسُ","زُوِّجَت"]},{"verse_key":"81:8","text":"وَاِذَا المَوءٗدَةُ سُٮِٕلَت","words":["وَاِذَا","المَوءٗدَةُ","سُٮِٕلَت"]},{"verse_key":"81:9","text":"بِاَىِّ ذَنبٍ قُتِلَت","words":["بِاَىِّ","ذَنبٍ","قُتِلَت"]},{"verse_key":"81:10","text":"وَاِذَا الصُّحُفُ نُشِرَت","words":["وَاِذَا","الصُّحُفُ","نُشِرَت"]},{"verse_key":"81:11","text":"وَاِذَا السَّمَآءُ كُشِطَت","words":["وَاِذَا","السَّمَآءُ","كُشِطَت"]},{"verse_key":"81:12","text":"وَاِذَا الجَحِيمُ سُعِّرَت","words":["وَاِذَا","الجَحِيمُ","سُعِّرَت"]},{"verse_key":"81:13","text":"وَاِذَا الجَـنَّةُ اُزلِفَت","words":["وَاِذَا","الجَـنَّةُ","اُزلِفَت"]},{"verse_key":"81:14","text":"عَلِمَت نَفسٌ مَّا اَحضَرَتؕ","words":["عَلِمَت","نَفسٌ","مَّا","اَحضَرَتؕ"]},{"verse_key":"81:15","text":"فَلَا اُقسِمُ بِالخُنَّسِ","words":["فَلَا","اُقسِمُ","بِالخُنَّسِ"]},{"verse_key":"81:16","text":"الجَوَارِ الكُنَّسِ","words":["الجَوَارِ","الكُنَّسِ"]},{"verse_key":"81:17","text":"وَالَّيلِ اِذَا عَسعَسَ","words":["وَالَّيلِ","اِذَا","عَسعَسَ"]},{"verse_key":"81:18","text":"وَالصُّبحِ اِذَا تَنَفَّسَ","words":["وَالصُّبحِ","اِذَا","تَنَفَّسَ"]},{"verse_key":"81:19","text":"اِنَّهٗ لَقَولُ رَسُولٍ كَرِيمٍ","words":["اِنَّهٗ","لَقَولُ","رَسُولٍ","كَرِيمٍ"]},{"verse_key":"81:20","text":"ذِى قُوَّةٍ عِندَ ذِى العَرشِ مَكِينٍ","words":["ذِى","قُوَّةٍ","عِندَ","ذِى","العَرشِ","مَكِينٍ"]},{"verse_key":"81:21","text":"مُّطَاعٍ ثَمَّ اَمِينٍؕ","words":["مُّطَاعٍ","ثَمَّ","اَمِينٍؕ"]},{"verse_key":"81:22","text":"وَ مَا صَاحِبُكُم بِمَجنُونٍ","words":["وَ مَا","صَاحِبُكُم","بِمَجنُونٍ"]},{"verse_key":"81:23","text":"وَلَقَد رَاٰهُ بِالاُفُقِ المُبِينِ","words":["وَلَقَد","رَاٰهُ","بِالاُفُقِ","المُبِينِ"]},{"verse_key":"81:24","text":"وَمَا هُوَ عَلَى الغَيبِ بِضَنِينٍ","words":["وَمَا","هُوَ","عَلَى","الغَيبِ","بِضَنِينٍ"]},{"verse_key":"81:25","text":"وَمَا هُوَ بِقَولِ شَيطٰنٍ رَّجِيمٍ","words":["وَمَا","هُوَ","بِقَولِ","شَيطٰنٍ","رَّجِيمٍ"]},{"verse_key":"81:26","text":"فَاَينَ تَذهَبُونَؕ","words":["فَاَينَ","تَذهَبُونَؕ"]},{"verse_key":"81:27","text":"اِن هُوَ اِلَّا ذِكرٌ لِّلعٰلَمِينَ","words":["اِن","هُوَ","اِلَّا","ذِكرٌ","لِّلعٰلَمِينَ"]},{"verse_key":"81:28","text":"لِمَن شَآءَ مِنكُم اَن يَّستَقِيمَؕ","words":["لِمَن","شَآءَ","مِنكُم","اَن","يَّستَقِيمَؕ"]},{"verse_key":"81:29","text":"وَمَا تَشَآءُونَ اِلَّا اَن يَّشَآءَ اللّٰهُ رَبُّ العٰلَمِينَ","words":["وَمَا","تَشَآءُونَ","اِلَّا","اَن","يَّشَآءَ","اللّٰهُ","رَبُّ","العٰلَمِينَ"]}]}