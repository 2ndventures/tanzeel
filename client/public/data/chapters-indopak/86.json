{"verses":[{"verse_key":"86:1","text":"وَالسَّمَآءِ وَالطَّارِقِ","words":["وَالسَّمَآءِ","وَالطَّارِقِ"]},{"verse_key":"86:2","text":"وَمَا اَدرٰٮكَ مَا الطَّارِقُ","words":["وَمَا","اَدرٰٮكَ","مَا","الطَّارِقُ"]},{"verse_key":"86:3","text":"النَّجمُ الثَّاقِبُ","words":["النَّجمُ","الثَّاقِبُ"]},{"verse_key":"86:4","text":"اِن كُلُّ نَفسٍ لَّمَّا عَلَيهَا حَافِظٌؕ","words":["اِن","كُلُّ","نَفسٍ","لَّمَّا","عَلَيهَا","حَافِظٌؕ"]},{"verse_key":"86:5","text":"فَليَنظُرِ الاِنسَانُ مِمَّ خُلِقَؕ","words":["فَليَنظُرِ","الاِنسَانُ","مِمَّ","خُلِقَؕ"]},{"verse_key":"86:6","text":"خُلِقَ مِن مَّآءٍ دَافِقٍ","words":["خُلِقَ","مِن","مَّآءٍ","دَافِقٍ"]},{"verse_key":"86:7","text":"يَّخرُجُ مِن بَينِ الصُّلبِ وَالتَّرَآٮِٕبِؕ","words":["يَّخرُجُ","مِن","بَينِ","الصُّلبِ","وَالتَّرَآٮِٕبِؕ"]},{"verse_key":"86:8","text":"اِنَّهٗ عَلٰى رَجعِهٖ لَقَادِرٌؕ","words":["اِنَّهٗ","عَلٰى","رَجعِهٖ","لَقَادِرٌؕ"]},{"verse_key":"86:9","text":"يَومَ تُبلَى السَّرَآٮِٕرُ","words":["يَومَ","تُبلَى","السَّرَآٮِٕرُ"]},{"verse_key":"86:10","text":"فَمَا لَهٗ مِن قُوَّةٍ وَّلَا نَاصِرٍؕ","words":["فَمَا","لَهٗ","مِن","قُوَّةٍ","وَّلَا","نَاصِرٍؕ"]},{"verse_key":"86:11","text":"وَالسَّمَآءِ ذَاتِ الرَّجعِ","words":["وَالسَّمَآءِ","ذَاتِ","الرَّجعِ"]},{"verse_key":"86:12","text":"وَالاَرضِ ذَاتِ الصَّدعِ","words":["وَالاَرضِ","ذَاتِ","الصَّدعِ"]},{"verse_key":"86:13","text":"اِنَّهٗ لَقَولٌ فَصلٌ","words":["اِنَّهٗ","لَقَولٌ","فَصلٌ"]},{"verse_key":"86:14","text":"وَّمَا هُوَ بِالهَزلِؕ","words":["وَّمَا","هُوَ","بِالهَزلِؕ"]},{"verse_key":"86:15","text":"اِنَّهُم يَكِيدُونَ كَيدًا ","words":["اِنَّهُم","يَكِيدُونَ","كَيدًا "]},{"verse_key":"86:16","text":"وَّاَكِيدُ كَيدًا ","words":["وَّاَكِيدُ","كَيدًا "]},{"verse_key":"86:17","text":"فَمَهِّلِ الكٰفِرِينَ اَمهِلهُم رُوَيدًا","words":["فَمَهِّلِ","الكٰفِرِينَ","اَمهِلهُم","رُوَيدًا"]}]}