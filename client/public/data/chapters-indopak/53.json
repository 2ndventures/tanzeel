{"verses":[{"verse_key":"53:1","text":"وَالنَّجمِ اِذَا هَوٰى","words":["وَالنَّجمِ","اِذَا","هَوٰى"]},{"verse_key":"53:2","text":"مَا ضَلَّ صَاحِبُكُم وَمَا غَوٰى","words":["مَا","ضَلَّ","صَاحِبُكُم","وَمَا","غَوٰى"]},{"verse_key":"53:3","text":"وَمَا يَنطِقُ عَنِ الهَوٰىؕ","words":["وَمَا","يَنطِقُ","عَنِ","الهَوٰىؕ"]},{"verse_key":"53:4","text":"اِن هُوَ اِلَّا وَحىٌ يُّوحٰى","words":["اِن","هُوَ","اِلَّا","وَحىٌ","يُّوحٰى"]},{"verse_key":"53:5","text":"عَلَّمَهٗ شَدِيدُ القُوٰى","words":["عَلَّمَهٗ","شَدِيدُ","القُوٰى"]},{"verse_key":"53:6","text":"ذُو مِرَّةٍؕ فَاستَوٰى","words":["ذُو","مِرَّةٍؕ","فَاستَوٰى"]},{"verse_key":"53:7","text":"وَهُوَ بِالاُفُقِ الاَعلٰى ؕ","words":["وَهُوَ","بِالاُفُقِ","الاَعلٰى ؕ"]},{"verse_key":"53:8","text":"ثُمَّ دَنَا فَتَدَلّٰى","words":["ثُمَّ","دَنَا","فَتَدَلّٰى"]},{"verse_key":"53:9","text":"فَكَانَ قَابَ قَوسَينِ اَو اَدنٰى","words":["فَكَانَ","قَابَ","قَوسَينِ","اَو","اَدنٰى"]},{"verse_key":"53:10","text":"فَاَوحٰى الٰى عَبدِهٖ مَا اَوحٰىؕ","words":["فَاَوحٰى","الٰى","عَبدِهٖ","مَا","اَوحٰىؕ"]},{"verse_key":"53:11","text":"مَا كَذَبَ الفُؤَادُ مَا رَاٰى","words":["مَا","كَذَبَ","الفُؤَادُ","مَا","رَاٰى"]},{"verse_key":"53:12","text":"اَفَتُمٰرُونَهٗ عَلٰى مَا يَرٰى","words":["اَفَتُمٰرُونَهٗ","عَلٰى","مَا","يَرٰى"]},{"verse_key":"53:13","text":"وَلَقَد رَاٰهُ نَزلَةً اُخرٰى","words":["وَلَقَد","رَاٰهُ","نَزلَةً","اُخرٰى"]},{"verse_key":"53:14","text":"عِندَ سِدرَةِ المُنتَهٰى","words":["عِندَ","سِدرَةِ","المُنتَهٰى"]},{"verse_key":"53:15","text":"عِندَهَا جَنَّةُ المَاوٰىؕ","words":["عِندَهَا","جَنَّةُ","المَاوٰىؕ"]},{"verse_key":"53:16","text":"اِذ يَغشَى السِّدرَةَ مَا يَغشٰى","words":["اِذ","يَغشَى","السِّدرَةَ","مَا","يَغشٰى"]},{"verse_key":"53:17","text":"مَا زَاغَ البَصَرُ وَمَا طَغٰى","words":["مَا","زَاغَ","البَصَرُ","وَمَا","طَغٰى"]},{"verse_key":"53:18","text":"لَقَد رَاٰى مِن اٰيٰتِ رَبِّهِ الكُبرٰى","words":["لَقَد","رَاٰى","مِن","اٰيٰتِ","رَبِّهِ","الكُبرٰى"]},{"verse_key":"53:19","text":"اَفَرَءَيتُمُ اللّٰتَ وَالعُزّٰى","words":["اَفَرَءَيتُمُ","اللّٰتَ","وَالعُزّٰى"]},{"verse_key":"53:20","text":"وَمَنٰوةَ الثَّالِثَةَ الاُخرٰى","words":["وَمَنٰوةَ","الثَّالِثَةَ","الاُخرٰى"]},{"verse_key":"53:21","text":"اَلَـكُمُ الذَّكَرُ وَلَهُ الاُنثٰى","words":["اَلَـكُمُ","الذَّكَرُ","وَلَهُ","الاُنثٰى"]},{"verse_key":"53:22","text":"تِلكَ اِذًا قِسمَةٌ ضِيزٰى","words":["تِلكَ","اِذًا","قِسمَةٌ","ضِيزٰى"]},{"verse_key":"53:23","text":"اِن هِىَ اِلَّا اَسمَآءٌ سَمَّيتُمُوهَا اَنتُم وَاٰبَآؤُكُم مَّا اَنزَلَ اللّٰهُ بِهَا مِن سُلطٰنٍؕ اِن يَّتَّبِعُونَ اِلَّا الظَّنَّ وَمَا تَهوَى الاَنفُسُ وَلَقَد جَآءَهُم مِّن رَّبِّهِمُ الهُدٰىؕ","words":["اِن","هِىَ","اِلَّا","اَسمَآءٌ","سَمَّيتُمُوهَا","اَنتُم","وَاٰبَآؤُكُم","مَّا","اَنزَلَ","اللّٰهُ","بِهَا","مِن","سُلطٰنٍؕ","اِن","يَّتَّبِعُونَ","اِلَّا","الظَّنَّ","وَمَا","تَهوَى","الاَنفُسُ","وَلَقَد","جَآءَهُم","مِّن","رَّبِّهِمُ","الهُدٰىؕ"]},{"verse_key":"53:24","text":"اَم لِلاِنسَانِ مَا تَمَنّٰى   ","words":["اَم","لِلاِنسَانِ","مَا","تَمَنّٰى   "]},{"verse_key":"53:25","text":"فَلِلّٰهِ الاٰخِرَةُ وَالاُولٰى","words":["فَلِلّٰهِ","الاٰخِرَةُ","وَالاُولٰى"]},{"verse_key":"53:26","text":" وَكَم مِّن مَّلَكٍ فِى السَّمٰوٰتِ لَا تُغنِى شَفَاعَتُهُم شَيــًٔــا اِلَّا مِن بَعدِ اَن يَّاذَنَ اللّٰهُ لِمَن يَّشَآءُ وَيَرضٰى","words":[" وَكَم","مِّن","مَّلَكٍ","فِى","السَّمٰوٰتِ","لَا","تُغنِى","شَفَاعَتُهُم","شَيــًٔــا","اِلَّا","مِن","بَعدِ","اَن","يَّاذَنَ","اللّٰهُ","لِمَن","يَّشَآءُ","وَيَرضٰى"]},{"verse_key":"53:27","text":"اِنَّ الَّذِينَ لَا يُؤمِنُونَ بِالاٰخِرَةِ لَيُسَمُّونَ المَلٰٓٮِٕكَةَ تَسمِيَةَ الاُنثٰى","words":["اِنَّ","الَّذِينَ","لَا","يُؤمِنُونَ","بِالاٰخِرَةِ","لَيُسَمُّونَ","المَلٰٓٮِٕكَةَ","تَسمِيَةَ","الاُنثٰى"]},{"verse_key":"53:28","text":"وَمَا لَهُم بِهٖ مِن عِلمٍؕ اِن يَّتَّبِعُونَ اِلَّا الظَّنَّ وَاِنَّ الظَّنَّ لَا يُغنِى مِنَ الحَـقِّ شَيـًٔـا","words":["وَمَا","لَهُم","بِهٖ","مِن","عِلمٍؕ","اِن","يَّتَّبِعُونَ","اِلَّا","الظَّنَّ","وَاِنَّ","الظَّنَّ","لَا","يُغنِى","مِنَ","الحَـقِّ","شَيـًٔـا"]},{"verse_key":"53:29","text":"فَاَعرِض عَن مَّن تَوَلّٰى  عَن ذِكرِنَا وَلَم يُرِد اِلَّا الحَيٰوةَ الدُّنيَا ؕ","words":["فَاَعرِض","عَن","مَّن","تَوَلّٰى ","عَن","ذِكرِنَا","وَلَم","يُرِد","اِلَّا","الحَيٰوةَ","الدُّنيَا ؕ"]},{"verse_key":"53:30","text":"ذٰلِكَ مَبلَـغُهُم مِّنَ العِلمِؕ اِنَّ رَبَّكَ هُوَ اَعلَمُ بِمَن ضَلَّ عَن سَبِيلِهٖ  وَهُوَ اَعلَمُ بِمَنِ اهتَدٰى","words":["ذٰلِكَ","مَبلَـغُهُم","مِّنَ","العِلمِؕ","اِنَّ","رَبَّكَ","هُوَ","اَعلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهٖ ","وَهُوَ","اَعلَمُ","بِمَنِ","اهتَدٰى"]},{"verse_key":"53:31","text":"وَلِلّٰهِ مَا فِى السَّمٰوٰتِ وَمَا فِى الاَرضِ لِيَجزِىَ الَّذِينَ اَسَآءُوا بِمَا عَمِلُوا وَيَجزِىَ الَّذِينَ اَحسَنُوا بِالحُسنٰى ","words":["وَلِلّٰهِ","مَا","فِى","السَّمٰوٰتِ","وَمَا","فِى","الاَرضِ","لِيَجزِىَ","الَّذِينَ","اَسَآءُوا","بِمَا","عَمِلُوا","وَيَجزِىَ","الَّذِينَ","اَحسَنُوا","بِالحُسنٰى "]},{"verse_key":"53:32","text":"اَلَّذِينَ يَجتَنِبُونَ كَبٰٓٮِٕرَ الاِثمِ وَالفوَاحِشَ اِلَّا اللَّمَمَؕ اِنَّ رَبَّكَ وَاسِعُ المَغفِرَةِؕ هُوَ اَعلَمُ بِكُم اِذ اَنشَاَكُم مِّنَ الاَرضِ وَاِذ اَنتُم اَجِنَّةٌ فِى بُطُونِ اُمَّهٰتِكُم فَلَا تُزَكُّوا اَنفُسَكُم ؕ هُوَ اَعلَمُ بِمَنِ اتَّقٰى","words":["اَلَّذِينَ","يَجتَنِبُونَ","كَبٰٓٮِٕرَ","الاِثمِ","وَالفوَاحِشَ","اِلَّا","اللَّمَمَؕ","اِنَّ","رَبَّكَ","وَاسِعُ","المَغفِرَةِؕ","هُوَ","اَعلَمُ","بِكُم","اِذ","اَنشَاَكُم","مِّنَ","الاَرضِ","وَاِذ","اَنتُم","اَجِنَّةٌ","فِى","بُطُونِ","اُمَّهٰتِكُم","فَلَا","تُزَكُّوا","اَنفُسَكُم ؕ","هُوَ","اَعلَمُ","بِمَنِ","اتَّقٰى"]},{"verse_key":"53:33","text":"اَفَرَءَيتَ الَّذِى تَوَلّٰى","words":["اَفَرَءَيتَ","الَّذِى","تَوَلّٰى"]},{"verse_key":"53:34","text":"وَاَعطٰى قَلِيلًا وَّاَكدٰى","words":["وَاَعطٰى","قَلِيلًا","وَّاَكدٰى"]},{"verse_key":"53:35","text":"اَعِندَهٗ عِلمُ الغَيبِ فَهُوَ يَرٰى","words":["اَعِندَهٗ","عِلمُ","الغَيبِ","فَهُوَ","يَرٰى"]},{"verse_key":"53:36","text":"اَم لَم يُنَبَّا بِمَا فِى صُحُفِ مُوسٰى","words":["اَم","لَم","يُنَبَّا","بِمَا","فِى","صُحُفِ","مُوسٰى"]},{"verse_key":"53:37","text":"وَاِبرٰهِيمَ الَّذِى وَفّٰىٓ  ","words":["وَاِبرٰهِيمَ","الَّذِى","وَفّٰىٓ  "]},{"verse_key":"53:38","text":"اَلَّا تَزِرُ وَازِرَةٌ وِّزرَ اُخرٰى","words":["اَلَّا","تَزِرُ","وَازِرَةٌ","وِّزرَ","اُخرٰى"]},{"verse_key":"53:39","text":"وَاَن لَّيسَ لِلاِنسَانِ اِلَّا مَا سَعٰى","words":["وَاَن","لَّيسَ","لِلاِنسَانِ","اِلَّا","مَا","سَعٰى"]},{"verse_key":"53:40","text":"وَاَنَّ سَعيَهٗ سَوفَ يُرٰى","words":["وَاَنَّ","سَعيَهٗ","سَوفَ","يُرٰى"]},{"verse_key":"53:41","text":"ثُمَّ يُجزٰٮهُ الجَزَآءَ الاَوفٰى","words":["ثُمَّ","يُجزٰٮهُ","الجَزَآءَ","الاَوفٰى"]},{"verse_key":"53:42","text":"وَاَنَّ اِلٰى رَبِّكَ المُنتَهٰى","words":["وَاَنَّ","اِلٰى","رَبِّكَ","المُنتَهٰى"]},{"verse_key":"53:43","text":"وَاَنَّهٗ هُوَ اَضحَكَ وَاَبكٰى","words":["وَاَنَّهٗ","هُوَ","اَضحَكَ","وَاَبكٰى"]},{"verse_key":"53:44","text":"وَاَنَّهٗ هُوَ اَمَاتَ وَ اَحيَا ","words":["وَاَنَّهٗ","هُوَ","اَمَاتَ","وَ اَحيَا "]},{"verse_key":"53:45","text":"وَاَنَّهٗ خَلَقَ الزَّوجَينِ الذَّكَرَ وَالاُنثٰى","words":["وَاَنَّهٗ","خَلَقَ","الزَّوجَينِ","الذَّكَرَ","وَالاُنثٰى"]},{"verse_key":"53:46","text":"مِن نُّطفَةٍ اِذَا تُمنٰى","words":["مِن","نُّطفَةٍ","اِذَا","تُمنٰى"]},{"verse_key":"53:47","text":"وَاَنَّ عَلَيهِ النَّشاَةَ الاُخرٰى","words":["وَاَنَّ","عَلَيهِ","النَّشاَةَ","الاُخرٰى"]},{"verse_key":"53:48","text":"وَاَنَّهٗ هُوَ اَغنٰى وَ اَقنٰى","words":["وَاَنَّهٗ","هُوَ","اَغنٰى","وَ اَقنٰى"]},{"verse_key":"53:49","text":"وَاَنَّهٗ هُوَ رَبُّ الشِّعرٰى","words":["وَاَنَّهٗ","هُوَ","رَبُّ","الشِّعرٰى"]},{"verse_key":"53:50","text":"وَاَنَّهٗ اَهلَكَ عَادَا الـٮُٔـوْلٰى ","words":["وَاَنَّهٗ","اَهلَكَ","عَادَا","الـٮُٔـوْلٰى "]},{"verse_key":"53:51","text":"وَثَمُودَا فَمَا اَبقٰى","words":["وَثَمُودَا","فَمَا","اَبقٰى"]},{"verse_key":"53:52","text":"وَقَومَ نُوحٍ مِّن قَبلُؕ اِنَّهُم كَانُوا هُم اَظلَمَ وَاَطغٰىؕ ","words":["وَقَومَ","نُوحٍ","مِّن","قَبلُؕ","اِنَّهُم","كَانُوا","هُم","اَظلَمَ","وَاَطغٰىؕ "]},{"verse_key":"53:53","text":"وَالمُؤتَفِكَةَ اَهوٰى","words":["وَالمُؤتَفِكَةَ","اَهوٰى"]},{"verse_key":"53:54","text":"فَغَشّٰٮهَا مَا غَشّٰى","words":["فَغَشّٰٮهَا","مَا","غَشّٰى"]},{"verse_key":"53:55","text":"فَبِاَىِّ اٰلَاءِ رَبِّكَ تَتَمَارٰى","words":["فَبِاَىِّ","اٰلَاءِ","رَبِّكَ","تَتَمَارٰى"]},{"verse_key":"53:56","text":"هٰذَا نَذِيرٌ مِّنَ النُّذُرِ الاُولٰٓى","words":["هٰذَا","نَذِيرٌ","مِّنَ","النُّذُرِ","الاُولٰٓى"]},{"verse_key":"53:57","text":"اَزِفَتِ الاٰزِفَةُ","words":["اَزِفَتِ","الاٰزِفَةُ"]},{"verse_key":"53:58","text":"لَيسَ لَهَا مِن دُونِ اللّٰهِ كَاشِفَةٌ ؕ","words":["لَيسَ","لَهَا","مِن","دُونِ","اللّٰهِ","كَاشِفَةٌ ؕ"]},{"verse_key":"53:59","text":"اَفَمِن هٰذَا الحَدِيثِ تَعجَبُونَ","words":["اَفَمِن","هٰذَا","الحَدِيثِ","تَعجَبُونَ"]},{"verse_key":"53:60","text":"وَتَضحَكُونَ وَلَا تَبكُونَ","words":["وَتَضحَكُونَ","وَلَا","تَبكُونَ"]},{"verse_key":"53:61","text":"وَاَنتُم سٰمِدُونَ","words":["وَاَنتُم","سٰمِدُونَ"]},{"verse_key":"53:62","text":"فَاسجُدُوا لِلّٰهِ وَاعبُدُوا ","words":["فَاسجُدُوا","لِلّٰهِ","وَاعبُدُوا "]}]}