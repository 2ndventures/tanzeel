{"verses":[{"verse_key":"97:1","text":"اِنَّا اَنزَلنٰهُ فِى لَيلَةِ القَدرِ  ","words":["اِنَّا","اَنزَلنٰهُ","فِى","لَيلَةِ","القَدرِ  "]},{"verse_key":"97:2","text":"وَمَا اَدرٰٮكَ مَا لَيلَةُ القَدرِؕ","words":["وَمَا","اَدرٰٮكَ","مَا","لَيلَةُ","القَدرِؕ"]},{"verse_key":"97:3","text":"لَيلَةُ القَدرِ   خَيرٌ مِّن اَلفِ شَهرٍؕ","words":["لَيلَةُ","القَدرِ  ","خَيرٌ","مِّن","اَلفِ","شَهرٍؕ"]},{"verse_key":"97:4","text":"تَنَزَّلُ المَلٰٓٮِٕكَةُ وَالرُّوحُ فِيهَا بِاِذنِ رَبِّهِم مِّن كُلِّ اَمرٍ ","words":["تَنَزَّلُ","المَلٰٓٮِٕكَةُ","وَالرُّوحُ","فِيهَا","بِاِذنِ","رَبِّهِم","مِّن","كُلِّ","اَمرٍ "]},{"verse_key":"97:5","text":"سَلٰمٌ   هِىَ حَتّٰى مَطلَعِ الفَجرِ","words":["سَلٰمٌ "," هِىَ","حَتّٰى","مَطلَعِ","الفَجرِ"]}]}