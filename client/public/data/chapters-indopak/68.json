{"verses":[{"verse_key":"68:1","text":"نٓ وَالقَلَمِ وَمَا يَسطُرُونَ","words":["نٓ","وَالقَلَمِ","وَمَا","يَسطُرُونَ"]},{"verse_key":"68:2","text":"مَا اَنتَ بِـنِعمَةِ رَبِّكَ بِمَجنُونٍ","words":["مَا","اَنتَ","بِـنِعمَةِ","رَبِّكَ","بِمَجنُونٍ"]},{"verse_key":"68:3","text":"وَاِنَّ لَڪَ لَاَجرًا غَيرَ مَمنُونٍ","words":["وَاِنَّ","لَڪَ","لَاَجرًا","غَيرَ","مَمنُونٍ"]},{"verse_key":"68:4","text":"وَاِنَّكَ لَعَلٰى خُلُقٍ عَظِيمٍ","words":["وَاِنَّكَ","لَعَلٰى","خُلُقٍ","عَظِيمٍ"]},{"verse_key":"68:5","text":"فَسَتُبصِرُ وَيُبصِرُونَ","words":["فَسَتُبصِرُ","وَيُبصِرُونَ"]},{"verse_key":"68:6","text":"بِاَيِّٮكُمُ المَفتُونُ","words":["بِاَيِّٮكُمُ","المَفتُونُ"]},{"verse_key":"68:7","text":"اِنَّ رَبَّكَ هُوَ اَعلَمُ بِمَن ضَلَّ عَن سَبِيلِهٖ وَهُوَ اَعلَمُ بِالمُهتَدِينَ","words":["اِنَّ","رَبَّكَ","هُوَ","اَعلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهٖ","وَهُوَ","اَعلَمُ","بِالمُهتَدِينَ"]},{"verse_key":"68:8","text":"فَلَا تُطِعِ المُكَذِّبِينَ","words":["فَلَا","تُطِعِ","المُكَذِّبِينَ"]},{"verse_key":"68:9","text":"وَدُّوا لَو تُدهِنُ فَيُدهِنُونَ","words":["وَدُّوا","لَو","تُدهِنُ","فَيُدهِنُونَ"]},{"verse_key":"68:10","text":"وَلَا تُطِع كُلَّ حَلَّافٍ مَّهِينٍ","words":["وَلَا","تُطِع","كُلَّ","حَلَّافٍ","مَّهِينٍ"]},{"verse_key":"68:11","text":"هَمَّازٍ مَّشَّآءٍ بِنَمِيمٍ","words":["هَمَّازٍ","مَّشَّآءٍ","بِنَمِيمٍ"]},{"verse_key":"68:12","text":"مَّنَّاعٍ لِّلخَيرِ مُعتَدٍ اَثِيمٍ","words":["مَّنَّاعٍ","لِّلخَيرِ","مُعتَدٍ","اَثِيمٍ"]},{"verse_key":"68:13","text":"عُتُلٍّ  بَعدَ ذٰلِكَ زَنِيمٍ","words":["عُتُلٍّ ","بَعدَ","ذٰلِكَ","زَنِيمٍ"]},{"verse_key":"68:14","text":"اَن كَانَ ذَا مَالٍ وَّبَنِينَؕ","words":["اَن","كَانَ","ذَا","مَالٍ","وَّبَنِينَؕ"]},{"verse_key":"68:15","text":"اِذَا تُتلٰى عَلَيهِ اٰيٰتُنَا قَالَ اَسَاطِيرُ الاَوَّلِينَ","words":["اِذَا","تُتلٰى","عَلَيهِ","اٰيٰتُنَا","قَالَ","اَسَاطِيرُ","الاَوَّلِينَ"]},{"verse_key":"68:16","text":"سَنَسِمُهٗ عَلَى الخُـرطُومِ","words":["سَنَسِمُهٗ","عَلَى","الخُـرطُومِ"]},{"verse_key":"68:17","text":"اِنَّا بَلَونٰهُم كَمَا بَلَونَا اَصحٰبَ الجَـنَّةِ  اِذ اَقسَمُوا لَيَصرِمُنَّهَا مُصبِحِينَ","words":["اِنَّا","بَلَونٰهُم","كَمَا","بَلَونَا","اَصحٰبَ","الجَـنَّةِ ","اِذ","اَقسَمُوا","لَيَصرِمُنَّهَا","مُصبِحِينَ"]},{"verse_key":"68:18","text":"وَلَا يَستَثنُونَ","words":["وَلَا","يَستَثنُونَ"]},{"verse_key":"68:19","text":"فَطَافَ عَلَيهَا طَآٮِٕفٌ مِّن رَّبِّكَ وَهُم نَآٮِٕمُونَ","words":["فَطَافَ","عَلَيهَا","طَآٮِٕفٌ","مِّن","رَّبِّكَ","وَهُم","نَآٮِٕمُونَ"]},{"verse_key":"68:20","text":"فَاَصبَحَت كَالصَّرِيمِ","words":["فَاَصبَحَت","كَالصَّرِيمِ"]},{"verse_key":"68:21","text":"فَتَـنَادَوا مُصبِحِينَ","words":["فَتَـنَادَوا","مُصبِحِينَ"]},{"verse_key":"68:22","text":"اَنِ اغدُوا عَلٰى حَرثِكُم اِن كُنتُم صٰرِمِينَ","words":["اَنِ","اغدُوا","عَلٰى","حَرثِكُم","اِن","كُنتُم","صٰرِمِينَ"]},{"verse_key":"68:23","text":"فَانطَلَقُوا وَهُم يَتَخَافَتُونَ","words":["فَانطَلَقُوا","وَهُم","يَتَخَافَتُونَ"]},{"verse_key":"68:24","text":"اَن لَّا يَدخُلَنَّهَا اليَومَ عَلَيكُم مِّسكِينٌ","words":["اَن","لَّا","يَدخُلَنَّهَا","اليَومَ","عَلَيكُم","مِّسكِينٌ"]},{"verse_key":"68:25","text":"وَّغَدَوا عَلٰى حَردٍ قٰدِرِينَ","words":["وَّغَدَوا","عَلٰى","حَردٍ","قٰدِرِينَ"]},{"verse_key":"68:26","text":"فَلَمَّا رَاَوهَا قَالُوا اِنَّا لَـضَآلُّونَ","words":["فَلَمَّا","رَاَوهَا","قَالُوا","اِنَّا","لَـضَآلُّونَ"]},{"verse_key":"68:27","text":"بَل نَحنُ مَحرُومُونَ","words":["بَل","نَحنُ","مَحرُومُونَ"]},{"verse_key":"68:28","text":"قَالَ اَوسَطُهُم اَلَم اَقُل لَّكُم لَولَا تُسَبِّحُونَ","words":["قَالَ","اَوسَطُهُم","اَلَم","اَقُل","لَّكُم","لَولَا","تُسَبِّحُونَ"]},{"verse_key":"68:29","text":"قَالُوا سُبحٰنَ رَبِّنَا اِنَّا كُنَّا ظٰلِمِينَ","words":["قَالُوا","سُبحٰنَ","رَبِّنَا","اِنَّا","كُنَّا","ظٰلِمِينَ"]},{"verse_key":"68:30","text":"فَاَقبَلَ بَعضُهُم عَلٰى بَعضٍ يَّتَلَاوَمُونَ","words":["فَاَقبَلَ","بَعضُهُم","عَلٰى","بَعضٍ","يَّتَلَاوَمُونَ"]},{"verse_key":"68:31","text":"قَالُوا يٰوَيلَنَا اِنَّا كُنَّا طٰغِينَ","words":["قَالُوا","يٰوَيلَنَا","اِنَّا","كُنَّا","طٰغِينَ"]},{"verse_key":"68:32","text":"عَسٰى رَبُّنَا اَن يُّبدِلَـنَا خَيرًا مِّنهَا اِنَّا اِلٰى رَبِّنَا رٰغِبُونَ","words":["عَسٰى","رَبُّنَا","اَن","يُّبدِلَـنَا","خَيرًا","مِّنهَا","اِنَّا","اِلٰى","رَبِّنَا","رٰغِبُونَ"]},{"verse_key":"68:33","text":"كَذٰلِكَ العَذَابُؕ وَلَعَذَابُ الاٰخِرَةِ اَكبَرُ  لَو كَانُوا يَعلَمُونَ ","words":["كَذٰلِكَ","العَذَابُؕ","وَلَعَذَابُ","الاٰخِرَةِ","اَكبَرُ ","لَو","كَانُوا","يَعلَمُونَ "]},{"verse_key":"68:34","text":"اِنَّ لِلمُتَّقِينَ عِندَ رَبِّهِم جَنّٰتِ النَّعِيمِ","words":["اِنَّ","لِلمُتَّقِينَ","عِندَ","رَبِّهِم","جَنّٰتِ","النَّعِيمِ"]},{"verse_key":"68:35","text":"اَفَنَجعَلُ المُسلِمِينَ كَالمُجرِمِينَؕ","words":["اَفَنَجعَلُ","المُسلِمِينَ","كَالمُجرِمِينَؕ"]},{"verse_key":"68:36","text":"مَا لَـكُم كَيفَ تَحكُمُونَ","words":["مَا","لَـكُم","كَيفَ","تَحكُمُونَ"]},{"verse_key":"68:37","text":"اَم لَـكُم كِتٰبٌ فِيهِ تَدرُسُونَ","words":["اَم","لَـكُم","كِتٰبٌ","فِيهِ","تَدرُسُونَ"]},{"verse_key":"68:38","text":"اِنَّ لَـكُم فِيهِ لَمَا تَخَيَّرُونَ","words":["اِنَّ","لَـكُم","فِيهِ","لَمَا","تَخَيَّرُونَ"]},{"verse_key":"68:39","text":"اَم لَـكُم اَيمَانٌ عَلَينَا بَالِغَةٌ اِلٰى يَومِ القِيٰمَةِ  اِنَّ لَـكُم لَمَا تَحكُمُونَ","words":["اَم","لَـكُم","اَيمَانٌ","عَلَينَا","بَالِغَةٌ","اِلٰى","يَومِ","القِيٰمَةِ ","اِنَّ","لَـكُم","لَمَا","تَحكُمُونَ"]},{"verse_key":"68:40","text":"سَلهُم اَيُّهُم بِذٰلِكَ زَعِيمٌ ","words":["سَلهُم","اَيُّهُم","بِذٰلِكَ","زَعِيمٌ "]},{"verse_key":"68:41","text":"اَم لَهُم شُرَكَآءُ  فَليَاتُوا بِشُرَكَآٮِٕهِم اِن كَانُوا صٰدِقِينَ ","words":["اَم","لَهُم","شُرَكَآءُ ","فَليَاتُوا","بِشُرَكَآٮِٕهِم","اِن","كَانُوا","صٰدِقِينَ "]},{"verse_key":"68:42","text":"يَومَ يُكشَفُ عَن سَاقٍ وَّيُدعَونَ اِلَى السُّجُودِ فَلَا يَستَطِيعُونَ ","words":["يَومَ","يُكشَفُ","عَن","سَاقٍ","وَّيُدعَونَ","اِلَى","السُّجُودِ","فَلَا","يَستَطِيعُونَ "]},{"verse_key":"68:43","text":"خَاشِعَةً اَبصَارُهُم تَرهَقُهُم ذِلَّةٌ وَقَد كَانُوا يُدعَونَ اِلَى السُّجُودِ وَهُم سٰلِمُونَ","words":["خَاشِعَةً","اَبصَارُهُم","تَرهَقُهُم","ذِلَّةٌ","وَقَد","كَانُوا","يُدعَونَ","اِلَى","السُّجُودِ","وَهُم","سٰلِمُونَ"]},{"verse_key":"68:44","text":"فَذَرنِى وَمَن يُّكَذِّبُ بِهٰذَا الحَـدِيثِؕ سَنَستَدرِجُهُم مِّن حَيثُ لَا يَعلَمُونَ","words":["فَذَرنِى","وَمَن","يُّكَذِّبُ","بِهٰذَا","الحَـدِيثِؕ","سَنَستَدرِجُهُم","مِّن","حَيثُ","لَا","يَعلَمُونَ"]},{"verse_key":"68:45","text":"وَاُملِى لَهُمؕ اِنَّ كَيدِى مَتِينٌ","words":["وَاُملِى","لَهُمؕ","اِنَّ","كَيدِى","مَتِينٌ"]},{"verse_key":"68:46","text":"اَم تَسـَٔـلُهُم اَجرًا فَهُم مِّن مَّغرَمٍ مُّثقَلُونَ","words":["اَم","تَسـَٔـلُهُم","اَجرًا","فَهُم","مِّن","مَّغرَمٍ","مُّثقَلُونَ"]},{"verse_key":"68:47","text":"اَم عِندَهُمُ الغَيبُ فَهُم يَكتُبُونَ","words":["اَم","عِندَهُمُ","الغَيبُ","فَهُم","يَكتُبُونَ"]},{"verse_key":"68:48","text":"فَاصبِر لِحُكمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ الحُوتِ اِذ نَادٰى وَهُوَ مَكظُومٌؕ","words":["فَاصبِر","لِحُكمِ","رَبِّكَ","وَلَا","تَكُن","كَصَاحِبِ","الحُوتِ","اِذ","نَادٰى","وَهُوَ","مَكظُومٌؕ"]},{"verse_key":"68:49","text":"لَولَا اَن تَدٰرَكَهٗ نِعمَةٌ مِّن رَّبِّهٖ لَنُبِذَ بِالعَرَآءِ وَهُوَ مَذمُومٌ","words":["لَولَا","اَن","تَدٰرَكَهٗ","نِعمَةٌ","مِّن","رَّبِّهٖ","لَنُبِذَ","بِالعَرَآءِ","وَهُوَ","مَذمُومٌ"]},{"verse_key":"68:50","text":"فَاجتَبٰهُ رَبُّهٗ فَجَعَلَهٗ مِنَ الصّٰلِحِينَ","words":["فَاجتَبٰهُ","رَبُّهٗ","فَجَعَلَهٗ","مِنَ","الصّٰلِحِينَ"]},{"verse_key":"68:51","text":"وَاِن يَّكَادُ الَّذِينَ كَفَرُوا لَيُزلِقُونَكَ بِاَبصَارِهِم لَمَّا سَمِعُوا الذِّكرَ وَيَقُولُونَ اِنَّهٗ لَمَجنُونٌ","words":["وَاِن","يَّكَادُ","الَّذِينَ","كَفَرُوا","لَيُزلِقُونَكَ","بِاَبصَارِهِم","لَمَّا","سَمِعُوا","الذِّكرَ","وَيَقُولُونَ","اِنَّهٗ","لَمَجنُونٌ"]},{"verse_key":"68:52","text":"وَمَا هُوَ اِلَّا ذِكرٌ لِّلعٰلَمِينَ","words":["وَمَا","هُوَ","اِلَّا","ذِكرٌ","لِّلعٰلَمِينَ"]}]}