{"verses":[{"verse_key":"102:1","text":"اَلهٰٮكُمُ التَّكَاثُرُ","words":["اَلهٰٮكُمُ","التَّكَاثُرُ"]},{"verse_key":"102:2","text":"حَتّٰى زُرتُمُ المَقَابِرَؕ","words":["حَتّٰى","زُرتُمُ","المَقَابِرَؕ"]},{"verse_key":"102:3","text":"كَلَّا سَوفَ تَعلَمُونَ","words":["كَلَّا","سَوفَ","تَعلَمُونَ"]},{"verse_key":"102:4","text":"ثُمَّ كَلَّا سَوفَ تَعلَمُونَؕ","words":["ثُمَّ","كَلَّا","سَوفَ","تَعلَمُونَؕ"]},{"verse_key":"102:5","text":"كَلَّا لَو تَعلَمُونَ عِلمَ اليَقِينِؕ","words":["كَلَّا","لَو","تَعلَمُونَ","عِلمَ","اليَقِينِؕ"]},{"verse_key":"102:6","text":"لَتَرَوُنَّ الجَحِيمَ","words":["لَتَرَوُنَّ","الجَحِيمَ"]},{"verse_key":"102:7","text":"ثُمَّ لَتَرَوُنَّهَا عَينَ اليَقِينِ","words":["ثُمَّ","لَتَرَوُنَّهَا","عَينَ","اليَقِينِ"]},{"verse_key":"102:8","text":"ثُمَّ لَـتُسـَٔـلُنَّ يَومَٮِٕذٍ عَنِ النَّعِيمِ","words":["ثُمَّ","لَـتُسـَٔـلُنَّ","يَومَٮِٕذٍ","عَنِ","النَّعِيمِ"]}]}