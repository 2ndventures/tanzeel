{"verses":[{"verse_key":"90:1","text":"لَا اُقسِمُ بِهٰذَا البَلَدِ","words":["لَا","اُقسِمُ","بِهٰذَا","البَلَدِ"]},{"verse_key":"90:2","text":"وَاَنتَ حِلٌّ  بِهٰذَا البَلَدِ","words":["وَاَنتَ","حِلٌّ ","بِهٰذَا","البَلَدِ"]},{"verse_key":"90:3","text":"وَوَالِدٍ وَّمَا وَلَدَ ","words":["وَوَالِدٍ","وَّمَا","وَلَدَ "]},{"verse_key":"90:4","text":"لَقَد خَلَقنَا الاِنسَانَ فِى كَبَدٍؕ","words":["لَقَد","خَلَقنَا","الاِنسَانَ","فِى","كَبَدٍؕ"]},{"verse_key":"90:5","text":"اَيَحسَبُ اَن لَّن يَّقدِرَ عَلَيهِ اَحَدٌ ","words":["اَيَحسَبُ","اَن","لَّن","يَّقدِرَ","عَلَيهِ","اَحَدٌ "]},{"verse_key":"90:6","text":"يَقُولُ اَهلَكتُ مَالًا لُّبَدًا ؕ","words":["يَقُولُ","اَهلَكتُ","مَالًا","لُّبَدًا ؕ"]},{"verse_key":"90:7","text":"اَيَحسَبُ اَن لَّم يَرَهٗ اَحَدٌ ؕ","words":["اَيَحسَبُ","اَن","لَّم","يَرَهٗ","اَحَدٌ ؕ"]},{"verse_key":"90:8","text":"اَلَم نَجعَل لَّهٗ عَينَينِ","words":["اَلَم","نَجعَل","لَّهٗ","عَينَينِ"]},{"verse_key":"90:9","text":"وَلِسَانًا وَّشَفَتَينِ","words":["وَلِسَانًا","وَّشَفَتَينِ"]},{"verse_key":"90:10","text":"وَهَدَينٰهُ النَّجدَينِ","words":["وَهَدَينٰهُ","النَّجدَينِ"]},{"verse_key":"90:11","text":"فَلَا اقتَحَمَ العَقَبَةَ ","words":["فَلَا","اقتَحَمَ","العَقَبَةَ "]},{"verse_key":"90:12","text":"وَمَا اَدرٰٮكَ مَا العَقَبَةُ ؕ","words":["وَمَا","اَدرٰٮكَ","مَا","العَقَبَةُ ؕ"]},{"verse_key":"90:13","text":"فَكُّ رَقَبَةٍ ","words":["فَكُّ","رَقَبَةٍ "]},{"verse_key":"90:14","text":"اَو اِطعٰمٌ فِى يَومٍ ذِى مَسغَبَةٍ ","words":["اَو","اِطعٰمٌ","فِى","يَومٍ","ذِى","مَسغَبَةٍ "]},{"verse_key":"90:15","text":"يَّتِيمًا ذَا مَقرَبَةٍ ","words":["يَّتِيمًا","ذَا","مَقرَبَةٍ "]},{"verse_key":"90:16","text":"اَو مِسكِينًا ذَا مَترَبَةٍ ؕ","words":["اَو","مِسكِينًا","ذَا","مَترَبَةٍ ؕ"]},{"verse_key":"90:17","text":"ثُمَّ كَانَ مِنَ الَّذِينَ اٰمَنُوا وَتَوَاصَوا بِالصَّبرِ وَتَوَاصَوا بِالمَرحَمَةِ ؕ","words":["ثُمَّ","كَانَ","مِنَ","الَّذِينَ","اٰمَنُوا","وَتَوَاصَوا","بِالصَّبرِ","وَتَوَاصَوا","بِالمَرحَمَةِ ؕ"]},{"verse_key":"90:18","text":"اُولٰٓٮِٕكَ اَصحٰبُ المَيمَنَةِ ؕ","words":["اُولٰٓٮِٕكَ","اَصحٰبُ","المَيمَنَةِ ؕ"]},{"verse_key":"90:19","text":"وَالَّذِينَ كَفَرُوا بِاٰيٰتِنَا هُم اَصحٰبُ المَشـَٔـمَةِ ؕ","words":["وَالَّذِينَ","كَفَرُوا","بِاٰيٰتِنَا","هُم","اَصحٰبُ","المَشـَٔـمَةِ ؕ"]},{"verse_key":"90:20","text":"عَلَيهِم نَارٌ مُّؤصَدَةٌ","words":["عَلَيهِم","نَارٌ","مُّؤصَدَةٌ"]}]}