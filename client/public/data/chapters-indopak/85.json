{"verses":[{"verse_key":"85:1","text":"وَالسَّمَآءِ ذَاتِ البُرُوجِ","words":["وَالسَّمَآءِ","ذَاتِ","البُرُوجِ"]},{"verse_key":"85:2","text":"وَاليَومِ المَوعُودِ","words":["وَاليَومِ","المَوعُودِ"]},{"verse_key":"85:3","text":"وَشَاهِدٍ وَّمَشهُودٍؕ","words":["وَشَاهِدٍ","وَّمَشهُودٍؕ"]},{"verse_key":"85:4","text":"قُتِلَ اَصحٰبُ الاُخدُودِ","words":["قُتِلَ","اَصحٰبُ","الاُخدُودِ"]},{"verse_key":"85:5","text":"النَّارِ ذَاتِ الوَقُودِ","words":["النَّارِ","ذَاتِ","الوَقُودِ"]},{"verse_key":"85:6","text":"اِذ هُم عَلَيهَا قُعُودٌ ","words":["اِذ","هُم","عَلَيهَا","قُعُودٌ "]},{"verse_key":"85:7","text":"وَّهُم عَلٰى مَا يَفعَلُونَ بِالمُؤمِنِينَ شُهُودٌ ؕ","words":["وَّهُم","عَلٰى","مَا","يَفعَلُونَ","بِالمُؤمِنِينَ","شُهُودٌ ؕ"]},{"verse_key":"85:8","text":"وَمَا نَقَمُوا مِنهُم اِلَّا اَن يُّؤمِنُوا بِاللّٰهِ العَزِيزِ الحَمِيدِ ","words":["وَمَا","نَقَمُوا","مِنهُم","اِلَّا","اَن","يُّؤمِنُوا","بِاللّٰهِ","العَزِيزِ","الحَمِيدِ "]},{"verse_key":"85:9","text":"الَّذِى لَهٗ مُلكُ السَّمٰوٰتِ وَالاَرضِؕ وَ اللّٰهُ عَلٰى كُلِّ شَىءٍ شَهِيدٌ ؕ","words":["الَّذِى","لَهٗ","مُلكُ","السَّمٰوٰتِ","وَالاَرضِؕ","وَ اللّٰهُ","عَلٰى","كُلِّ","شَىءٍ","شَهِيدٌ ؕ"]},{"verse_key":"85:10","text":"اِنَّ الَّذِينَ فَتَـنُوا المُؤمِنِينَ وَ المُؤمِنٰتِ ثُمَّ لَم يَتُوبُوا فَلَهُم عَذَابُ جَهَنَّمَ وَلَهُم عَذَابُ الحَرِيقِؕ","words":["اِنَّ","الَّذِينَ","فَتَـنُوا","المُؤمِنِينَ","وَ المُؤمِنٰتِ","ثُمَّ","لَم","يَتُوبُوا","فَلَهُم","عَذَابُ","جَهَنَّمَ","وَلَهُم","عَذَابُ","الحَرِيقِؕ"]},{"verse_key":"85:11","text":"اِنَّ الَّذِينَ اٰمَنُوا وَعَمِلُوا الصّٰلِحٰتِ لَهُم جَنّٰتٌ تَجرِى مِن تَحتِهَا الاَنهٰرُ ؕ ذٰلِكَ الفَوزُ الكَبِيرُؕ","words":["اِنَّ","الَّذِينَ","اٰمَنُوا","وَعَمِلُوا","الصّٰلِحٰتِ","لَهُم","جَنّٰتٌ","تَجرِى","مِن","تَحتِهَا","الاَنهٰرُ ؕ","ذٰلِكَ","الفَوزُ","الكَبِيرُؕ"]},{"verse_key":"85:12","text":"اِنَّ بَطشَ رَبِّكَ لَشَدِيدٌ ؕ","words":["اِنَّ","بَطشَ","رَبِّكَ","لَشَدِيدٌ ؕ"]},{"verse_key":"85:13","text":"اِنَّهٗ هُوَ يُبدِئُ وَيُعِيدُ ","words":["اِنَّهٗ","هُوَ","يُبدِئُ","وَيُعِيدُ "]},{"verse_key":"85:14","text":"وَهُوَ الغَفُورُ الوَدُودُ","words":["وَهُوَ","الغَفُورُ","الوَدُودُ"]},{"verse_key":"85:15","text":"ذُو العَرشِ المَجِيدُ ","words":["ذُو","العَرشِ","المَجِيدُ "]},{"verse_key":"85:16","text":"فَعَّالٌ لِّمَا يُرِيدُ ؕ","words":["فَعَّالٌ","لِّمَا","يُرِيدُ ؕ"]},{"verse_key":"85:17","text":"هَل اَتٰٮكَ حَدِيثُ الجُـنُودِ","words":["هَل","اَتٰٮكَ","حَدِيثُ","الجُـنُودِ"]},{"verse_key":"85:18","text":"فِرعَونَ وَثَمُودَؕ","words":["فِرعَونَ","وَثَمُودَؕ"]},{"verse_key":"85:19","text":"بَلِ الَّذِينَ كَفَرُوا فِى تَكذِيبٍ","words":["بَلِ","الَّذِينَ","كَفَرُوا","فِى","تَكذِيبٍ"]},{"verse_key":"85:20","text":"وَّاللّٰهُ مِن وَّرَآٮِٕهِم مُّحِيطٌ","words":["وَّاللّٰهُ","مِن","وَّرَآٮِٕهِم","مُّحِيطٌ"]},{"verse_key":"85:21","text":"بَل هُوَ قُراٰنٌ مَّجِيدٌ ","words":["بَل","هُوَ","قُراٰنٌ","مَّجِيدٌ "]},{"verse_key":"85:22","text":"فِى لَوحٍ مَّحفُوظٍ","words":["فِى","لَوحٍ","مَّحفُوظٍ"]}]}