{"verses":[{"verse_key":"109:1","text":"قُل يٰاَيُّهَا الكٰفِرُونَ","words":["قُل","يٰاَيُّهَا","الكٰفِرُونَ"]},{"verse_key":"109:2","text":"لَا اَعبُدُ مَا تَعبُدُونَ","words":["لَا","اَعبُدُ","مَا","تَعبُدُونَ"]},{"verse_key":"109:3","text":"وَلَا اَنـتُم عٰبِدُونَ مَا اَعبُدُ ","words":["وَلَا","اَنـتُم","عٰبِدُونَ","مَا","اَعبُدُ "]},{"verse_key":"109:4","text":"وَلَا اَنَا عَابِدٌ مَّا عَبَدتُّم","words":["وَلَا","اَنَا","عَابِدٌ","مَّا","عَبَدتُّم"]},{"verse_key":"109:5","text":"وَ لَا اَنـتُم عٰبِدُونَ مَا اَعبُدُ ؕ","words":["وَ","لَا","اَنـتُم","عٰبِدُونَ","مَا اَعبُدُ ؕ"]},{"verse_key":"109:6","text":"لَـكُم دِينُكُم وَلِىَ دِينِ","words":["لَـكُم","دِينُكُم","وَلِىَ","دِينِ"]}]}